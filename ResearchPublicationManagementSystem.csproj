<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets this net8.0 app run on a machine that only has a newer .NET runtime installed
         (e.g. only .NET 10 present locally) without changing the target framework itself. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

</Project>
