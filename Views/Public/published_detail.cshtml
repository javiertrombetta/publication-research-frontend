@using Microsoft.Extensions.Options
@using ResearchPublicationManagementSystem.Infrastructure.Options
@inject ResearchPublicationManagementSystem.Services.IInstitutionDetails Institution
@model CatalogueEntryViewModel
@{
    var entry = Model.Entry;
    ViewData["Title"] = entry.Title;
    ViewData["HideSidebar"] = User.Identity?.IsAuthenticated != true;

    var institution = await Institution.GetAsync();
    var enquiriesEmail = institution.ResearchEnquiriesEmail;
    var institutionName = institution.Name;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">

        <div class="mb-4">
            <a asp-controller="Public" asp-action="public_catalogue" class="text-secondary text-decoration-none small">
                &larr; Public catalogue
            </a>
            <h1 class="page-title mt-2 mb-2">@entry.Title</h1>
            @{
                // Joined in C#: Razor drops the whitespace between adjacent blocks, which ran
                // the separators into the surrounding text.
                var meta = new List<string> { entry.AuthorName };
                if (entry.PublicationYear is not null) meta.Add(entry.PublicationYear.ToString()!);
                if (!string.IsNullOrWhiteSpace(entry.PublicationType)) meta.Add(entry.PublicationType!);
            }
            <div class="text-secondary">@string.Join(" · ", meta)</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(entry.Abstract))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h3 mb-2">Abstract</h2>
                    @* white-space:pre-line so the author's paragraphs survive. *@
                    <p class="m-0 rpms-preserve-lines">@entry.Abstract</p>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h3 mb-3">Details</h2>
                <div class="row g-3">

                    <div class="col-12 col-sm-6">
                        <div class="text-secondary small">Author</div>
                        <div>@entry.AuthorName</div>
                    </div>

                    <div class="col-12 col-sm-6">
                        <div class="text-secondary small">Year</div>
                        <div>@(entry.PublicationYear?.ToString() ?? "—")</div>
                    </div>

                    <div class="col-12">
                        <div class="text-secondary small">Keywords</div>
                        @if (entry.Keywords.Count == 0)
                        {
                            <div>—</div>
                        }
                        else
                        {
                            <div class="mt-1">
                                @foreach (var keyword in entry.Keywords)
                                {
                                    @* Each keyword searches the catalogue for it. *@
                                    <a asp-controller="Public" asp-action="public_catalogue" asp-route-keyword="@keyword"
                                       class="badge bg-secondary-lt text-decoration-none me-1">@keyword</a>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>

        @if (Model.Citation is not null)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h3 mb-3">Cite this paper</h2>
                    <div class="text-secondary small mb-1">APA 7th</div>
                    <div class="d-flex align-items-start gap-2">
                        <p class="m-0 flex-fill" id="citation-apa">@Model.Citation.Apa</p>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                data-copy-from="citation-apa">Copy</button>
                    </div>
                </div>
            </div>
        }

        @* The full text is not published here: a reader asks the institution for a copy. Last
           on the page, so someone decides they want the paper before being told how to ask. *@
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h3 mb-2">Request the full text</h2>
                <p class="text-secondary mb-3">
                    The catalogue lists the abstract and details of each paper. To read the paper
                    itself, ask us for a copy and quote its title.
                </p>

                @if (string.IsNullOrWhiteSpace(enquiriesEmail))
                {
                    @* No address configured yet, so say so rather than offer a link to nowhere.

                       Where somebody is sent instead is a setting, not a sentence written here.
                       "Through the usual channels" is not an answer to a member of the public who
                       does not already know what those are, and a telephone number hardcoded in a
                       view would outlive its accuracy. An administrator maintains the address. *@
                    <p class="text-secondary m-0">
                        An email address for research enquiries hasn't been published yet.
                        @if (!string.IsNullOrWhiteSpace(institution.WebsiteUrl))
                        {
                            <text>
                                Visit the
                                <a href="@institution.WebsiteUrl" rel="noopener" target="_blank">@institutionName website</a>
                                for their contact details.
                            </text>
                        }
                        else
                        {
                            <text>Visit the @institutionName website for their contact details.</text>
                        }
                    </p>
                }
                else
                {
                    <a class="btn btn-primary"
                       href="mailto:@enquiriesEmail?subject=@Uri.EscapeDataString($"Request for a copy: {entry.Title}")">
                        Email us for a copy
                    </a>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Copy-to-clipboard for the citations. Falls back to selecting the text where the
        // Clipboard API isn't available (it needs a secure context), so the button is never dead.
        document.querySelectorAll('[data-copy-from]').forEach(function (button) {
            button.addEventListener('click', function () {
                var source = document.getElementById(button.dataset.copyFrom);
                if (!source) return;

                function done() {
                    var original = button.textContent;
                    button.textContent = 'Copied';
                    window.setTimeout(function () { button.textContent = original; }, 1500);
                }

                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(source.textContent.trim()).then(done, select);
                } else {
                    select();
                }

                function select() {
                    var range = document.createRange();
                    range.selectNodeContents(source);
                    var selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                }
            });
        });
    </script>
}
