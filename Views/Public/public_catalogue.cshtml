@model CatalogueViewModel
@inject ResearchPublicationManagementSystem.Services.IInstitutionDetails Institution
@{
    // A visitor with no account has nothing to navigate to, and the workflow menu would be wrong
    // for them. Someone signed in keeps their sidebar.
    var isVisitor = User.Identity?.IsAuthenticated != true;
    ViewData["HideSidebar"] = isVisitor;

    // For a visitor this page is the whole site, so the heading has to say what the site is. For
    // someone signed in it is one screen among many, and the short name reads better against the
    // menu item they arrived from.
    ViewData["Title"] = isVisitor ? "Public catalogue of research documents" : "Public catalogue";

    var results = Model.Results;
    var search = Model.Search;
    var institutionName = (await Institution.GetAsync()).Name;
}

<div class="mb-4">
    <h1 class="page-title mb-1">@ViewData["Title"]</h1>
    <div class="text-secondary">
        Research published by @institutionName students.
    </div>
</div>

<!-- Search. GET so a search can be linked to, bookmarked and reloaded. -->
<form method="get" asp-controller="Public" asp-action="public_catalogue" class="card mb-4">
    <div class="card-body">
        <div class="row g-3">

            <div class="col-12 col-lg-6">
                <label for="catalogue-query" class="form-label">Title or abstract</label>
                <input type="search" id="catalogue-query" name="query" value="@search.Query"
                       class="form-control" placeholder="Search the title and abstract" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label for="catalogue-author" class="form-label">Author</label>
                <input type="text" id="catalogue-author" name="author" value="@search.Author" class="form-control" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label for="catalogue-keyword" class="form-label">Keyword</label>
                <input type="text" id="catalogue-keyword" name="keyword" value="@search.Keyword" class="form-control" />
            </div>

            <div class="col-12 col-sm-6 col-lg-2">
                <label for="catalogue-year" class="form-label">Year</label>
                <input type="number" id="catalogue-year" name="year" value="@(search.Year?.ToString())"
                       class="form-control" min="1900" max="2100" inputmode="numeric" />
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                @if (search.HasFilters)
                {
                    <a asp-controller="Public" asp-action="public_catalogue" class="btn btn-link text-secondary">
                        Clear filters
                    </a>
                }
            </div>

        </div>
    </div>
</form>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">The catalogue is unavailable</h3>
            <p class="text-secondary mb-4">
                This is a temporary problem reaching the server. Try again in a moment.
            </p>
            <a asp-controller="Public" asp-action="public_catalogue" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (results.TotalCount == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            @if (search.HasFilters)
            {
                <h3 class="mb-2">Nothing matches your search</h3>
                <p class="text-secondary mb-4">Try fewer or broader filters.</p>
                <a asp-controller="Public" asp-action="public_catalogue" class="btn btn-primary">Clear filters</a>
            }
            else
            {
                <h3 class="mb-2">Nothing published yet</h3>
                <p class="text-secondary m-0">
                    Research appears here once its author chooses to publish it.
                </p>
            }
        </div>
    </div>
}
else
{
    <div class="text-secondary mb-3">
        Showing @results.FirstItemNumber&ndash;@results.LastItemNumber of @results.TotalCount
        @(results.TotalCount == 1 ? "publication" : "publications")
    </div>

    <div class="row row-cards">
        @foreach (var entry in results.Items)
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <h3 class="mb-1">
                            <a asp-controller="Public" asp-action="published_detail" asp-route-id="@entry.Id"
                               class="text-reset text-decoration-none">@entry.Title</a>
                        </h3>

                        @{
                            // Author and year only, matching what the detail page publishes —
                            // supervisor and department are not shown to the public.
                            // Joined in C# rather than as separate Razor blocks: Razor eats the
                            // whitespace between them, which ran the separators into the text.
                            var meta = new List<string> { entry.AuthorName };
                            if (entry.PublicationYear is not null) meta.Add(entry.PublicationYear.ToString()!);
                        }
                        <div class="text-secondary mb-2">@string.Join(" · ", meta)</div>

                        @if (!string.IsNullOrWhiteSpace(entry.Abstract))
                        {
                            @* Clamped rather than truncated server-side, so search engines and
                               screen readers still get the whole abstract. *@
                            <p class="rpms-clamp-3 mb-2">@entry.Abstract</p>
                        }

                        @if (entry.Keywords.Count > 0)
                        {
                            <div class="mb-3">
                                @foreach (var keyword in entry.Keywords)
                                {
                                    <a asp-controller="Public" asp-action="public_catalogue" asp-route-keyword="@keyword"
                                       class="badge bg-secondary-lt text-decoration-none me-1">@keyword</a>
                                }
                            </div>
                        }

                        @* No download here: the catalogue publishes the abstract and the
                           metadata, and the full text is requested from the institution. *@
                        <a asp-controller="Public" asp-action="published_detail" asp-route-id="@entry.Id"
                           class="btn btn-outline-primary btn-sm">Read more</a>

                    </div>
                </div>
            </div>
        }
    </div>

    @if (results.TotalPages > 1)
    {
        <ul class="pagination mt-4">
            <li class="page-item @(results.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-controller="Public" asp-action="public_catalogue"
                   asp-all-route-data="Model.RouteValues(results.Page - 1)">Previous</a>
            </li>

            <li class="page-item disabled">
                <span class="page-link">Page @results.Page of @results.TotalPages</span>
            </li>

            <li class="page-item @(results.HasNext ? "" : "disabled")">
                <a class="page-link" asp-controller="Public" asp-action="public_catalogue"
                   asp-all-route-data="Model.RouteValues(results.Page + 1)">Next</a>
            </li>
        </ul>
    }
}
