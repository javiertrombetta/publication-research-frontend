@model StudentProfileViewModel
@{ ViewData["Title"] = "My profile"; }

            @* A div, not a main: the layout already opens one, and a page has a single main region. *@
            <div class="page-body m-0 py-4">
                <div class="container-xl">

                    <!-- Centred responsive layout wrapper -->
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                            <!-- Profile Hero Header Card -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-body py-4 px-4">
                                    <div class="row align-items-center g-3">
                                        <div class="col-auto">
                                            @if (Model.HasProfilePhoto)
                                            {
                                                <span class="avatar avatar-xl rounded-circle rpms-avatar-photo"
                                                      style="background-image: url('@Url.Action("Photo", "Profile")')"></span>
                                            }
                                            else
                                            {
                                                <span class="avatar avatar-xl rounded-circle bg-primary-lt fw-bold fs-1">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</span>
                                            }
                                        </div>
                                        <div class="col">
                                            <h1 class="h1 mb-1">@Model.FirstName @Model.LastName</h1>
                                            <div class="text-secondary">@Model.Email</div>

                                            <div class="btn-list mt-2">
                                                <form asp-controller="Profile" asp-action="UploadPhoto" method="post"
                                                      enctype="multipart/form-data" class="d-inline-flex align-items-center gap-2 m-0">
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                    @* Hidden input + label so the control reads as one button and submits on pick. *@
                                                    <input type="file" name="photo" id="profile-photo-input"
                                                           class="d-none" accept="image/jpeg,image/png,image/webp"
                                                           onchange="this.form.submit()" />
                                                    <label for="profile-photo-input" class="btn btn-outline-secondary btn-sm mb-0">
                                                        @(Model.HasProfilePhoto ? "Change photo" : "Upload photo")
                                                    </label>
                                                </form>

                                                @if (Model.HasProfilePhoto)
                                                {
                                                    <form asp-controller="Profile" asp-action="DeletePhoto" method="post" class="d-inline m-0">
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove photo</button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                        @* The photo is the only thing on this page a student changes, so the
                                           status badge is all that sits beside it now. *@
                                        <div class="col-12 col-sm-auto d-flex align-items-start align-items-sm-center">
                                            <span class="badge bg-success-lt fs-4 px-3 py-2 fw-bold justify-content-center">@Humanise(Model.Status)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Detailed Information Card Grid -->
                            <div class="card shadow-sm">
                                <div class="card-header bg-blue text-white">
                                    <h2 class="card-title fs-2 fw-bold text-white">Academic Profile Details</h2>
                                </div>

                                <div class="card-body py-4 px-4">

                                    @* These are the institution's record of a student, not a description the
                                       student writes of themselves: the student ID, the department, the
                                       programme and the cohort are what their work is filed and assessed
                                       under. An administrator maintains them, and the page says so rather
                                       than leaving a reader to work out why nothing here can be typed in. *@
                                    <p class="text-secondary mb-4">
                                        These details are held by the institution. Ask an administrator if any of
                                        them is wrong. Your photo is yours to change, above.
                                    </p>

                                    <div class="row g-4">

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">First Name</div>
                                            <div class="fs-2 fw-medium text-dark">@Model.FirstName</div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">Surname</div>
                                            <div class="fs-2 fw-medium text-dark">@Model.LastName</div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">Student ID</div>
                                            <div class="fs-2 fw-medium text-primary fw-bold">@(Model.StudentIdNumber ?? "—")</div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">Cohort</div>
                                            <div class="fs-2 fw-medium text-dark">@(Model.Cohort ?? "—")</div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">Programme / Course</div>
                                            <div class="fs-2 fw-medium text-dark">@(Model.Programme ?? "—")</div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">Department</div>
                                            <div class="fs-2 fw-medium text-dark">@(Model.DepartmentName ?? "—")</div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">ORCID</div>
                                            <div class="fs-2 fw-medium text-dark">@(string.IsNullOrWhiteSpace(Model.Orcid) ? "—" : Model.Orcid)</div>
                                        </div>

                                        @* What this student says they work on. The API has always
                                           returned these and nothing showed them, so the tags a
                                           supervisor would match a proposal against were invisible
                                           even to the student who chose them. *@
                                        <div class="col-12">
                                            <div class="text-secondary mb-1 uppercase tracking-wider small fw-bold">Research areas</div>
                                            @if (Model.ResearchAreas.Count == 0)
                                            {
                                                <div class="text-secondary">
                                                    None chosen yet. An administrator records these with the rest of your details.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap gap-2 mt-1">
                                                    @foreach (var area in Model.ResearchAreas)
                                                    {
                                                        <span class="badge bg-primary-lt">@area</span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
