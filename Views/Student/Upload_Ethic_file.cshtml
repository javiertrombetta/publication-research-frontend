@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model UploadEthicsDocumentsViewModel
@{
    ViewData["Title"] = "Ethics documentation";

    // What the reviewer sent back, against the requirement it answers. A supervisor can return
    // one document out of a set and leave the rest accepted, so the reason belongs beside the
    // field being asked for again rather than only in the history at the foot of the page.
    var returned = Model.ExistingDocuments
        .Where(d => d.Status == EthicsDocumentStatus.RevisionRequested)
        .GroupBy(d => d.DocumentType, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.OrderByDescending(d => d.Version).First(), StringComparer.OrdinalIgnoreCase);
}

            @* A div, not a main: the layout already opens one, and a page has a single main region. *@
            <div class="page-body m-0 py-4">
                <div class="container-xl">

                    @* Rejected input is announced by the shared toast region in the layout, which
                       reads ModelState itself. *@

                    <!-- Centred responsive layout wrapper -->
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                            @* The only way back was the form's Cancel button, which sits below the
                               documents and the table of what has already been submitted, off the
                               bottom of a long page, and labelled as abandoning something rather
                               than as leaving. This is at the top, where a back link belongs, and
                               names where it goes. *@
                            <div class="mb-2 px-2">
                                <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId"
                                   class="text-secondary text-decoration-none small">
                                    &larr; Back to this publication
                                </a>
                            </div>

                            <!-- Header Area -->
                            <div class="mb-4 px-2">
                                <h1 class="h1 m-0 fw-bold text-dark">Ethics Documentation</h1>
                                <p class="text-secondary small m-0 mt-1">Download the mandatory institutional templates, complete them, and upload the signed copies below.</p>
                            </div>

                            <!-- 1. DOWNLOAD TEMPLATES SECTION -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h2 class="card-title fs-3 fw-bold text-primary">Ethics files</h2>
                                </div>
                                <div class="card-body p-3">
                                    <div class="row g-3">
                                        <!-- Template 1: Participant Information Sheet -->
                                        <div class="col-12 col-sm-4">
                                            <div class="card card-sm border d-flex flex-column h-100 justify-content-between p-3 text-center bg-surface">
                                                <div>
                                                    <div class="mb-2 text-primary">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-info-circle" width="32" height="32" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" /></svg>
                                                    </div>
                                                    <div class="fw-bold text-dark mb-1">Participant Information Sheet</div>
                                                    
                                                </div>
                                                <a href="~/templates/participant-information-sheet.docx" class="btn btn-outline-primary btn-sm w-100"
                                                   download="Participant Information Sheet.docx">
                                                    Download
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Template 2: Proposal Form -->
                                        <div class="col-12 col-sm-4">
                                            <div class="card card-sm border d-flex flex-column h-100 justify-content-between p-3 text-center bg-surface">
                                                <div>
                                                    <div class="mb-2 text-primary">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-briefcase" width="32" height="32" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" /><path d="M8 5v-2a1 1 0 0 1 1 -1h6a1 1 0 0 1 1 1v2" /><path d="M12 12v.01" /><path d="M3 13a20 20 0 0 0 18 0" /></svg>
                                                    </div>
                                                    <div class="fw-bold text-dark mb-1">Proposal Form</div>
                                                    
                                                </div>
                                                <a href="~/templates/proposal-form.docx" class="btn btn-outline-primary btn-sm w-100"
                                                   download="Proposal Form.docx">
                                                    Download
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Template 3: Consent Form Guidance -->
                                        <div class="col-12 col-sm-4">
                                            <div class="card card-sm border d-flex flex-column h-100 justify-content-between p-3 text-center bg-surface">
                                                <div>
                                                    <div class="mb-2 text-primary">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-file-text" width="32" height="32" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M9 9l1 0" /><path d="M9 13l6 0" /><path d="M9 17l6 0" /></svg>
                                                    </div>
                                                    <div class="fw-bold text-dark mb-1">Consent Form Guidance</div>
                                                    
                                                </div>
                                                <a href="~/templates/consent-form-guidance.docx" class="btn btn-outline-primary btn-sm w-100"
                                                   download="Consent Form Guidance.docx">
                                                    Download
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. DOCUMENT UPLOAD AREA -->
                            <form id="ethicsUploadForm" asp-controller="Student" asp-action="Upload_Ethic_file" method="post" enctype="multipart/form-data" class="card shadow-sm mb-4">
                                <input type="hidden" asp-for="ContainerId" />
                                <div class="card-header bg-light">
                                    <h2 class="card-title fs-3 fw-bold text-primary">Upload Completed Files</h2>
                                </div>
                                <div class="card-body p-4">

                                    @* Built from what this publication was actually asked for.
                                       An administrator decides the list, and each publication
                                       keeps the one it was given, so this is never a fixed set
                                       of three fields. *@
                                    @if (Model.Required.Count == 0)
                                    {
                                        <p class="text-secondary">
                                            Nothing has been requested of you yet. You will see the
                                            documents here once your Supervisor decides that ethics
                                            approval is needed.
                                        </p>
                                    }

                                    @foreach (var requirement in Model.Required)
                                    {
                                        returned.TryGetValue(requirement.Name, out var sentBack);

                                        <div class="mb-4">
                                            <label class="form-label fw-bold mb-1" for="file-@requirement.RequirementId">
                                                @requirement.Name
                                                @if (sentBack is not null)
                                                {
                                                    <span class="badge bg-orange-lt ms-1">Asked for again</span>
                                                }
                                                else if (requirement.IsSatisfied)
                                                {
                                                    <span class="badge bg-success-lt ms-1">Submitted</span>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">*</span>
                                                }
                                            </label>

                                            @if (!string.IsNullOrWhiteSpace(requirement.Description))
                                            {
                                                <div class="text-secondary small mb-2">@requirement.Description</div>
                                            }

                                            @if (sentBack is not null && !string.IsNullOrWhiteSpace(sentBack.ReviewComments))
                                            {
                                                <div class="alert alert-warning py-2 px-3 mb-2">
                                                    <div class="small fw-bold mb-1">Your reviewer asked for this one again</div>
                                                    <div class="small">@sentBack.ReviewComments</div>
                                                </div>
                                            }

                                            @* Indexed by requirement id so the binder can put each
                                               file back against the document it answers. *@
                                            <input type="file" id="file-@requirement.RequirementId"
                                                   name="@UploadEthicsDocumentsViewModel.FieldNameFor(requirement.RequirementId)"
                                                   class="form-control" accept=".pdf,.doc,.docx,.zip" />

                                            @if (requirement.IsSatisfied)
                                            {
                                                <div class="form-hint">
                                                    Already submitted. Upload again only to replace it with a newer version.
                                                </div>
                                            }
                                        </div>
                                    }

                                    <p class="text-secondary small mb-0">Upload only the files you have ready. Each one is submitted independently, so you can come back and add the rest later.</p>
                                </div>

                                <!-- Action Buttons Footer Container -->
                                <div class="card-footer bg-light border-top d-flex justify-content-end align-items-center gap-3 py-3 px-4">
                                    <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId" class="btn btn-link text-secondary text-decoration-none m-0 p-2">
                                        Cancel
                                    </a>

                                    <button type="submit" class="btn btn-primary px-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-upload me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 9l5 -5l5 5" /><path d="M12 4l0 12" /></svg>
                                        Upload Documents
                                    </button>
                                </div>
                            </form>

                            @if (Model.ExistingDocuments.Count > 0)
                            {
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-light">
                                        <h2 class="card-title fs-3 fw-bold text-primary">Previously submitted</h2>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table card-table table-vcenter">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Document</th>
                                                    <th scope="col">File</th>
                                                    <th scope="col">Version</th>
                                                    <th scope="col">Status</th>
                                                    <th scope="col">Reviewer comments</th>
                                                    <th scope="col" class="w-1"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var doc in Model.ExistingDocuments)
                                                {
                                                    <tr>
                                                        <td>@doc.DocumentType</td>
                                                        <td>@doc.FileName</td>
                                                        <td>v@(doc.Version)</td>
                                                        <td>
                                                            <span class="badge @StatusBadge(doc.Status)">@Humanise(doc.Status)</span>
                                                        </td>
                                                        <td>@doc.ReviewComments</td>
                                                        <td>
                                                            @* Reviewers could open these and the person who wrote them could
                                                               not, which is the wrong way round: a student asked for a revision
                                                               needs to read the version being talked about. The API decides who
                                                               may read what and already counts the owner among them. *@
                                                            <a asp-controller="Downloads" asp-action="EthicsDocument"
                                                               asp-route-containerId="@Model.ContainerId"
                                                               asp-route-documentId="@doc.Id"
                                                               class="btn btn-sm btn-outline-primary">
                                                                Download
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                </div>
            </div>
  


    <script>
        // Safely resets input choices for upload forms
        function clearUploads() {
            const fileInputs = document.querySelectorAll('#ethicsUploadForm input[type="file"]');
            fileInputs.forEach(input => input.value = '');
        }
    </script>
