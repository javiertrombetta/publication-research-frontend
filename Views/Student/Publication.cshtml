@model PublicationDetailViewModel
@* For the EthicsStatus constants, imported here rather than in _ViewImports so the DTO
   namespace doesn't shadow anything in the other ~90 views. *@
@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@{
    ViewData["Title"] = Model.DisplayTitle;
    var container = Model.Container;
    var isDone = container.Status == "Completed";

    // An accepted paper finishes the publication stage, even though the container stays
    // InProgress until its author decides whether it goes into the public catalogue.
    var stagesFinished = isDone || container.IsPaperDecided;

    // Same colours as every other status badge: finished green, under way blue, not started grey.
    string StageBadge(int stage) =>
        stagesFinished || container.CurrentPipeline > stage ? StatusBadge("Completed")
        : container.CurrentPipeline == stage ? StatusBadge("InProgress") : StatusBadge("NotStarted");

    string StageText(int stage) =>
        stagesFinished || container.CurrentPipeline > stage ? "Complete"
        : container.CurrentPipeline == stage ? "In progress" : "Not started";
}

<div class="mb-4">
    <a asp-controller="Student" asp-action="student_dashboard" class="text-secondary text-decoration-none small">
        @* Names the destination exactly as the sidebar and that page's own heading do. *@
        &larr; My publications
    </a>

    <div class="d-flex justify-content-between align-items-start mt-2">
        <div>
            <h1 class="page-title mb-1">@Model.DisplayTitle</h1>
            <div class="text-secondary">
                Started @container.CreatedAt.ToLocalTime().ToString("dd MMM yyyy 'at' HH:mm")
                &middot; Coordinator: <strong>@container.CoordinatorName</strong>
                @if (container.AssignedSupervisorName is not null)
                {
                    <span>&middot; Supervisor: <strong>@container.AssignedSupervisorName</strong></span>
                }
            </div>
        </div>

        @* Only offered while the publication is still empty, see PublicationContainerDto.CanBeDeleted. *@
        @if (container.CanBeDeleted)
        {
            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#delete-publication-modal">
                Delete publication
            </button>
        }
    </div>
</div>

@if (container.CanBeDeleted)
{
    <div class="modal modal-blur fade" id="delete-publication-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <h2 class="h3">Delete this publication?</h2>
                    <div class="text-secondary">
                        It has no research proposals yet, so nothing is lost. This can't be undone,
                        and once you add a proposal it can no longer be deleted.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Student" asp-action="DeletePublication" asp-route-id="@container.Id" method="post" class="m-0">
                        <button type="submit" class="btn btn-danger">Delete publication</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@* Two views of the same publication: where it stands now, and how it got there.

   Which one is open is decided here rather than left to the browser, because paging the trail is
   a fresh request: marked in the markup, a page turned in the history came back with Progress
   open and the reader was put back at the top of a screen they had already left. *@
@{
    var historyIsOpen = Model.HistoryIsOpen;
}
<ul class="nav nav-tabs mb-4" data-bs-toggle="tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a href="#publication-progress" class="nav-link @(historyIsOpen ? "" : "active")" data-bs-toggle="tab"
           role="tab" aria-selected="@(historyIsOpen ? "false" : "true")">Progress</a>
    </li>
    <li class="nav-item" role="presentation">
        <a href="#publication-history" class="nav-link @(historyIsOpen ? "active" : "")" data-bs-toggle="tab"
           role="tab" aria-selected="@(historyIsOpen ? "true" : "false")">
            Activity history
            @if (Model.History.Count > 0)
            {
                <span class="badge bg-secondary-lt ms-1">@Model.History.Count</span>
            }
        </a>
    </li>
</ul>

<div class="tab-content">
<div class="tab-pane @(historyIsOpen ? "" : "active show")" id="publication-progress" role="tabpanel">

<!-- Stage overview -->
<div class="row row-cards mb-4">
    <div class="col-md-4">
        <div class="card h-100 @(container.CurrentPipeline == 1 && !stagesFinished ? "border-primary" : "")">
            <div class="card-body">
                <div class="text-secondary mb-1">Stage 1</div>
                <div class="fs-2 fw-bold">Research Proposals</div>
                <span class="badge @StageBadge(1) mt-2">@StageText(1)</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(container.CurrentPipeline == 2 && !stagesFinished ? "border-primary" : "")">
            <div class="card-body">
                <div class="text-secondary mb-1">Stage 2</div>
                <div class="fs-2 fw-bold">Ethics Approval</div>
                <span class="badge @StageBadge(2) mt-2">@StageText(2)</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 @(container.CurrentPipeline == 3 && !stagesFinished ? "border-primary" : "")">
            <div class="card-body">
                <div class="text-secondary mb-1">Stage 3</div>
                <div class="fs-2 fw-bold">Research Paper</div>
                <span class="badge @StageBadge(3) mt-2">@StageText(3)</span>
            </div>
        </div>
    </div>
</div>

<!-- Proposals -->
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h3 m-0 text-secondary">Research Proposals</h2>
        @if (container.CurrentPipeline == 1)
        {
            @* Once the proposals have been submitted they are locked and with the coordinator, so
               there is nothing to carry on with. Inviting the student to continue something they
               have finished and cannot change says the wrong thing about where they are. *@
            <a asp-controller="Student" asp-action="Create_proposals" asp-route-id="@container.Id"
               class="btn btn-sm @(Model.ProposalsAreSubmitted ? "btn-outline-primary" : "btn-primary")">
                @(Model.ProposalsAreSubmitted ? "View proposals"
                    : Model.Proposals.Count > 0 ? "Continue" : "Get started")
            </a>
        }
    </div>

    @if (Model.Proposals.Count == 0)
    {
        <div class="card"><div class="card-body text-secondary">No proposals submitted yet.</div></div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                @* Sorted where it is read, by clicking a heading. Three proposals at a time is a
                   short list, but a student who has been sent back to write more comes back to a
                   longer one, and "which of these has been turned down" is the question they open
                   this on. The dates carry a sortable value of their own so that a column shown as
                   "04 Aug 2026" does not order as text. *@
                <table class="table card-table table-vcenter" data-rpms-sortable-table>
                    <thead>
                        <tr>
                            <th scope="col" data-rpms-sort-column="0">Title</th>
                            <th scope="col" data-rpms-sort-column="1">Submitted</th>
                            <th scope="col" data-rpms-sort-column="2">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proposal in Model.Proposals)
                        {
                            <tr>
                                <td>@proposal.Title</td>
                                @* In the reader's own time, like every other date on the site. This
                                   one was printed as stored, and stored is UTC: a proposal a
                                   student sent at nine in the morning in Auckland was shown to
                                   them, and only here, as the day before. *@
                                <td data-rpms-sort-value="@(proposal.SubmittedAt?.ToString("o") ?? "")">
                                    @(proposal.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                                </td>
                                <td><span class="badge @StatusBadge(proposal.Status)">@Humanise(proposal.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Ethics -->
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h3 m-0 text-secondary">Ethics Approval</h2>
        @if (container.CurrentPipeline >= 2)
        {
            <div class="btn-list">
                @if (Model.EthicsApproval is null)
                {
                    <a asp-controller="Student" asp-action="Ethic_risk_assessment" asp-route-id="@container.Id" class="btn btn-sm btn-primary">
                        Start declaration
                    </a>
                }
                else if (Model.EthicsApproval.Status == EthicsStatus.PendingUpload
                         && !Model.EthicsDocumentsAreComplete)
                {
                    <a asp-controller="Student" asp-action="Upload_Ethic_file" asp-route-id="@container.Id" class="btn btn-sm btn-primary">
                        Upload documents
                    </a>
                }
                else if (Model.EthicsApproval.Status != EthicsStatus.PendingSupervisorDecision)
                {
                    @* Nothing to view while the declaration is still with the supervisor, because
                       no documents have been asked for yet.

                       Everything else lands here, including a publication still marked as awaiting
                       uploads whose documents have all arrived. The status stays that way until a
                       reviewer looks at them, but the student has nothing left to send, so asking
                       them to upload would be asking for work that is already done. *@
                    <a asp-controller="Student" asp-action="Upload_Ethic_file" asp-route-id="@container.Id" class="btn btn-sm btn-outline-primary">
                        View documents
                    </a>
                }
            </div>
        }
    </div>

    <div class="card">
        <div class="card-body">
            @if (container.CurrentPipeline < 2)
            {
                <span class="text-secondary">
                    Opens once one of your proposals has been approved and a supervisor assigned.
                </span>
            }
            else if (Model.EthicsApproval is null)
            {
                <span class="text-secondary">You haven't made your ethics declaration yet.</span>
            }
            else
            {
                <span class="badge @StatusBadge(Model.EthicsApproval.Status)">@Humanise(Model.EthicsApproval.Status)</span>
                @if (Model.EthicsApproval.Status == EthicsStatus.PendingSupervisorDecision)
                {
                    @* Otherwise the bare status reads as though the student has to do something. *@
                    <p class="mt-2 mb-0 text-secondary">
                        Your declaration has been sent. Your supervisor will decide whether ethics
                        documentation is required.
                    </p>
                }
                @if (!string.IsNullOrEmpty(Model.EthicsApproval.SupervisorDecisionComments))
                {
                    <p class="mt-2 mb-0 text-secondary">Supervisor: @Model.EthicsApproval.SupervisorDecisionComments</p>
                }
                @if (!string.IsNullOrEmpty(Model.EthicsApproval.HeadOfDepartmentComments))
                {
                    <p class="mt-1 mb-0 text-secondary">Head of Department: @Model.EthicsApproval.HeadOfDepartmentComments</p>
                }
            }
        </div>
    </div>
</div>

<!-- Research paper -->
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h2 class="h3 m-0 text-secondary">Research Paper</h2>
        @if (container.CurrentPipeline >= 3)
        {
            @* "Continue" only while there is something to continue. Once the paper has been
               submitted it is with a supervisor, a committee or the coordinator, and once it has
               been accepted the work is finished, and inviting the student to carry on with a paper
               nobody can change any more says the wrong thing about where they are. What they
               want then is to read it, which is what the same screen does. *@
            var paperIsOpen = Model.Publication is null
                || Model.Publication.Status is PublicationStatus.Draft or PublicationStatus.RevisionsRequested;

            <a asp-controller="Student" asp-action="Create_Publication" asp-route-id="@container.Id"
               class="btn btn-sm @(paperIsOpen ? "btn-primary" : "btn-outline-primary")">
                @(Model.Publication is null ? "Get started" : paperIsOpen ? "Continue" : "View paper")
            </a>
        }
    </div>

    <div class="card">
        <div class="card-body">
            @if (container.CurrentPipeline < 3)
            {
                <span class="text-secondary">
                    Opens once this publication's ethics approval has been completed.
                </span>
            }
            else if (Model.Publication is null)
            {
                <span class="text-secondary">You haven't started your research paper yet.</span>
            }
            else
            {
                <div class="fw-bold">@(string.IsNullOrEmpty(Model.Publication.Title) ? "(untitled)" : Model.Publication.Title)</div>
                <span class="badge @StatusBadge(Model.Publication.Status) mt-1">@Humanise(Model.Publication.Status)</span>

                @* Only worth saying once the decision has been made, and worded as the outcome
                   rather than repeated as a status, since the badge above already says "Published". *@
                @if (Model.Publication.IsPublished)
                {
                    <p class="text-secondary mt-2 mb-0">
                        Listed in the <a asp-controller="Public" asp-action="public_catalogue">public catalogue</a>.
                    </p>
                }
                else if (isDone)
                {
                    <p class="text-secondary mt-2 mb-0">
                        You chose to keep this paper out of the public catalogue.
                    </p>
                }
            }
        </div>
    </div>
</div>

@* The final step, and the student's alone: an accepted paper only reaches the public catalogue
   if its author says so.

   !isDone is what makes this a one-off. Declining leaves the paper Accepted and unpublished,
   the same shape as "not decided yet", so the container's own Completed status is the only
   thing that records that the question was already answered. *@
@if (!isDone && Model.Publication is { Status: PublicationStatus.Accepted, IsPublished: false })
{
    <div class="card border-primary mb-4">
        <div class="card-body">
            <h2 class="h3 mb-1">Your paper has been accepted</h2>
            <p class="text-secondary">
                You decide whether it appears in the public catalogue, where anyone can find and
                read it. Keeping it out does not affect its acceptance. The paper stays on your
                record either way. This decision closes the publication, so make it when you're ready.
            </p>

            <div class="btn-list">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#publish-yes-modal">
                    Publish to the catalogue
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#publish-no-modal">
                    Keep it private
                </button>
            </div>
        </div>
    </div>

    @* One modal per answer: both are final, so neither should be a single stray click. *@
    <div class="modal modal-blur fade" id="publish-yes-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body py-4">
                    <h2 class="h3 mb-2">Publish to the public catalogue?</h2>
                    <div class="text-secondary">
                        Your paper and its abstract become publicly readable, and this can't be
                        undone from here. Only an Administrator can remove a published paper.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Student" asp-action="PublishDecision" asp-route-id="@container.Id" method="post" class="m-0">
                        <input type="hidden" name="publish" value="true" />
                        <button type="submit" class="btn btn-primary">Publish it</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal modal-blur fade" id="publish-no-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body py-4">
                    <h2 class="h3 mb-2">Keep it out of the catalogue?</h2>
                    <div class="text-secondary">
                        Your paper stays accepted and on your record, but it won't be publicly
                        listed. This closes the publication.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Student" asp-action="PublishDecision" asp-route-id="@container.Id" method="post" class="m-0">
                        <input type="hidden" name="publish" value="false" />
                        <button type="submit" class="btn btn-outline-secondary">Keep it private</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

</div><!-- /progress tab -->

<div class="tab-pane @(historyIsOpen ? "active show" : "")" id="publication-history" role="tabpanel">

    @* The trail of a publication that has been through three stages runs to dozens of entries, and
       what somebody opens it to answer is "when was it sent back, and by whom". Filtered by the
       API, so it searches the whole trail rather than the ten entries on this page.

       Only what this publication's own history holds is offered: a fixed list of every action the
       system can record would be mostly choices matching nothing. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Student" asp-action="Publication" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@Model.Container.Id" />
                <input type="hidden" name="tab" value="history" />

                <div class="col-6 col-md-2">
                    <label class="form-label" for="history-from">From</label>
                    <input id="history-from" name="from" type="date" class="form-control"
                           value="@Model.HistoryFrom?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label" for="history-to">To</label>
                    <input id="history-to" name="to" type="date" class="form-control"
                           value="@Model.HistoryTo?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" for="history-action">Activity</label>
                    <select id="history-action" name="activity" class="form-select">
                        <option value="">Anything</option>
                        @foreach (var name in Model.HistoryActions)
                        {
                            <option value="@name" selected="@(name == Model.HistoryAction)">@Humanise(name)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label" for="history-actor">Who</label>
                    <select id="history-actor" name="actor" class="form-select">
                        <option value="">Anyone</option>
                        @foreach (var person in Model.HistoryActors)
                        {
                            <option value="@person.UserId" selected="@(person.UserId == Model.HistoryActor)">@person.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Search</button>
                    @if (Model.HistoryIsFiltered)
                    {
                        <a asp-controller="Student" asp-action="Publication"
                           asp-route-id="@Model.Container.Id" asp-route-tab="history"
                           class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @{
        var historyModel = new ResearchPublicationManagementSystem.Models.ActivityHistoryViewModel
        {
            Entries = Model.History,
            TotalCount = Model.HistoryTotal,
            Pager = Model.HistoryPager
        };
    }
    <partial name="_ActivityHistory" model="historyModel" />
</div><!-- /history tab -->
</div><!-- /tab-content -->
