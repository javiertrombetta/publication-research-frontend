@{ ViewData["Title"] = "Ethics screening"; }

@model EthicsDeclarationPageViewModel

            <main class="page-body m-0 py-4">
                <div class="container-xl">

                    <!-- Centred responsive layout wrapper -->
                    <form id="riskAssessmentForm" asp-controller="Student" asp-action="Ethic_risk_assessment" method="post" class="row justify-content-center">
                        <input type="hidden" asp-for="ContainerId" />
                        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                            @* Same back link as the other stage screens: this one is twenty questions
                               long, so the form's Cancel button is a long way down. *@
                            <div class="mb-2 px-2">
                                <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId"
                                   class="text-secondary text-decoration-none small">
                                    &larr; Back to this publication
                                </a>
                            </div>

                            <!-- Minimal Text-Only Header with Context -->
                            <div class="mb-4 px-2">
                                <h1 class="h1 m-0 fw-bold text-dark">Ethics screening</h1>
                                <p class="text-secondary small m-0 mt-1">Work through all 20 questions before declaring. They are there to help you judge whether your research needs ethics approval. Your answers to them are not recorded; only the declaration at the bottom is.</p>
                            </div>

                            <!-- Interactive Screening Assessment Container -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h3 class="card-title fs-2 fw-bold text-primary">Does the research include:</h3>
                                </div>
                                <div class="card-body p-0">
                                    <div class="divide-y">
                                        
                                        <!-- Question 1 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">1. Situations where the researcher may be at risk of harm</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q1" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q1" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q1" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 2 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">2. Use of a questionnaire or interview, whether or not it is anonymous, which might reasonably be expected to cause discomfort, embarrassment or psychological or spiritual harm to the participants.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q2" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q2" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q2" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 3 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">3. Processes that are potentially disadvantageous to a person or group, such as the collection of information which may expose a person / group to discrimination.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q3" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q3" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q3" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 4 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">4. Collection of information of illegal behaviour(s) gained during the research which could place the participants at risk of criminal or civil liability or be damaging to their financial standing, employability, professional or personal relationships.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q4" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q4" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q4" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 5 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">5. Collection of blood, body fluid, tissue samples or other samples.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q5" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q5" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q5" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 6 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">6. Any form of exercise regime, or deprivation (e.g. sleep or dietary).</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q6" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q6" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q6" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 7 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">7. Any form of physical examination (e.g. physical, radiation, ultrasound).</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q7" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q7" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q7" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 8 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">8. The administration of any form of drug, medicine (other than in the course of standard medical procedure), or placebo.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q8" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q8" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q8" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 9 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">9. Physical pain, beyond mild discomfort.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q9" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q9" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q9" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 10 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">10. Participants whose identities are known to the researcher giving oral consent rather than written consent, other than for cultural reasons.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q10" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q10" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q10" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 11 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">11. Participants who are unable to give informed consent.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q11" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q11" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q11" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 12 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">12. The participation of children (seven (7) years old or younger).</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q12" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q12" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q12" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 13 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">13. The participation of children under sixteen (16) years old where active parental consent is not being sought.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q13" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q13" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q13" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 14 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">14. Participants who are in a dependant situation, such as nursing home or prison, or patients highly dependent on medical care.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q14" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q14" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q14" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 15 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">15. Participants who are vulnerable.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q15" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q15" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q15" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 16 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">16. The use of previously collected identifiable personal information or research data for which there was no explicit consent for this research.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q16" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q16" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q16" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 17 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">17. The use of previously collected biological samples for which there was no explicit consent for this research.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q17" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q17" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q17" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 18 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">18. Any evaluation of organisational services or practices where information of a personal nature may be collected and where participants or the organisation may be identified.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q18" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q18" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q18" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 19 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">19. Deception of the participants, including concealment or covert observations.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q19" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q19" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q19" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Question 20 -->
                                        <div class="p-4">
                                            <div class="form-label fw-bold mb-2">20. Payments or other financial inducements (other than reasonable reimbursement of travel expenses or time) to participants.</div>
                                            <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q20" value="yes" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-danger"><span class="me-2">●</span> Yes</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q20" value="no" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-secondary"><span class="me-2">●</span> No</div>
                                                </label>
                                                <label class="form-selectgroup-item flex-fill">
                                                    <input type="radio" name="q20" value="unsure" class="form-selectgroup-input">
                                                    <div class="form-selectgroup-label d-flex align-items-center p-2 text-warning"><span class="me-2">●</span> Unsure</div>
                                                </label>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="card-footer bg-light border-top py-3 px-4">
                                    <button type="button" onclick="clearSelections()" class="btn btn-ghost-secondary btn-sm m-0">
                                        Clear guidance answers
                                    </button>
                                </div>
                            </div>

                            <!-- The one part of this page that is actually recorded -->
                            <div class="card shadow-sm mb-4">
                                <div class="card-header bg-light">
                                    <h3 class="card-title fs-2 fw-bold text-primary">Ethics declaration</h3>
                                </div>
                                <div class="card-body">
                                    <p class="text-secondary">Does your research require ethical approval according to the institutional research ethics policy?</p>
                                    <div class="form-selectgroup form-selectgroup-boxes d-flex flex-column gap-2">
                                        <label class="form-selectgroup-item flex-fill">
                                            @* No `required` here: the page's own submit handler checks this
                                               together with the 20 questions so both are reported at once.
                                               The server still rejects a missing Response regardless. *@
                                            <input type="radio" asp-for="Response" value="Yes" class="form-selectgroup-input">
                                            <div class="form-selectgroup-label d-flex align-items-center p-2">Yes, my research requires ethics approval</div>
                                        </label>
                                        <label class="form-selectgroup-item flex-fill">
                                            <input type="radio" asp-for="Response" value="No" class="form-selectgroup-input">
                                            <div class="form-selectgroup-label d-flex align-items-center p-2">No, ethics approval is not required</div>
                                        </label>
                                        <label class="form-selectgroup-item flex-fill">
                                            <input type="radio" asp-for="Response" value="Unsure" class="form-selectgroup-input">
                                            <div class="form-selectgroup-label d-flex align-items-center p-2">I'm not sure, show me guidance</div>
                                        </label>
                                    </div>
                                    <span asp-validation-for="Response" class="text-danger d-block mt-2"></span>

                                    @if (Model.Guidance is not null)
                                    {
                                        <div class="alert alert-info mt-3 mb-0">
                                            <strong>@Model.Guidance.Title</strong>
                                            <div class="mt-1">@Model.Guidance.Content</div>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-light border-top d-flex justify-content-end align-items-center gap-3 py-3 px-4">
                                    <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId" class="btn btn-link text-secondary text-decoration-none m-0 p-2">
                                        Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary px-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-check me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                                        Submit ethics declaration
                                    </button>
                                </div>
                            </div>

                        </div>
                    </form>

                </div>
            </main>




    <script>
        (function () {
            var form = document.getElementById('riskAssessmentForm');
            var QUESTION_COUNT = 20;

            function blockFor(number) {
                var input = form.querySelector('input[name="q' + number + '"]');
                return input ? input.closest('.p-4') : null;
            }

            function unanswered() {
                var missing = [];
                for (var i = 1; i <= QUESTION_COUNT; i++) {
                    if (!form.querySelector('input[name="q' + i + '"]:checked')) missing.push(i);
                }
                return missing;
            }

            function mark(missing) {
                for (var i = 1; i <= QUESTION_COUNT; i++) {
                    var block = blockFor(i);
                    if (block) block.classList.toggle('rpms-question-missing', missing.indexOf(i) !== -1);
                }
            }

            // The screening questions aren't posted anywhere, so this is the only thing standing
            // between a student and a declaration made without reading them. The declaration
            // itself is checked here too, so one submit produces one message listing everything
            // that's missing rather than one problem at a time.
            form.addEventListener('submit', function (event) {
                var missing = unanswered();
                var declared = !!form.querySelector('input[name="Response"]:checked');

                mark(missing);
                if (!missing.length && declared) return;

                event.preventDefault();

                var problems = [];
                if (missing.length) {
                    problems.push('Answer all ' + QUESTION_COUNT + ' screening questions: ' +
                        missing.length + (missing.length === 1 ? ' is' : ' are') + ' still unanswered.');
                }
                if (!declared) {
                    problems.push('Choose an answer for the ethics declaration.');
                }

                window.rpmsToast('error', problems);

                var target = missing.length ? blockFor(missing[0]) : form.querySelector('input[name="Response"]');
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });

            // Drop the highlight as soon as the question is answered.
            form.addEventListener('change', function (event) {
                if (!/^q\d+$/.test(event.target.name || '')) return;
                var block = event.target.closest('.p-4');
                if (block) block.classList.remove('rpms-question-missing');
            });

            // Called from the "Clear guidance answers" button's onclick.
            window.clearSelections = function () {
                Array.prototype.forEach.call(
                    form.querySelectorAll('input[type="radio"]'),
                    function (radio) { radio.checked = false; });
                mark([]);
            };
        })();
    </script>
