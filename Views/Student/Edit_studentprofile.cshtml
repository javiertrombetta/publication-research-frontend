@model StudentProfileViewModel

            <main class="page-body m-0 py-4">
                <div class="container-xl">

                    <!-- Centred responsive layout wrapper -->
                    <form asp-controller="Student" asp-action="Edit_studentprofile" method="post" class="row justify-content-center">
                        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                            <!-- Minimal Text-Only Header (No card, no circle avatar) -->
                            <div class="mb-4 px-2">
                                <h1 class="h1 m-0 fw-bold text-dark">Edit your profile</h1>
                            </div>


                            <!-- Interactive Account Configuration Grid -->
                            <div class="card shadow-sm">
                                <div class="card-header bg-blue text-white">
                                    <h3 class="card-title fs-2 fw-bold text-white">Academic Profile Details</h3>
                                </div>

                                <div class="card-body py-4 px-4">
                                    <div class="row g-3">

                                        <div class="col-6">
                                            <label asp-for="FirstName" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">First Name</label>
                                            <input asp-for="FirstName" class="form-control" placeholder="Enter first name">
                                            <span asp-validation-for="FirstName" class="text-danger"></span>
                                        </div>

                                        <div class="col-6">
                                            <label asp-for="LastName" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">Surname</label>
                                            <input asp-for="LastName" class="form-control" placeholder="Enter surname">
                                            <span asp-validation-for="LastName" class="text-danger"></span>
                                        </div>

                                        <!-- Student ID / Department are not editable via the self-service profile endpoint -->
                                        <div class="col-6">
                                            <label class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">Student ID (set by Admin)</label>
                                            <input type="text" class="form-control bg-transparent text-primary fw-bold" value="@Model.StudentIdNumber" readonly disabled>
                                        </div>

                                        <div class="col-6">
                                            <label asp-for="Cohort" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">Cohort</label>
                                            <input asp-for="Cohort" class="form-control" placeholder="Enter cohort batch">
                                        </div>

                                        <div class="col-6">
                                            <label asp-for="Programme" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">Programme / Course</label>
                                            <input asp-for="Programme" class="form-control" placeholder="Enter programme or course name">
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">Department (set by Admin)</label>
                                            <input type="text" class="form-control bg-transparent text-dark" value="@Model.DepartmentName" readonly disabled>
                                        </div>

                                        <div class="col-6">
                                            <label asp-for="Orcid" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">ORCID</label>
                                            <input asp-for="Orcid" class="form-control" placeholder="0000-0000-0000-0000">
                                        </div>

                                    </div>
                                </div>

                                <!-- Bottom Actions Footer -->
                                <div class="card-footer bg-transparent d-flex justify-content-end align-items-center gap-3 py-3 px-4">
                                    <a asp-controller="Student" asp-action="studentprofile" class="btn btn-link text-secondary text-decoration-none m-0 p-2">
                                        Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary px-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-check me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                                        Save Changes
                                    </button>
                                </div>
                            </div>

                        </div>
                    </form>

                </div>
            </main>
