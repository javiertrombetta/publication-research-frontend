@model CreateProposalsViewModel
@{ ViewData["Title"] = "Research proposals"; }

            @* A div, not a main: the layout already opens one, and a page has a single main region. *@
            <div class="page-body m-0 py-4">
                <div class="container-xl">

                    @* Rejected input is announced by the shared toast region in the layout, which
                       reads ModelState itself. *@

                    <!-- Centred responsive layout wrapper -->
                    <form asp-controller="Student" asp-action="Create_proposals" method="post" class="row justify-content-center">
                        <input type="hidden" asp-for="ContainerId" />
                        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                            <div class="mb-2 px-2">
                                <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId"
                                   class="text-secondary text-decoration-none small">
                                    &larr; Back to this publication
                                </a>
                            </div>

                            <!-- Minimal Text-Only Header with Limit Context -->
                            <div class="d-flex justify-content-between align-items-end mb-3 px-2">
                                <div>
                                    <h1 class="h1 m-0 fw-bold text-dark">Research proposals</h1>
                                    @* What the institution asks for, rather than a number written
                                       into the page. An administrator sets it, and a round asked
                                       for again is held to the same figures. *@
                                    <p class="text-secondary small m-0">
                                        @Model.RoundSize
                                        @if (Model.Fewest < Model.Most)
                                        {
                                            <span>The first @(Model.Fewest == 1 ? "one is" : $"{Model.Fewest} are") required.</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            @if (Model.IsLocked)
                            {
                                <div class="alert alert-info">
                                    Your proposals have been submitted and are locked for review. You'll be notified if a Coordinator asks you to resubmit.
                                </div>
                            }

                            <!-- One tab per proposal this round takes -->
                            <div class="card shadow-sm">
                                <ul class="nav nav-tabs m-0 bg-light border-bottom" data-bs-toggle="tabs" role="tablist">
                                    @for (var i = 0; i < Model.Slots.Count; i++)
                                    {
                                        <li class="nav-item" role="presentation">
                                            <a href="#tabs-proposal-@i" class="nav-index nav-link py-3 px-4 fw-bold @(i == 0 ? "active" : "")" data-bs-toggle="tab" role="tab">
                                                <span class="badge @(i == 0 ? "bg-primary-lt" : "bg-secondary-lt") me-2">@(i + 1)</span> Proposal @(i + 1)
                                            </a>
                                        </li>
                                    }
                                </ul>

                                <!-- Dynamic Tab Contents Workspace -->
                                <div class="tab-content">
                                    @for (var i = 0; i < Model.Slots.Count; i++)
                                    {
                                        <div class="tab-pane fade @(i == 0 ? "active show" : "")" id="tabs-proposal-@i" role="tabpanel">
                                            <div class="card-body py-4 px-4">
                                                <div class="row g-3">
                                                    <input type="hidden" asp-for="Slots[i].ProposalId" />
                                                    <div class="col-12">
                                                        <label asp-for="Slots[i].Title" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">
                                                            Proposal Title @(i == 0 ? Html.Raw("<span class=\"text-danger\">*</span>") : null)
                                                        </label>
                                                        <input asp-for="Slots[i].Title" class="form-control form-control-lg" placeholder="Enter a descriptive title" maxlength="500" disabled="@Model.IsLocked" />
                                                    </div>
                                                    <div class="col-12">
                                                        <label asp-for="Slots[i].Abstract" class="form-label text-secondary mb-1 uppercase tracking-wider small fw-bold">Abstract</label>
                                                        <textarea asp-for="Slots[i].Abstract" rows="6" class="form-control" placeholder="Provide a concise summary outlining the core objectives, methodology, and expected outcomes..." style="resize: none;" disabled="@Model.IsLocked"></textarea>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(Model.Slots[i].Status))
                                                    {
                                                        <div class="col-12">
                                                            <span class="badge @StatusBadge(Model.Slots[i].Status)">@Humanise(Model.Slots[i].Status)</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Sticky Shared Action Button Footer Container -->
                                @if (!Model.IsLocked)
                                {
                                    <div class="card-footer bg-transparent border-top d-flex justify-content-end align-items-center gap-3 py-3 px-4">
                                        <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId" class="btn btn-link text-secondary text-decoration-none m-0 p-2">
                                            Cancel
                                        </a>
                                        <button type="submit" name="action" value="save" class="btn btn-outline-secondary px-4">
                                            Save draft
                                        </button>
                                        <button type="submit" name="action" value="finish" class="btn btn-primary px-4">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-check me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                                            Submit All Proposals
                                        </button>
                                    </div>
                                }
                            </div>

                        </div>
                    </form>

                </div>
            </div>
