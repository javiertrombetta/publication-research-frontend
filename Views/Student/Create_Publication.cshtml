@model CreatePublicationViewModel
@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@{ ViewData["Title"] = "Research paper"; }

            @* A div, not a main: the layout already opens one, and a page has a single main region. *@
            <div class="page-body m-0 py-4">
                <div class="container-xl">

                    <!-- Centred responsive layout wrapper -->
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                            @* Back to the publication this paper belongs to. Reached from there, and
                               with the sidebar showing the list rather than the one publication,
                               it is the only way back that does not go via the whole list. *@
                            <div class="mb-2 px-2">
                                <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId"
                                   class="text-secondary text-decoration-none small">
                                    &larr; Back to this publication
                                </a>
                            </div>

                            <!-- Header Area -->
                            <div class="mb-4 px-2 d-flex justify-content-between align-items-center">
                                <h1 class="h1 m-0 fw-bold text-dark">Research Paper</h1>
                                @if (!string.IsNullOrEmpty(Model.Status))
                                {
                                    <span class="badge @StatusBadge(Model.Status)">@Humanise(Model.Status)</span>
                                }
                            </div>

@if (!Model.IsEditable)
{
    @* Submitted and beyond: the paper is with somebody, or the outcome is already recorded. It is
       shown rather than offered for editing, and shown in full, with the file, because "accepted"
       said about a paper you cannot open is not seeing it. *@
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h2 class="card-title fs-3 fw-bold text-primary">Your Research Info</h2>
        </div>
        <div class="card-body p-4">

            <div class="mb-3">
                <div class="text-secondary small fw-bold">Research Title</div>
                <div class="fs-3">@(string.IsNullOrWhiteSpace(Model.Title) ? "—" : Model.Title)</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-8">
                    <div class="text-secondary small fw-bold">Publication Type</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.PublicationType) ? "—" : Model.PublicationType)</div>
                </div>
                <div class="col-4">
                    <div class="text-secondary small fw-bold">Year</div>
                    <div>@(Model.PublicationYear?.ToString() ?? "—")</div>
                </div>
            </div>

            @{
                var keywords = (Model.KeywordsCsv ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            }
            @if (keywords.Length > 0)
            {
                <div class="mb-3">
                    <div class="text-secondary small fw-bold mb-1">Keywords</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var keyword in keywords)
                        {
                            <span class="badge bg-blue-lt px-2 py-1 fs-4">@keyword</span>
                        }
                    </div>
                </div>
            }

            <div class="mb-3">
                <div class="text-secondary small fw-bold">Abstract</div>
                @* Preserves the paragraphing the student typed; Razor still encodes the text. *@
                <div style="white-space: pre-wrap">@(string.IsNullOrWhiteSpace(Model.Abstract) ? "—" : Model.Abstract)</div>
            </div>

            <div>
                <div class="text-secondary small fw-bold mb-1">Manuscript</div>
                @if (Model.LatestVersionId is { } versionId)
                {
                    <a class="btn btn-outline-primary"
                       asp-controller="Downloads" asp-action="Paper"
                       asp-route-publicationId="@Model.PublicationId" asp-route-versionId="@versionId">
                        Download version @Model.LatestVersionNumber
                    </a>
                }
                else
                {
                    <span class="text-secondary">No file on record.</span>
                }
            </div>

        </div>

        <div class="card-footer bg-light border-top d-flex justify-content-between align-items-center py-3 px-4">
            <span class="text-secondary">
                @(Model.Status == PublicationStatus.Accepted
                    ? "This paper has been accepted, so it can no longer be changed."
                    : "This paper is being reviewed, so it can no longer be changed.")
            </span>
            <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId" class="btn btn-outline-secondary">
                Back to this publication
            </a>
        </div>
    </div>
}
else
{
                            @* What was asked for. A paper comes back carrying a status and nothing
                               else, and "revisions requested" does not say what to revise: the
                               comments were being written for somebody who never saw them. *@
                            @if (Model.Reviews.Count > 0)
                            {
                                <div class="card shadow-sm mb-4">
                                    <div class="card-header bg-light">
                                        <h2 class="card-title fs-3 fw-bold text-primary">
                                            @(Model.IsRevision ? "What you have been asked to change" : "What has been said about your paper")
                                        </h2>
                                    </div>
                                    <div class="card-body p-4">
                                        @foreach (var review in Model.Reviews)
                                        {
                                            <div class="mb-3">
                                                <div class="d-flex flex-wrap align-items-baseline gap-2 mb-1">
                                                    <span class="fw-bold">@review.ReviewerName</span>
                                                    <span class="text-secondary small">@Humanise(review.ReviewerType)</span>
                                                    <span class="badge @(review.Decision == "Approve" ? "bg-green-lt" : "bg-orange-lt")">@Humanise(review.Decision)</span>
                                                    <span class="text-secondary small ms-auto">@review.ReviewedAt.ToLocalTime().ToString("dd MMM yyyy 'at' HH:mm")</span>
                                                </div>
                                                <p class="m-0">@review.Comments</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- MAIN SUBMISSION FORM -->
                            <form id="publicationForm" asp-controller="Student" asp-action="Create_Publication" method="post" enctype="multipart/form-data" class="card shadow-sm mb-4">
                                <input type="hidden" asp-for="PublicationId" />
                                <input type="hidden" asp-for="ContainerId" />
                                <div class="card-header bg-light">
                                    <h2 class="card-title fs-3 fw-bold text-primary">Your Research Info</h2>
                                </div>
                                <div class="card-body p-4">

                                    <div class="row g-3 mb-3">
                                        <div class="col-8">
                                            <label asp-for="PublicationType" class="form-label fw-bold mb-1">Publication Type</label>
                                            <select asp-for="PublicationType" class="form-select">
                                                <option value="">Select publication format...</option>
                                                <option value="Journal Article">Journal Article</option>
                                                <option value="Conference Proceeding">Conference Proceeding</option>
                                                <option value="Thesis / Dissertation">Thesis / Dissertation</option>
                                                <option value="Technical Report">Technical Report</option>
                                            </select>
                                        </div>
                                        <div class="col-4">
                                            <label asp-for="PublicationYear" class="form-label fw-bold mb-1">Year</label>
                                            <input type="number" asp-for="PublicationYear" class="form-control" placeholder="2026" />
                                        </div>
                                    </div>

                                    <!-- Title Input -->
                                    <div class="mb-3">
                                        <label asp-for="Title" class="form-label fw-bold mb-1">Research Title <span class="text-danger">*</span></label>
                                        <input asp-for="Title" class="form-control" placeholder="Enter the full title of your research paper" />
                                        <span asp-validation-for="Title" class="text-danger"></span>
                                    </div>

                                    <!-- DYNAMIC KEYWORDS UI -->
                                    <div class="mb-3">
                                        <label for="keywordField" class="form-label fw-bold mb-1">Keywords</label>
                                        <div class="text-secondary small mb-2">Type a keyword and click Add or press Enter to add it to your research profile.</div>

                                        <!-- Hidden field to submit combined values cleanly to backend -->
                                        <input asp-for="KeywordsCsv" type="hidden" id="hiddenKeywordsInput" />

                                        <!-- Input Field Action Group -->
                                        <div class="input-group mb-2">
                                            <input type="text" id="keywordField" class="form-control" placeholder="e.g. Machine Learning" autocomplete="off" />
                                            <button class="btn btn-outline-secondary" type="button" id="addKeywordBtn">Add</button>
                                        </div>

                                        <!-- Interactive Tag Pool Display -->
                                        <div id="keywordTagsContainer" class="d-flex flex-wrap gap-2 py-1">
                                            <!-- Generated tags will attach here dynamically -->
                                        </div>
                                    </div>

                                    <!-- Abstract Textarea -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label for="abstractInput" class="form-label fw-bold m-0">Abstract <span class="text-danger">*</span></label>
                                            <span class="text-secondary small" id="abstractWordCount">0 / 2000 words</span>
                                        </div>
                                        <textarea asp-for="Abstract" id="abstractInput" class="form-control" rows="6" placeholder="Provide a concise summary of your research objectives, methodology, results, and conclusions..."></textarea>
                                        <span asp-validation-for="Abstract" class="text-danger"></span>
                                    </div>

                                    <!-- Note to Reviewer Textarea -->
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <label for="noteInput" class="form-label fw-bold m-0">Note to Reviewer</label>
                                            <span class="text-secondary small" id="noteWordCount">0 / 2000 words</span>
                                        </div>
                                        <textarea asp-for="ReviewerNotes" id="noteInput" class="form-control" rows="4" placeholder="Add any specific context, funding acknowledgments, or procedural notes for the reviewing committee member..."></textarea>
                                    </div>

                                    <!-- Document Upload Area -->
                                    <div class="mb-2">
                                        <label asp-for="ResearchFile" class="form-label fw-bold mb-1">Upload Research File @(Model.HasUploadedVersion ? "" : "*")</label>
                                        <div class="text-secondary small mb-2">
                                            Upload the full manuscript document. Supported formats: PDF, DOC, DOCX, ZIP.
                                            @if (Model.HasUploadedVersion)
                                            {
                                                <span>Leave empty to keep the version already on file (v@(Model.LatestVersionNumber)).</span>
                                            }
                                        </div>
                                        <input type="file" asp-for="ResearchFile" class="form-control" accept=".pdf,.doc,.docx,.zip" />
                                    </div>

                                </div>

                                <!-- Action Buttons Footer Container -->
                                <div class="card-footer bg-light border-top d-flex justify-content-end align-items-center gap-3 py-3 px-4">
                                    <a asp-controller="Student" asp-action="Publication" asp-route-id="@Model.ContainerId" class="btn btn-link text-secondary text-decoration-none m-0 p-2">
                                        Cancel
                                    </a>
                                    <button type="submit" name="action" value="draft" class="btn btn-outline-secondary m-0 px-3">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-file-download me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M12 14v4" /><path d="M10 16l2 2l2 -2" /></svg>
                                        Save Draft
                                    </button>
                                    <button type="submit" name="action" value="submit" class="btn btn-primary px-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-send me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 14l11 -11" /><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></svg>
                                        @(Model.IsRevision ? "Send the revision back" : "Submit Publication")
                                    </button>
                                </div>
                            </form>
}

                        </div>
                    </div>

                </div>
            </div>

@* The compiler in the current SDK will not read a <script nonce="@Context.ScriptNonceValue()"> that sits inside a Razor code block,
   so the "only while it is editable" part is said in JavaScript instead: on a read-only draft
   none of these controls are on the page and there is nothing to wire up. *@
@section Scripts {
    <script nonce="@Context.ScriptNonceValue()">
        if (document.getElementById('abstractInput')) {
            const MAX_WORDS = 2000;
            const abstractInput = document.getElementById('abstractInput');
            const noteInput = document.getElementById('noteInput');
            const abstractCountEl = document.getElementById('abstractWordCount');
            const noteCountEl = document.getElementById('noteWordCount');

            // KEYWORD STATE AND DOM HANDLING
            let keywordsArray = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.KeywordsCsv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)));
            const keywordField = document.getElementById('keywordField');
            const addKeywordBtn = document.getElementById('addKeywordBtn');
            const keywordTagsContainer = document.getElementById('keywordTagsContainer');
            const hiddenKeywordsInput = document.getElementById('hiddenKeywordsInput');
            renderTags();

            function updateKeywordsField() {
                // Keep hidden data sync'd for validation and submit rules
                hiddenKeywordsInput.value = keywordsArray.join(',');
            }

            function renderTags() {
                keywordTagsContainer.innerHTML = '';
                keywordsArray.forEach((keyword, index) => {
                    const tag = document.createElement('span');
                    tag.className = 'badge bg-blue-lt d-inline-flex align-items-center px-2 py-1 fs-4';

                    // Built element by element rather than from a string of HTML. A keyword is whatever
                    // the author typed, so putting it through innerHTML would let it bring markup of its
                    // own along with it.
                    const remove = document.createElement('a');
                    remove.className = 'ms-2 text-blue text-decoration-none fw-bold lh-1 p-0 cursor-pointer';
                    remove.style.fontSize = '1.1em';
                    remove.textContent = '×';
                    remove.addEventListener('click', () => removeKeyword(index));

                    tag.replaceChildren(document.createTextNode(keyword), remove);
                    keywordTagsContainer.appendChild(tag);
                });
                updateKeywordsField();
            }

            function addKeywordFromInput() {
                const val = keywordField.value.trim();
                if (val && !keywordsArray.includes(val)) {
                    keywordsArray.push(val);
                    renderTags();
                    keywordField.value = '';
                }
                keywordField.focus();
            }

            function removeKeyword(index) {
                keywordsArray.splice(index, 1);
                renderTags();
            }

            // Trigger additions on button clicks or Enter keys
            addKeywordBtn.addEventListener('click', addKeywordFromInput);
            keywordField.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault(); // Stop standard form submission triggers
                    addKeywordFromInput();
                }
            });


            // WORD COUNTER FUNCTIONS
            function handleWordCount(textarea, counterElement) {
                textarea.addEventListener('input', () => {
                    const text = textarea.value.trim();
                    const words = text ? text.split(/\s+/) : [];

                    if (words.length > MAX_WORDS) {
                        const remainingWords = words.slice(0, MAX_WORDS).join(' ');
                        textarea.value = remainingWords;
                        counterElement.textContent = `${MAX_WORDS} / ${MAX_WORDS} words`;
                        counterElement.classList.replace('text-secondary', 'text-danger');
                    } else {
                        counterElement.textContent = `${words.length} / ${MAX_WORDS} words`;
                        counterElement.classList.replace('text-danger', 'text-secondary');
                    }
                });
            }

            handleWordCount(abstractInput, abstractCountEl);
            handleWordCount(noteInput, noteCountEl);
        }
    </script>
}
