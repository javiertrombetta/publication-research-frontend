@model ResearchPublicationManagementSystem.Models.ProposalListViewModel
@using ResearchPublicationManagementSystem.Models

@{
    ViewData["Title"] = "Proposal Management";
}

<partial name="_PageHeader"
         model='new PageHeaderViewModel
         {
             Title = "Proposal Management",
             Subtitle = "Monitor and manage research proposals."
         }' />

<!-- Statistics -->

    <div class="row">

        <div class="col-lg-3 col-md-6 mb-3">

            <partial name="_StatisticCard"
                     model='new StatisticCardViewModel
                     {
                         Title = "Total Proposals",
                         Value = Model.TotalProposals,
                         ColorClass = "text-primary",
                         Icon = "file-text",
                         IconBackground = "bg-primary-lt"
                     }' />

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <partial name="_StatisticCard"
                     model='new StatisticCardViewModel
                     {
                         Title = "Pending Assignment",
                         Value = Model.PendingAssignment,
                         ColorClass = "text-warning",
                         Icon = "user-question",
                         IconBackground = "bg-warning-lt"
                     }' />

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <partial name="_StatisticCard"
                     model='new StatisticCardViewModel
                     {
                         Title = "Under Review",
                         Value = Model.UnderReview,
                         ColorClass = "text-info",
                         Icon = "clock",
                         IconBackground = "bg-info-lt"
                     }' />

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <partial name="_StatisticCard"
                     model='new StatisticCardViewModel
                     {
                         Title = "Approved",
                         Value = Model.Approved,
                         ColorClass = "text-success",
                         Icon = "circle-check",
                         IconBackground = "bg-success-lt"
                     }' />

        </div>

    </div>


<!-- Search & Filter Toolbar -->

<partial name="_SearchFilterToolbar"
         model="Model.Toolbar" />

<!-- Table -->

<div class="card mt-3">

    <div class="card-body">

        <partial name="_ProposalTable"
                 model="Model.Proposals" />

    </div>

    <div class="card-footer">

        <partial name="_Pagination" />

    </div>

</div>