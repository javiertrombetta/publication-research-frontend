@* For the EthicsReviewOrder constants; kept local rather than in _ViewImports so the DTO
   namespace does not shadow anything in the other views. *@
@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model SystemSettingsViewModel
@{
    ViewData["Title"] = "System settings";
}

@* Tabs are links rather than Bootstrap's JS tabs: Tabler's tabler.min.js does not bundle
   Bootstrap's JavaScript. A link also survives the redirect after a save, and can be bookmarked.

   Each checkbox is followed by a hidden field of the same name carrying "false". An unchecked
   box posts nothing at all, so without it, clearing a switch would be indistinguishable from
   not touching it. *@
@functions {
    /// <summary>
    /// Settings that decide how the research process runs, in the order somebody looks for them:
    /// alphabetically.
    /// </summary>
    private static readonly (string Value, string Label)[] ProcessTabs =
    [
        ("committees", "Committees"),
        ("decisions", "Comments on decisions"),
        ("deadlines", "Deadlines"),
        ("ethics", "Ethics documents"),
        ("pipeline", "Pipeline steps")
    ];

    /// <summary>Settings that describe the installation rather than the process.</summary>
    private static readonly (string Value, string Label)[] SystemTabs =
    [
        ("access", "Access"),
        ("departments", "Departments"),
        ("messaging", "Messages"),
        ("storage", "File storage"),
        ("institution", "Institution"),
        ("notifications", "Notifications"),
        ("passwords", "Passwords"),
        ("uploads", "Uploads")
    ];
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">

        <div class="mb-4">
            <h1 class="page-title mb-1">System settings</h1>
            <div class="text-secondary">
                The rules the whole system runs by. Changes to committees and to ethics documents
                apply to publications started afterwards, so research already under way is judged
                by the rules it began under.
            </div>
        </div>

        @if (Model.LoadFailed)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h3 class="mb-2">We couldn't load the settings</h3>
                    <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
                    <a asp-action="Index" class="btn btn-primary">Retry</a>
                </div>
            </div>
        }
        else
        {
            @* A menu rather than a row of tabs: there are a dozen groups and they wrapped onto
               three lines, which read as three rows of unrelated things. Split in two so it is
               clear which settings change how the research process runs and which describe the
               installation itself, and alphabetical inside each so a name can be found rather
               than hunted for. *@
            <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
                <div class="col-12 col-md-6 col-lg-5">
                    <label class="form-label" for="settings-group">Settings</label>
                    <select id="settings-group" name="tab" class="form-select" data-rpms-go-on-change>
                        <optgroup label="The research process">
                            @foreach (var (value, label) in ProcessTabs)
                            {
                                <option value="@value" selected="@(Model.ActiveTab == value)">@label</option>
                            }
                        </optgroup>
                        <optgroup label="This installation">
                            @foreach (var (value, label) in SystemTabs)
                            {
                                <option value="@value" selected="@(Model.ActiveTab == value)">@label</option>
                            }
                        </optgroup>
                    </select>
                </div>
                @* Shown only where the menu cannot navigate on its own. *@
                <div class="col-auto" data-rpms-hide-with-script>
                    <button type="submit" class="btn btn-outline-secondary">Show</button>
                </div>
            </form>

            if (Model.ActiveTab == "committees")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Evaluation committees</h2>
                        <p class="text-secondary">
                            How many members an evaluation committee needs, and how many of them must
                            approve for a research paper to pass. A publication records these figures
                            when it is opened, so changing them here never moves the goalposts for
                            work already in progress.
                        </p>

                        <form asp-action="SaveCommittees" method="post" class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="reviewer-members">Reviewers</label>
                                <input id="reviewer-members" name="reviewerMembers" type="number" min="0" max="20"
                                       value="@Model.Committees.ReviewerMembers" class="form-control" required />
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="external-members">External members</label>
                                <input id="external-members" name="externalMembers" type="number" min="0" max="20"
                                       value="@Model.Committees.ExternalMembers" class="form-control" required />
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="minimum-approvals">Approvals needed</label>
                                <input id="minimum-approvals" name="minimumApprovals" type="number" min="1" max="40"
                                       value="@Model.Committees.MinimumApprovals" class="form-control" required />
                                <small class="form-hint">Cannot exceed the committee's size.</small>
                            </div>
                            <div class="col-12">
                                <hr class="my-2" />
                                <h3 class="h4 mb-1">Who committees are drawn from</h3>
                                <p class="text-secondary mb-2">
                                    Which roles this institution asks to evaluate papers, and anybody
                                    to leave out of it. Students are never candidates, because a
                                    committee judges their work, and neither is an account still
                                    waiting to be given a role.
                                </p>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Roles</label>
                                <div class="row g-2">
                                    @foreach (var role in Model.Committees.SelectableRoles)
                                    {
                                        <div class="col-12 col-sm-6 col-lg-4">
                                            <label class="form-check">
                                                <input class="form-check-input" type="checkbox" name="candidateRoles"
                                                       value="@role"
                                                       checked="@(Model.Committees.CandidateRoles.Contains(role))" />
                                                <span class="form-check-label">@DisplayText.Humanise(role)</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                                <small class="form-hint">Choose at least one, or no committee could be formed.</small>
                            </div>

                            <div class="col-12">
                                <label class="form-label">People to leave out</label>
                                @if (Model.CommitteePeople.Count == 0)
                                {
                                    <div class="text-secondary">
                                        Nobody holds a role that committees are drawn from yet.
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var person in Model.CommitteePeople)
                                        {
                                            <div class="col-12 col-sm-6 col-lg-4">
                                                <label class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="excludedUserIds"
                                                           value="@person.Id"
                                                           checked="@(Model.Committees.ExcludedUserIds.Contains(person.Id))" />
                                                    <span class="form-check-label">
                                                        @person.FullName
                                                        <span class="text-secondary">@string.Join(", ", person.Roles.Select(DisplayText.Humanise))</span>
                                                    </span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <small class="form-hint">
                                        Ticked means they will not be offered when a committee is assigned.
                                    </small>
                                }
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Save committee rules</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "departments")
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Departments</h2>
                        <p class="text-secondary">
                            What this institution is divided into. Every student belongs to one, and it
                            decides which coordinator they are given and which head of department
                            oversees their work.
                        </p>

                        @if (Model.Departments.Count == 0)
                        {
                            <p class="text-secondary mb-0">
                                None yet. Add one below: nobody can register until there is at least one
                                department to belong to.
                            </p>
                        }

                        @foreach (var department in Model.Departments)
                        {
                            var chosen = Model.DepartmentMembers?.DepartmentId == department.Id;

                            <div class="border rounded p-3 mb-3 @(chosen ? "border-primary" : "")">
                                <form asp-action="RenameDepartment" method="post" class="row g-2 align-items-end">
                                    <input type="hidden" name="id" value="@department.Id" />
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="dept-name-@department.Id">Name</label>
                                        <input id="dept-name-@department.Id" name="name" value="@department.Name"
                                               maxlength="200" class="form-control" required />
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <label class="form-label" for="dept-code-@department.Id">Code</label>
                                        <input id="dept-code-@department.Id" name="code" value="@department.Code"
                                               maxlength="20" class="form-control" required />
                                    </div>
                                    <div class="col-6 col-md-2 text-end">
                                        <button type="submit" class="btn btn-outline-primary w-100">Save</button>
                                    </div>
                                    <div class="col-12 col-md-2 text-end">
                                        @if (chosen)
                                        {
                                            <span class="btn btn-ghost-secondary w-100 disabled">Arranging</span>
                                        }
                                        else
                                        {
                                            <a class="btn btn-outline-secondary w-100" asp-action="Index"
                                               asp-route-tab="departments" asp-route-departmentId="@department.Id">
                                                Who is in it
                                            </a>
                                        }
                                    </div>
                                </form>

                                <div class="d-flex align-items-center justify-content-between mt-2">
                                    <small class="text-secondary">
                                        @(string.IsNullOrWhiteSpace(department.HeadOfDepartmentName)
                                            ? "Nobody heads it yet."
                                            : $"Headed by {department.HeadOfDepartmentName}.")
                                    </small>
                                    @* The name goes in an attribute that is read as text, not into a
                                       string inside a script. Razor escapes an apostrophe to &#x27;,
                                       which the browser turns back into one before JavaScript sees
                                       it, so a department called Owner's Studies closed the quote
                                       early and left the handler a syntax error. A broken handler is
                                       no handler: the form went straight through and deleting a
                                       department stopped asking. *@
                                    <form asp-action="RemoveDepartment" method="post">
                                        <input type="hidden" name="id" value="@department.Id" />
                                        <button type="submit" class="btn btn-link link-secondary p-0"
                                                data-rpms-confirm="Remove @department.Name? This only works while nobody belongs to it.">Remove</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h3 mb-3">Add a department</h2>
                        <form asp-action="AddDepartment" method="post" class="row g-2 align-items-end">
                            <div class="col-12 col-md-7">
                                <label class="form-label" for="new-dept-name">Name</label>
                                <input id="new-dept-name" name="name" maxlength="200" class="form-control"
                                       placeholder="Information Technology" required />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label" for="new-dept-code">Code</label>
                                <input id="new-dept-code" name="code" maxlength="20" class="form-control"
                                       placeholder="IT" required />
                            </div>
                            <div class="col-6 col-md-2 text-end">
                                <button type="submit" class="btn btn-primary w-100">Add</button>
                            </div>
                        </form>
                    </div>
                </div>

                if (Model.DepartmentMembers is not null)
                {
                    var members = Model.DepartmentMembers;
                    var headIds = members.HeadsOfDepartment.Select(p => p.UserId).ToHashSet();
                    var coordinatorIds = members.Coordinators.Select(p => p.UserId).ToHashSet();

                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="h3 mb-2">Who is in @members.DepartmentName</h2>
                            <p class="text-secondary">
                                A head of department and a coordinator belong to one department, so this
                                is where they are arranged. Ticking somebody moves them here from
                                wherever they were. Untick nobody: taking someone out is done by putting
                                them in another department, or by changing what they are in
                                <a asp-controller="Users" asp-action="Index">Users</a>, which is also
                                where a role is granted in the first place.
                            </p>

                            <form asp-action="SaveDepartmentMembers" method="post" class="row g-4">
                                <input type="hidden" name="id" value="@members.DepartmentId" />

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Heads of department</label>
                                    @if (Model.HeadCandidates.Count == 0)
                                    {
                                        <p class="text-secondary mb-0">
                                            Nobody holds the role yet. Grant it in Users first.
                                        </p>
                                    }
                                    @foreach (var person in Model.HeadCandidates)
                                    {
                                        <label class="form-check">
                                            <input class="form-check-input" type="checkbox" name="headOfDepartmentUserIds"
                                                   value="@person.Id" checked="@headIds.Contains(person.Id)" />
                                            <span class="form-check-label">
                                                @person.FullName
                                                <small class="d-block text-secondary">@person.Email</small>
                                            </span>
                                        </label>
                                    }
                                    <small class="form-hint">
                                        One is the usual arrangement, and more than one is allowed where an
                                        institution shares the post.
                                    </small>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Coordinators</label>
                                    @if (Model.CoordinatorCandidates.Count == 0)
                                    {
                                        <p class="text-secondary mb-0">
                                            Nobody holds the role yet. Grant it in Users first.
                                        </p>
                                    }
                                    @foreach (var person in Model.CoordinatorCandidates)
                                    {
                                        <label class="form-check">
                                            <input class="form-check-input" type="checkbox" name="coordinatorUserIds"
                                                   value="@person.Id" checked="@coordinatorIds.Contains(person.Id)" />
                                            <span class="form-check-label">
                                                @person.FullName
                                                <small class="d-block text-secondary">@person.Email</small>
                                            </span>
                                        </label>
                                    }
                                    <small class="form-hint">
                                        As many as the department needs. New students are shared out among
                                        whoever is taking work on.
                                    </small>
                                </div>

                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">Save who is in it</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <h2 class="h3 mb-2">Also working here</h2>
                            <p class="text-secondary">
                                A supervisor and a reviewer may work in several departments at once, so
                                which ones they are in is part of what they are rather than something
                                this department decides. It is set with their role, in
                                <a asp-controller="Users" asp-action="Index">Users</a>.
                            </p>

                            <div class="row g-4">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Supervisors</label>
                                    @if (members.Supervisors.Count == 0)
                                    {
                                        <p class="text-secondary mb-0">None attached to this department.</p>
                                    }
                                    @foreach (var person in members.Supervisors)
                                    {
                                        <div class="border-top py-2">
                                            @person.Name
                                            <small class="d-block text-secondary">@person.Email</small>
                                        </div>
                                    }
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Reviewers</label>
                                    @if (members.Reviewers.Count == 0)
                                    {
                                        <p class="text-secondary mb-0">None attached to this department.</p>
                                    }
                                    @foreach (var person in members.Reviewers)
                                    {
                                        <div class="border-top py-2">
                                            @person.Name
                                            <small class="d-block text-secondary">@person.Email</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            if (Model.ActiveTab == "ethics")
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Documents students must supply</h2>
                        <p class="text-secondary">
                            What the ethics stage asks for. A publication is given this list when its
                            documentation is first requested and keeps it, so adding or retiring a
                            document changes what the next student is asked for, not what a student
                            halfway through already owes.
                        </p>

                        @if (!Model.ActiveEthicsDocuments.Any())
                        {
                            <p class="text-secondary">
                                Nothing is configured, so no student can be asked for ethics
                                documentation. Add at least one below.
                            </p>
                        }

                        @foreach (var document in Model.ActiveEthicsDocuments)
                        {
                            <div class="border rounded p-3 mb-3">
                                <form asp-action="UpdateEthicsDocument" method="post" class="row g-2 align-items-end">
                                    <input type="hidden" name="id" value="@document.Id" />
                                    <div class="col-12 col-md-5">
                                        <label class="form-label" for="name-@document.Id">Name</label>
                                        <input id="name-@document.Id" name="name" value="@document.Name"
                                               maxlength="200" class="form-control" required />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label class="form-label" for="description-@document.Id">Description</label>
                                        <input id="description-@document.Id" name="description" value="@document.Description"
                                               class="form-control" placeholder="Shown to the student" />
                                    </div>
                                    <div class="col-4 col-md-1">
                                        <label class="form-label" for="order-@document.Id">Order</label>
                                        <input id="order-@document.Id" name="sortOrder" type="number" min="0"
                                               value="@document.SortOrder" class="form-control" required />
                                    </div>
                                    <div class="col-8 col-md-2 text-end">
                                        <button type="submit" class="btn btn-outline-primary w-100">Save</button>
                                    </div>
                                </form>

                                <form asp-action="SetEthicsDocumentActive" method="post" class="mt-2">
                                    <input type="hidden" name="id" value="@document.Id" />
                                    <input type="hidden" name="isActive" value="false" />
                                    <button type="submit" class="btn btn-link link-secondary p-0">
                                        Stop asking for this
                                    </button>
                                    @if (document.IsInUse)
                                    {
                                        <small class="text-secondary d-block">
                                            Students have already uploaded against this, so it is retired rather
                                            than removed and their submissions stay intact.
                                        </small>
                                    }
                                </form>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h3 mb-3">Add a document</h2>
                        <form asp-action="AddEthicsDocument" method="post" class="row g-2 align-items-end">
                            <div class="col-12 col-md-5">
                                <label class="form-label" for="new-name">Name</label>
                                <input id="new-name" name="name" maxlength="200" class="form-control"
                                       placeholder="Participant Information Sheet" required />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label" for="new-description">Description</label>
                                <input id="new-description" name="description" class="form-control"
                                       placeholder="Shown to the student" />
                            </div>
                            <div class="col-4 col-md-1">
                                <label class="form-label" for="new-order">Order</label>
                                <input id="new-order" name="sortOrder" type="number" min="0"
                                       value="@(Model.ActiveEthicsDocuments.Count() + 1)" class="form-control" required />
                            </div>
                            <div class="col-8 col-md-2 text-end">
                                <button type="submit" class="btn btn-primary w-100">Add</button>
                            </div>
                        </form>
                    </div>
                </div>

                if (Model.RetiredEthicsDocuments.Any())
                {
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h3 mb-2">No longer asked for</h2>
                            <p class="text-secondary">
                                Kept so that submissions made against them stay readable, and so one can
                                be brought back rather than recreated.
                            </p>

                            @foreach (var document in Model.RetiredEthicsDocuments)
                            {
                                <form asp-action="SetEthicsDocumentActive" method="post"
                                      class="d-flex align-items-center justify-content-between border-top py-2">
                                    <input type="hidden" name="id" value="@document.Id" />
                                    <input type="hidden" name="isActive" value="true" />
                                    <span>@document.Name</span>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Ask for it again</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }

            if (Model.ActiveTab == "passwords")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Passwords</h2>
                        <p class="text-secondary">
                            Applies to everyone. The rules take effect the next time a password is set,
                            tightening them does not invalidate passwords already in use.
                        </p>

                        <form asp-action="SavePasswords" method="post">
                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="minimum-length">Minimum length</label>
                                    <input id="minimum-length" name="minimumLength" type="number" min="8" max="128"
                                           value="@Model.Passwords.MinimumLength" class="form-control" required />
                                    <small class="form-hint">At least 8.</small>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="expiry-days">Expires after (days)</label>
                                    <input id="expiry-days" name="expiryDays" type="number" min="0" max="3650"
                                           value="@Model.Passwords.ExpiryDays" class="form-control" required />
                                    <small class="form-hint">0 means passwords never expire. Otherwise at least 30 days.</small>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="form-label">Must contain</div>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="requireDigit" value="true"
                                           checked="@Model.Passwords.RequireDigit" />
                                    <input type="hidden" name="requireDigit" value="false" />
                                    <span class="form-check-label">A number</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="requireUppercase" value="true"
                                           checked="@Model.Passwords.RequireUppercase" />
                                    <input type="hidden" name="requireUppercase" value="false" />
                                    <span class="form-check-label">A capital letter</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="requireLowercase" value="true"
                                           checked="@Model.Passwords.RequireLowercase" />
                                    <input type="hidden" name="requireLowercase" value="false" />
                                    <span class="form-check-label">A lower-case letter</span>
                                </label>
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="requireSymbol" value="true"
                                           checked="@Model.Passwords.RequireSymbol" />
                                    <input type="hidden" name="requireSymbol" value="false" />
                                    <span class="form-check-label">A symbol, such as ! or ?</span>
                                </label>
                            </div>

                            <hr class="my-4" />

                            <h3 class="h4 mb-2">Locking an account out</h3>
                            <p class="text-secondary">
                                Counts wrong passwords on signing in and on changing a password alike.
                            </p>

                            <div class="row g-3">
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="lockout-attempts">Failed attempts allowed</label>
                                    <input id="lockout-attempts" name="lockoutAttempts" type="number" min="3" max="20"
                                           value="@Model.Passwords.LockoutAttempts" class="form-control" required />
                                    <small class="form-hint">Between 3 and 20.</small>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="lockout-minutes">Locked for (minutes)</label>
                                    <input id="lockout-minutes" name="lockoutMinutes" type="number" min="1" max="1440"
                                           value="@Model.Passwords.LockoutMinutes" class="form-control" required />
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Save password rules</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "notifications")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Notifications</h2>
                        <p class="text-secondary">
                            Everyone is notified inside the application, where they see it when they
                            next sign in. Email is an additional copy, and needs a mail server.
                        </p>

                        <form asp-action="SaveNotifications" method="post">
                            <label class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="emailEnabled" value="true"
                                       checked="@Model.Notifications.EmailEnabled" />
                                <input type="hidden" name="emailEnabled" value="false" />
                                <span class="form-check-label">Also send notifications by email</span>
                            </label>

                            <div class="row g-3">
                                <div class="col-12 col-sm-8">
                                    <label class="form-label" for="smtp-host">SMTP server</label>
                                    <input id="smtp-host" name="smtpHost" value="@Model.Notifications.SmtpHost"
                                           class="form-control" placeholder="smtp.example.com" />
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label" for="smtp-port">Port</label>
                                    <input id="smtp-port" name="smtpPort" type="number" min="1" max="65535"
                                           value="@Model.Notifications.SmtpPort" class="form-control" required />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="smtp-username">Username</label>
                                    <input id="smtp-username" name="smtpUsername" value="@Model.Notifications.SmtpUsername"
                                           class="form-control" autocomplete="off" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="smtp-password">Password</label>
                                    <input id="smtp-password" name="smtpPassword" type="password"
                                           class="form-control" autocomplete="new-password" />
                                    <small class="form-hint">
                                        @if (Model.Notifications.HasPassword)
                                        {
                                            <span>
                                                A password is stored. It is never shown again, so leave this
                                                blank unless you are changing it.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>No password is stored yet.</span>
                                        }
                                    </small>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="from-address">Sender address</label>
                                    <input id="from-address" name="fromAddress" type="email"
                                           value="@Model.Notifications.FromAddress" class="form-control"
                                           placeholder="no-reply@ais.ac.nz" />
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="form-label" for="from-name">Sender name</label>
                                    <input id="from-name" name="fromName" value="@Model.Notifications.FromName"
                                           class="form-control" placeholder="AIS Research Publication Site" />
                                </div>
                            </div>

                            <label class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" name="useSsl" value="true"
                                       checked="@Model.Notifications.UseSsl" />
                                <input type="hidden" name="useSsl" value="false" />
                                <span class="form-check-label">Use a secure connection (STARTTLS)</span>
                            </label>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Save notification settings</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "deadlines")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Stage deadlines</h2>
                        <p class="text-secondary">
                            How long each stage is expected to take. These mark work as overdue,
                            they never stop it being done late, because a deadline that blocked a
                            supervisor from responding would only strand the student waiting.
                            Use 0 where nothing should ever be reported late.
                        </p>
                        <p class="text-secondary">
                            Each one also carries a reminder, sent that many days before the
                            deadline to whoever still owes the work. It has to be shorter than the
                            deadline it belongs to, or it would be sent before the work arrived.
                            Use 0 to send none. Reminders go to the person's notifications, and by
                            email as well wherever email is switched on.
                        </p>

                        <form asp-action="SaveDeadlines" method="post" class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="supervisor-days">Supervisor response</label>
                                <div class="input-group">
                                    <input id="supervisor-days" name="supervisorResponseDays" type="number" min="0" max="365"
                                           value="@Model.Deadlines.SupervisorResponseDays" class="form-control" required />
                                    <span class="input-group-text">days</span>
                                </div>
                                <small class="form-hint">
                                    From a proposal being sent to them. When it passes, proposals
                                    nobody offered to supervise go back to the coordinator.
                                </small>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="ethics-days">Ethics review</label>
                                <div class="input-group">
                                    <input id="ethics-days" name="ethicsReviewDays" type="number" min="0" max="365"
                                           value="@Model.Deadlines.EthicsReviewDays" class="form-control" required />
                                    <span class="input-group-text">days</span>
                                </div>
                                <small class="form-hint">
                                    From the review landing on somebody. When it passes, the
                                    coordinator is told the time has gone and who has not acted.
                                </small>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="committee-days">Committee review</label>
                                <div class="input-group">
                                    <input id="committee-days" name="committeeReviewDays" type="number" min="0" max="365"
                                           value="@Model.Deadlines.CommitteeReviewDays" class="form-control" required />
                                    <span class="input-group-text">days</span>
                                </div>
                                <small class="form-hint">
                                    From the committee being assigned. When it passes, the
                                    coordinator is told which members have still not decided.
                                </small>
                            </div>

                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="supervisor-warning-days">Remind the supervisor</label>
                                <div class="input-group">
                                    <input id="supervisor-warning-days" name="supervisorResponseWarningDays"
                                           type="number" min="0" max="365"
                                           value="@Model.Deadlines.SupervisorResponseWarningDays" class="form-control" required />
                                    <span class="input-group-text">days before</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="ethics-warning-days">Remind whoever owes the review</label>
                                <div class="input-group">
                                    <input id="ethics-warning-days" name="ethicsReviewWarningDays"
                                           type="number" min="0" max="365"
                                           value="@Model.Deadlines.EthicsReviewWarningDays" class="form-control" required />
                                    <span class="input-group-text">days before</span>
                                </div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="committee-warning-days">Remind the committee</label>
                                <div class="input-group">
                                    <input id="committee-warning-days" name="committeeReviewWarningDays"
                                           type="number" min="0" max="365"
                                           value="@Model.Deadlines.CommitteeReviewWarningDays" class="form-control" required />
                                    <span class="input-group-text">days before</span>
                                </div>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Save deadlines</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            @* The three stages, in the order they run, each with the steps that belong to it. One
               card per stage rather than one long list: an administrator changing how papers are
               judged is not thinking about ethics documents at the same time. *@
            if (Model.ActiveTab == "pipeline")
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h3 mb-2">The research proposals stage</h2>
                        <p class="text-secondary">
                            The first stage, and always first: assigning a proposal is what names
                            the supervisor the two later stages wait on. How many a student writes
                            in one round, and whether supervisors are asked before a coordinator
                            appoints one.
                        </p>

                        <form asp-action="SaveProposals" method="post" class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="proposals-min">Fewest per round</label>
                                <input id="proposals-min" name="minimumPerRound" type="number" min="1" max="20"
                                       value="@Model.Proposals.MinimumPerRound" class="form-control" required />
                                <small class="form-hint">One means a student may send a single proposal.</small>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="proposals-max">Most per round</label>
                                <input id="proposals-max" name="maximumPerRound" type="number" min="1" max="20"
                                       value="@Model.Proposals.MaximumPerRound" class="form-control" required />
                                <small class="form-hint">The student's screen stops offering another beyond this.</small>
                            </div>

                            <div class="col-12">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="supervisorsExpressInterest"
                                           value="true" checked="@Model.Proposals.SupervisorsExpressInterest" />
                                    <input type="hidden" name="supervisorsExpressInterest" value="false" />
                                    <span class="form-check-label">Supervisors say which proposals they are willing to take on</span>
                                </label>
                                <small class="form-hint">
                                    On, the coordinator sends a student's proposals out and appoints
                                    a supervisor from those who offered. Off, Send proposals falls
                                    silent and the coordinator appoints any available supervisor to
                                    a proposal directly.
                                </small>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary"
                                        @DecisionButton.Attributes(false, null,
                                            "Change the research proposals stage? Rounds already open follow it too.")>
                                    Save
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h3 mb-2">The ethics approval stage</h2>
                        <p class="text-secondary">
                            Turning a step off takes it out of the sequence at once, including for
                            approvals already part way through, so nothing sits waiting on a step
                            that no longer exists.
                        </p>

                        <form asp-action="SaveEthicsWorkflow" method="post">
                            <h3 class="h4 mb-1">Who reads the ethics documentation, and in what order</h3>
                            <p class="text-secondary mb-3">
                                The student uploads, and the readings below happen in this order
                                before the coordinator closes the stage. Any of them can go, but not
                                all of them: something has to be read, so a sequence with no reader
                                left in it is refused.
                            </p>

                            @{ var coordinatorFirst = Model.EthicsWorkflow.DocumentReviewOrder == EthicsReviewOrder.CoordinatorFirst; }
                            <div class="mb-3">
                                <label class="form-label" for="review-order">Which of them reads first</label>
                                <select id="review-order" name="documentReviewOrder" class="form-select">
                                    <option value="@EthicsReviewOrder.SupervisorFirst" selected="@(!coordinatorFirst)">
                                        The supervisor, then the coordinator
                                    </option>
                                    <option value="@EthicsReviewOrder.CoordinatorFirst" selected="@coordinatorFirst">
                                        The coordinator, then the supervisor
                                    </option>
                                </select>
                                <small class="form-hint">
                                    Both read the same files, so either order works. Whichever comes
                                    second waits for the first, and a reading switched off below is
                                    simply not part of the sequence.
                                </small>
                            </div>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="supervisorReviewsDocuments"
                                       value="true" checked="@Model.EthicsWorkflow.SupervisorReviewsDocuments" />
                                <input type="hidden" name="supervisorReviewsDocuments" value="false" />
                                <span class="form-check-label">The supervisor reads them</span>
                            </label>
                            <small class="form-hint mb-3 d-block">
                                Off, an uploaded set goes straight to whoever reads next, and the
                                supervisor's ethics screen stops offering it.
                            </small>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="coordinatorReviewsDocuments"
                                       value="true" checked="@Model.EthicsWorkflow.CoordinatorReviewsDocuments" />
                                <input type="hidden" name="coordinatorReviewsDocuments" value="false" />
                                <span class="form-check-label">The coordinator reads them</span>
                            </label>
                            <small class="form-hint mb-4 d-block">
                                Off, the coordinator still closes the stage at the end; they simply
                                do not read the documents on the way through.
                            </small>

                            <h3 class="h4 mb-1">The Head of Department in the ethics stage</h3>
                            <p class="text-secondary mb-3">
                                Ethics reaches its close by two routes, and they are separate
                                questions. Reading a set of documents is work an institution may
                                want done once; agreeing that a piece of research needs no ethics
                                approval at all is a judgement a head of department may want sight
                                of precisely because there is nothing to read.
                            </p>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="headOfDepartmentReviews"
                                       value="true" checked="@Model.EthicsWorkflow.HeadOfDepartmentReviews" />
                                <input type="hidden" name="headOfDepartmentReviews" value="false" />
                                <span class="form-check-label">Reviews ethics documentation the coordinator has approved</span>
                            </label>
                            <small class="form-hint mb-3 d-block">
                                On, the Head of Department reads the documents the coordinator has
                                approved, comments on them and hands the approval back to the
                                coordinator, who then closes the stage. Off, the coordinator closes
                                it themselves as soon as they have approved the documents.
                            </small>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="headOfDepartmentReviewsWhenNotRequired"
                                       value="true" checked="@Model.EthicsWorkflow.HeadOfDepartmentReviewsWhenNotRequired" />
                                <input type="hidden" name="headOfDepartmentReviewsWhenNotRequired" value="false" />
                                <span class="form-check-label">Reviews a decision that no documentation is needed</span>
                            </label>
                            <small class="form-hint">
                                On, a coordinator who agrees with the supervisor that no ethics
                                documentation is needed passes that to the Head of Department to
                                comment on, and closes the stage afterwards. Off, their agreement
                                closes it there and then.
                            </small>

                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary"
                                        @DecisionButton.Attributes(false, null,
                                            "Change who the ethics stage passes through? Approvals already waiting move to whoever decides next.")>
                                    Save
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">The research paper stage</h2>
                        <p class="text-secondary">
                            The three readings a submitted paper can go through, in the order they
                            happen. Whichever is last is the one that accepts the paper, so a stage
                            with none of them left is refused: a paper would be submitted into
                            nothing.
                        </p>

                        <form asp-action="SavePaperWorkflow" method="post">
                            <div class="mb-3">
                                <label class="form-label" for="stage-order">Which stage comes first</label>
                                <select id="stage-order" name="ethicsBeforePaper" class="form-select">
                                    <option value="true" selected="@Model.PaperWorkflow.EthicsBeforePaper">
                                        Ethics approval, then the research paper
                                    </option>
                                    <option value="false" selected="@(!Model.PaperWorkflow.EthicsBeforePaper)">
                                        The research paper, then ethics approval
                                    </option>
                                </select>
                                <small class="form-hint">
                                    Research proposals stay first either way, because assigning one
                                    is what names the supervisor both later stages wait on. Second,
                                    ethics is settled after the paper is accepted and before it can
                                    be published.
                                </small>
                            </div>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="supervisorReviews"
                                       value="true" checked="@Model.PaperWorkflow.SupervisorReviews" />
                                <input type="hidden" name="supervisorReviews" value="false" />
                                <span class="form-check-label">The supervisor reads a submitted paper</span>
                            </label>
                            <small class="form-hint mb-3 d-block">
                                Off, a submitted paper goes straight to whatever follows, and the
                                supervisor's queue of papers stops offering it.
                            </small>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="committeeEvaluates"
                                       value="true" checked="@Model.PaperWorkflow.CommitteeEvaluates" />
                                <input type="hidden" name="committeeEvaluates" value="false" />
                                <span class="form-check-label">An evaluation committee judges it</span>
                            </label>
                            <small class="form-hint mb-3 d-block">
                                Off, no committee is appointed and Assign committees stops asking
                                for one.
                            </small>

                            <label class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="coordinatorDecides"
                                       value="true" checked="@Model.PaperWorkflow.CoordinatorDecides" />
                                <input type="hidden" name="coordinatorDecides" value="false" />
                                <span class="form-check-label">The coordinator makes the final decision</span>
                            </label>
                            <small class="form-hint">
                                Off, the reading before it accepts the paper: enough committee
                                approvals, or the supervisor's acceptance where there is no
                                committee either.
                            </small>

                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary"
                                        @DecisionButton.Attributes(false, null,
                                            "Change the readings a research paper goes through? Papers already under way move with it.")>
                                    Save
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "decisions")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Comments on decisions</h2>
                        <p class="text-secondary">
                            Every decision in the pipeline that carries a comment. Tick the ones
                            this institution wants a reason recorded against; leave the rest and a
                            comment is welcome but not asked for. Every decision is confirmed
                            before it goes through, whether or not it needs a reason.
                        </p>

                        <form asp-action="SaveDecisionComments" method="post">
                            @foreach (var stage in Model.DecisionComments.GroupBy(d => d.Stage))
                            {
                                <h3 class="h4 mt-4 mb-2">@stage.Key</h3>
                                <div class="row g-2">
                                    @foreach (var decision in stage)
                                    {
                                        <div class="col-12 col-lg-6">
                                            <label class="form-check">
                                                <input class="form-check-input" type="checkbox" name="required"
                                                       value="@decision.Key" checked="@decision.CommentRequired" />
                                                <span class="form-check-label">
                                                    @decision.Name
                                                    @if (decision.CommentRequired != decision.RequiredByDefault)
                                                    {
                                                        <span class="badge bg-blue-lt ms-1">changed</span>
                                                    }
                                                </span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "uploads")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Uploads</h2>
                        <p class="text-secondary">
                            Applies to research papers and ethics documents. Profile photos have
                            their own limits, and widening this does not let someone upload an image
                            as a research paper.
                        </p>

                        <form asp-action="SaveUploads" method="post" class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="max-megabytes">Largest file</label>
                                <div class="input-group">
                                    <input id="max-megabytes" name="maxMegabytes" type="number" min="1" max="200"
                                           value="@Model.Uploads.MaxMegabytes" class="form-control" required />
                                    <span class="input-group-text">MB</span>
                                </div>
                                <small class="form-hint">Up to 200 MB, which is the server's own ceiling.</small>
                            </div>
                            <div class="col-12 col-sm-8">
                                <label class="form-label" for="allowed-extensions">File types allowed</label>
                                <input id="allowed-extensions" name="allowedExtensions"
                                       value="@Model.Uploads.AllowedExtensions" class="form-control" required />
                                <small class="form-hint">Separated by commas. The full stops are optional, so "pdf, docx" is fine.</small>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Save upload rules</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "messaging")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Writing to each other</h2>
                        <p class="text-secondary">
                            A student writes to the supervisor they were assigned, the coordinator
                            running their publication and the head of their department. Whoever is
                            working on a publication writes to the student. It happens on the
                            publication, so what was asked and answered stays with the research
                            rather than in somebody's mailbox.
                        </p>

                        <form asp-action="SaveMessaging" method="post" class="row g-3">

                            <div class="col-12">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="enabled" value="true"
                                           checked="@Model.Messaging.Enabled" />
                                    @* Paired with the box, as the other switches on this screen are:
                                       an unticked checkbox posts nothing at all, and without this the
                                       binder would see silence rather than false. *@
                                    <input type="hidden" name="enabled" value="false" />
                                    <span class="form-check-label">Let people write to each other through a publication</span>
                                </label>
                                <small class="form-hint">
                                    Off hides the screen and refuses new messages. Nothing already
                                    written is removed: somebody may have been relying on it.
                                </small>
                            </div>

                            <div class="col-12">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="recordedInActivityHistory"
                                           value="true" checked="@Model.Messaging.RecordedInActivityHistory" />
                                    <input type="hidden" name="recordedInActivityHistory" value="false" />
                                    <span class="form-check-label">Note these contacts in the publication's activity history</span>
                                </label>
                                <small class="form-hint">
                                    Records that somebody wrote to somebody, and when. Never what was
                                    said. Off unless you want it: the activity history is read by
                                    everybody with access to the publication, so this tells a
                                    coordinator and a head of department that a student wrote to
                                    their supervisor.
                                </small>
                            </div>

                            <hr class="my-1" />

                            @* Who may write to whom. Two directions, each with its own switch and
                               its own list, because an institution that wants staff to be able to
                               reach a student does not thereby want every student writing to a
                               committee that is judging their paper. *@
                            <div class="col-12 col-lg-6">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="studentsMayWrite"
                                           value="true" checked="@Model.Messaging.StudentsMayWrite" />
                                    <input type="hidden" name="studentsMayWrite" value="false" />
                                    <span class="form-check-label fw-bold">A student may write</span>
                                </label>
                                <small class="form-hint mb-2 d-block">
                                    Off, a student can neither start a conversation nor answer one.
                                </small>

                                @foreach (var role in Model.Messaging.SelectableStudentRoles)
                                {
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" name="studentMayWriteToRoles"
                                               value="@role"
                                               checked="@Model.Messaging.StudentMayWriteToRoles.Contains(role)" />
                                        <span class="form-check-label">@DisplayText.Humanise(role)</span>
                                    </label>
                                }

                                <small class="form-hint">
                                    Whichever of these hold a post on the student's own publication:
                                    the supervisor assigned to it, the coordinator running it, the
                                    head of their department, and the committee appointed to judge
                                    the paper. Nothing ticked means nobody. Administrators are not
                                    on this list because no administrator is attached to a
                                    publication, so it would mean all of them at once.
                                </small>
                            </div>

                            <div class="col-12 col-lg-6">
                                <label class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="staffMayWrite"
                                           value="true" checked="@Model.Messaging.StaffMayWrite" />
                                    <input type="hidden" name="staffMayWrite" value="false" />
                                    <span class="form-check-label fw-bold">Staff may write to a student</span>
                                </label>
                                <small class="form-hint mb-2 d-block">
                                    Off, nobody working on a publication can write to the student.
                                </small>

                                @foreach (var role in Model.Messaging.SelectableStaffRoles)
                                {
                                    <label class="form-check">
                                        <input class="form-check-input" type="checkbox" name="staffMayWriteToStudentRoles"
                                               value="@role"
                                               checked="@Model.Messaging.StaffMayWriteToStudentRoles.Contains(role)" />
                                        <span class="form-check-label">@DisplayText.Humanise(role)</span>
                                    </label>
                                }

                                <small class="form-hint">
                                    Only counts where they are actually on the publication. Nothing
                                    ticked means nobody.
                                </small>
                            </div>

                            <div class="col-12">
                                <p class="text-secondary small m-0">
                                    Narrowing a list stops new conversations; it does not silence one
                                    already under way, so nobody is left holding a message they
                                    cannot answer. Switching a direction off does silence it.
                                </p>
                            </div>

                            <hr class="my-1" />

                            <div class="col-12">
                                <label class="form-label" for="messaging-extensions">File types a message may carry</label>
                                <input id="messaging-extensions" name="allowedExtensions"
                                       value="@Model.Messaging.AllowedExtensions" class="form-control" required />
                                <small class="form-hint">
                                    Separated by commas; the full stops are optional. Its own list,
                                    not the one under Uploads: a question usually arrives with a
                                    screenshot, and allowing an image here should not allow one to
                                    be submitted as a research paper.
                                </small>
                            </div>

                            <div class="col-12">
                                <p class="text-secondary small">
                                    A message can be up to @Model.Messaging.MaximumLength characters
                                    and carry @Model.Messaging.MaximumAttachments files. Those two are
                                    fixed.
                                </p>
                                <button type="submit" class="btn btn-primary">Save message rules</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "storage")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Where uploaded files are kept</h2>
                        <p class="text-secondary">
                            Ethics documents, research paper versions and profile photos. Changing
                            this points the next upload somewhere else and nothing more: every file
                            already stored remembers where it was written and keeps opening from
                            there, so there is no migration to run and no moment when downloads stop
                            working.
                        </p>

                        <div class="alert alert-info d-flex flex-wrap align-items-center gap-2" role="status">
                            <span class="me-auto">
                                New uploads go to <strong>@Model.Storage.ProviderName</strong>.
                            </span>
                            @* Its own form so testing never saves anything: an administrator can
                               check what is in force without committing to a change they are still
                               typing. *@
                            <form asp-action="CheckStorage" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Test this destination</button>
                            </form>
                        </div>

                        <form asp-action="SaveStorage" method="post">
                            <div class="mb-4">
                                <label class="form-label" for="storage-provider">Destination</label>
                                <select id="storage-provider" name="provider" class="form-select"
                                        data-rpms-storage-provider>
                                    <option value="local" selected="@Model.Storage.IsLocal">
                                        A directory on the server, or a network share
                                    </option>
                                    <option value="database" selected="@Model.Storage.IsDatabase">
                                        The database
                                    </option>
                                    <option value="s3" selected="@Model.Storage.IsS3">
                                        S3, or anything compatible with it
                                    </option>
                                    <option value="azure-blob" selected="@Model.Storage.IsAzure">
                                        Azure Blob Storage
                                    </option>
                                </select>
                            </div>

                            <div data-rpms-storage-panel="local">
                                <div class="mb-3">
                                    <label class="form-label" for="storage-local-path">Directory</label>
                                    <input id="storage-local-path" name="localPath" class="form-control"
                                           value="@Model.Storage.LocalPath" />
                                    <small class="form-hint">
                                        Absolute, or relative to the application. A network share is
                                        this pointed at a mounted path or a UNC path, which is the
                                        whole of the difference: whatever mounts it has to be there
                                        before the application starts.
                                    </small>
                                </div>
                            </div>

                            <div data-rpms-storage-panel="database">
                                <p class="text-secondary">
                                    Nothing to configure. Files become rows in the same database as
                                    everything else, so one backup covers both and there is no share
                                    to mount or key to rotate. It grows the database with every
                                    upload, which suits a department rather than an archive.
                                </p>
                            </div>

                            <div data-rpms-storage-panel="s3">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="s3-bucket">Bucket</label>
                                        <input id="s3-bucket" name="s3Bucket" class="form-control"
                                               value="@Model.Storage.S3Bucket" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="s3-region">Region</label>
                                        <input id="s3-region" name="s3Region" class="form-control"
                                               placeholder="ap-southeast-2" value="@Model.Storage.S3Region" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="s3-service-url">Service URL</label>
                                        <input id="s3-service-url" name="s3ServiceUrl" class="form-control"
                                               placeholder="Leave empty for Amazon" value="@Model.Storage.S3ServiceUrl" />
                                        <small class="form-hint">
                                            Set this to reach anything else that speaks S3: MinIO,
                                            Wasabi, Backblaze, DigitalOcean Spaces.
                                        </small>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="s3-access-key">Access key ID</label>
                                        <input id="s3-access-key" name="s3AccessKeyId" class="form-control"
                                               value="@Model.Storage.S3AccessKeyId" />
                                        <small class="form-hint">
                                            Leave both key boxes empty to use the machine's own
                                            credentials, which is how a deployment inside AWS should
                                            be set up.
                                        </small>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="s3-secret-key">Secret key</label>
                                        <input id="s3-secret-key" name="s3SecretKey" type="password"
                                               class="form-control" autocomplete="new-password"
                                               placeholder="@(Model.Storage.S3SecretKeySet ? "Stored. Leave empty to keep it." : "Not set")" />
                                        <small class="form-hint">
                                            Never shown again once saved. An empty box leaves the
                                            stored one alone.
                                        </small>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-check">
                                            <input class="form-check-input" type="checkbox" name="s3ForcePathStyle"
                                                   value="true" checked="@Model.Storage.S3ForcePathStyle" />
                                            <span class="form-check-label">
                                                Put the bucket in the path rather than the hostname
                                            </span>
                                        </label>
                                        <small class="form-hint">
                                            Needed by most S3-compatible services that are not
                                            Amazon. Harmless on Amazon.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div data-rpms-storage-panel="azure-blob">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="azure-container">Container</label>
                                        <input id="azure-container" name="azureContainer" class="form-control"
                                               value="@Model.Storage.AzureContainer" />
                                        <small class="form-hint">Created private if it is not there already.</small>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label" for="azure-connection">Connection string</label>
                                        <input id="azure-connection" name="azureConnectionString" type="password"
                                               class="form-control" autocomplete="new-password"
                                               placeholder="@(Model.Storage.AzureConnectionStringSet ? "Stored. Leave empty to keep it." : "Not set")" />
                                        <small class="form-hint">
                                            Carries its own key, so it is never shown again once
                                            saved. An empty box leaves the stored one alone.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            @* Off unless asked. Changing the destination has never touched what is
                               already stored, and it should not start now: leaving them costs
                               nothing, and copying hundreds of files is a decision rather than a
                               side effect of pressing Save. *@
                            <div class="mt-4 pt-3 border-top">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="copyExisting" value="true" />
                                    <span class="form-check-label">
                                        Also copy the files already stored to the new destination
                                    </span>
                                </label>
                                <small class="form-hint">
                                    Their records are repointed as each one arrives, so nothing stops
                                    working part way through. The originals are left where they are,
                                    because reclaiming that space is a decision with no undo.
                                </small>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Save where files go</button>
                            </div>
                        </form>

                        @if (Model.Storage.FilesElsewhere > 0)
                        {
                            @* Shown only when there is something to copy, and saying how much: a
                               button offering to move nothing is a button that teaches somebody to
                               ignore it. A run is bounded so the page answers, hence "again". *@
                            <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 mt-4 mb-0"
                                 role="status">
                                <span class="me-auto">
                                    <strong>@Model.Storage.FilesElsewhere</strong>
                                    @(Model.Storage.FilesElsewhere == 1 ? "file is" : "files are") still stored
                                    somewhere other than @Model.Storage.ProviderName.
                                    @(Model.Storage.FilesElsewhere == 1 ? "It opens" : "They open") perfectly well
                                    from where @(Model.Storage.FilesElsewhere == 1 ? "it is" : "they are").
                                </span>
                                <form asp-action="CopyExistingFiles" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-warning"
                                            data-rpms-confirm="Copy the files stored elsewhere to the destination in force? The originals are left where they are.">
                                        Copy them here
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }

            if (Model.ActiveTab == "access")
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h2 class="h3 mb-2">How people get an account</h2>

                        @if (Model.Access.IsEnvironmentDefault)
                        {
                            <p class="text-secondary">
                                Nobody has chosen yet, so this is following the environment this
                                server runs in.
                            </p>
                        }

                        <form asp-action="SaveAccess" method="post">
                            <div class="mb-3">
                                <label class="form-check">
                                    <input class="form-check-input" type="radio" name="registrationMode" value="InviteOnly"
                                           checked="@(Model.Access.RegistrationMode != "Open")" />
                                    <span class="form-check-label">
                                        By invitation only
                                        <span class="d-block text-secondary small">
                                            An administrator invites each person and chooses their role as they do.
                                        </span>
                                    </span>
                                </label>

                                <label class="form-check">
                                    <input class="form-check-input" type="radio" name="registrationMode" value="Open"
                                           checked="@(Model.Access.RegistrationMode == "Open")"
                                           disabled="@(!Model.CanOpenRegistration)" />
                                    <span class="form-check-label">
                                        Anyone with an institutional address can sign themselves up
                                        <span class="d-block text-secondary small">
                                            @if (Model.CanOpenRegistration)
                                            {
                                                <span>
                                                    Available because this is a development environment. A production
                                                    deployment cannot use it. It would hand out accounts to anyone who
                                                    guessed the email domain.
                                                </span>
                                            }
                                            else
                                            {
                                                <span>Not available outside a development environment.</span>
                                            }
                                        </span>
                                    </span>
                                </label>
                            </div>

                            <hr class="my-4" />

                            <h3 class="h4 mb-2">The public catalogue</h3>
                            <label class="form-check form-switch mb-1">
                                <input class="form-check-input" type="checkbox" name="publicCatalogueEnabled" value="true"
                                       checked="@Model.Access.PublicCatalogueEnabled" />
                                <input type="hidden" name="publicCatalogueEnabled" value="false" />
                                <span class="form-check-label">Show published research to people without an account</span>
                            </label>
                            <p class="text-secondary small">
                                @if (Model.Access.PublicCatalogueEnabled)
                                {
                                    <span>
                                        The catalogue is the site's landing page: a visitor arriving at the address
                                        sees the published research first, and signs in from the header.
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        The site has no public face. A visitor arriving at the address is shown the
                                        sign-in page, and the catalogue is not served to anyone without an account.
                                    </span>
                                }
                                Signed in, everyone keeps the catalogue either way. This governs what the world
                                sees, not what the institution can see of its own published work. Full texts are
                                never public, whatever this is set to.
                            </p>

                            <hr class="my-4" />

                            <h3 class="h4 mb-2">Single sign-on</h3>
                            <label class="form-check form-switch mb-1">
                                <input class="form-check-input" type="checkbox" name="azureSsoEnabled" value="true"
                                       checked="@Model.Access.AzureSsoEnabled" />
                                <input type="hidden" name="azureSsoEnabled" value="false" />
                                <span class="form-check-label">Staff and students sign in with their institutional account</span>
                            </label>
                            <p class="text-secondary small">
                                @if (Model.Access.AzureSsoConfigured)
                                {
                                    <span>A Microsoft Entra tenant is configured on this server.</span>
                                }
                                else
                                {
                                    <span>
                                        No Microsoft Entra tenant is configured on this server yet, so turning this
                                        on records the intention but changes nothing until one is.
                                    </span>
                                }
                                External committee members are outside the institution and always sign in
                                with a password here, whatever this is set to.
                            </p>

                            <hr class="my-4" />

                            <div class="row g-3">
                                <div class="col-12 col-sm-4">
                                    <label class="form-label" for="invitation-days">Invitations stay valid for</label>
                                    <div class="input-group">
                                        <input id="invitation-days" name="invitationValidDays" type="number" min="1" max="90"
                                               value="@Model.Access.InvitationValidDays" class="form-control" required />
                                        <span class="input-group-text">days</span>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label" for="access-minutes">Access token lasts</label>
                                    <div class="input-group">
                                        <input id="access-minutes" name="accessTokenMinutes" type="number" min="5" max="240"
                                               value="@Model.Access.AccessTokenMinutes" class="form-control" required />
                                        <span class="input-group-text">min</span>
                                    </div>
                                    <small class="form-hint">Short on purpose: it cannot be withdrawn before it expires.</small>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label" for="refresh-days">Signed in for</label>
                                    <div class="input-group">
                                        <input id="refresh-days" name="refreshTokenDays" type="number" min="1" max="90"
                                               value="@Model.Access.RefreshTokenDays" class="form-control" required />
                                        <span class="input-group-text">days</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Save access rules</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">Invitations</h2>
                        <p class="text-secondary">
                            Invite anyone, to any role, including people with no institutional
                            address, which is the only way an external committee member can ever
                            get in.
                        </p>
                        <a asp-controller="Invitations" asp-action="Index" class="btn btn-outline-primary">
                            Manage invitations
                        </a>
                    </div>
                </div>
            }

            if (Model.ActiveTab == "institution")
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h3 mb-2">The institution</h2>
                        <p class="text-secondary">
                            The email domains decide what someone is when they register or arrive
                            from single sign-on, so changing one changes who can sign up as what.
                        </p>

                        <form asp-action="SaveInstitution" method="post" class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="institution-name">Name</label>
                                <input id="institution-name" name="name" value="@Model.Institution.Name"
                                       class="form-control" required />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="student-domain">Student email domain</label>
                                <input id="student-domain" name="studentEmailDomain"
                                       value="@Model.Institution.StudentEmailDomain" class="form-control" required />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="staff-domain">Staff email domain</label>
                                <input id="staff-domain" name="staffEmailDomain"
                                       value="@Model.Institution.StaffEmailDomain" class="form-control" required />
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="it-email">IT support address</label>
                                <input id="it-email" name="itSupportEmail" type="email"
                                       value="@Model.Institution.ItSupportEmail" class="form-control" />
                                <small class="form-hint">Shown as plain text while blank, never as a dead link.</small>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="enquiries-email">Research enquiries address</label>
                                <input id="enquiries-email" name="researchEnquiriesEmail" type="email"
                                       value="@Model.Institution.ResearchEnquiriesEmail" class="form-control" />
                                <small class="form-hint">
                                    Where the public writes for a paper's full text. Research is not
                                    downloadable from the catalogue, so this is the whole of that route.
                                </small>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="privacy-url">Privacy policy address</label>
                                <input id="privacy-url" name="privacyPolicyUrl" type="url"
                                       value="@Model.Institution.PrivacyPolicyUrl" class="form-control"
                                       placeholder="https://www.ais.ac.nz/privacy-policy" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="website-url">Institution website</label>
                                <input id="website-url" name="websiteUrl" type="url"
                                       value="@Model.Institution.WebsiteUrl" class="form-control"
                                       placeholder="https://www.ais.ac.nz" />
                                <small class="form-hint">
                                    Where a member of the public is sent for contact details when no
                                    research enquiries address has been published.
                                </small>
                            </div>

                            @* Checkbox plus a hidden false of the same name: an unchecked box posts
                               nothing at all, so without it clearing the switch would look exactly
                               like not touching it. Same pattern as the switches on the other
                               tabs. *@
                            <div class="col-12">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="itSupportShownToVisitors" value="true"
                                           checked="@Model.Institution.ItSupportShownToVisitors" />
                                    <input type="hidden" name="itSupportShownToVisitors" value="false" />
                                    <span class="form-check-label">Offer the IT desk to people with no account</span>
                                </label>
                                <small class="form-hint">
                                    Signed-in students and staff are always shown it. Ticked, the
                                    sign-in page and the public catalogue offer it as well. It starts
                                    off: a university IT desk supports its own people, and an address
                                    on a page open to the world will be scraped.
                                </small>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Save institution details</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }

    </div>
</div>
