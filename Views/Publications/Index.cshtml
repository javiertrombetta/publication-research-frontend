@model ResearchPublicationManagementSystem.Models.PublicationListViewModel
@using ResearchPublicationManagementSystem.Models

@{
    ViewData["Title"] = "Publication Management";
}

<partial name="_PageHeader"
         model='new PageHeaderViewModel
         {
             Title = "Publication Management",
             Subtitle = "Monitor and manage submitted publications."
         }' />

<!-- Statistics -->

<div class="row">

    <div class="col-lg-3 col-md-6 mb-3">

        <partial name="_StatisticCard"
                 model='new StatisticCardViewModel
                 {
                     Title = "Total Publications",
                     Value = Model.TotalPublications,
                     ColorClass = "text-primary",
                     Icon = "book",
                     IconBackground = "bg-primary-lt"
                 }' />

    </div>

    <div class="col-lg-3 col-md-6 mb-3">

        <partial name="_StatisticCard"
                 model='new StatisticCardViewModel
                 {
                     Title = "Pending Committee Assignment",
                     Value = Model.PendingCommitteeAssignment,
                     ColorClass = "text-warning",
                     Icon = "users-group",
                     IconBackground = "bg-warning-lt"
                 }' />

    </div>

    <div class="col-lg-3 col-md-6 mb-3">

        <partial name="_StatisticCard"
                 model='new StatisticCardViewModel
                 {
                     Title = "Under Review",
                     Value = Model.UnderReview,
                     ColorClass = "text-info",
                     Icon = "clock",
                     IconBackground = "bg-info-lt"
                 }' />

    </div>

    <div class="col-lg-3 col-md-6 mb-3">

        <partial name="_StatisticCard"
                 model='new StatisticCardViewModel
                 {
                     Title = "Approved",
                     Value = Model.Approved,
                     ColorClass = "text-success",
                     Icon = "circle-check",
                     IconBackground = "bg-success-lt"
                 }' />

    </div>

</div>

<!-- Search Toolbar -->

<partial name="_SearchFilterToolbar"
         model="Model.Toolbar" />

<!-- Publication Table -->

<div class="card mt-3">

    <div class="card-body">

        <partial name="_PublicationTable"
                 model="Model.Publications" />

    </div>

    <div class="card-footer">

        <partial name="_Pagination" />

    </div>

</div>