@model ResearchPublicationManagementSystem.Models.PublicationDetailsViewModel

@{
    ViewData["Title"] = "Publication Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    @await Html.PartialAsync("_PageHeader",
    new PageHeaderViewModel
    {
        Title = "Publication Details",
        Subtitle = "View publication information, workflow, committee reviews and history."
    })

    <!-- Publication Summary -->
    <div class="card detail-card mt-4">
        <div class="card-body">

            <div class="row">

                <div class="col-lg-9">

                    <h3 class="fw-bold mb-3">
                        @Model.Title
                    </h3>

                </div>

                <div class="col-lg-3 text-lg-end">

                    <span class="badge bg-success text-white px-3 py-2">
                        @Model.Status
                    </span>

                </div>

            </div>

            <hr />

            <div class="row g-3">

                <div class="col-md-3">

                    <div class="text-muted small">
                        Publication ID
                    </div>

                    <div class="fw-semibold">
                        @Model.PublicationId
                    </div>

                </div>

                <div class="col-md-3">

                    <div class="text-muted small">
                        Version
                    </div>

                    <div class="fw-semibold">
                        @Model.Version
                    </div>

                </div>

                <div class="col-md-3">

                    <div class="text-muted small">
                        Submitted Date
                    </div>

                    <div class="fw-semibold">
                        @Model.SubmittedDate.ToString("dd MMM yyyy")
                    </div>

                </div>

                <div class="col-md-3">

                    <div class="text-muted small">
                        Last Updated
                    </div>

                    <div class="fw-semibold">
                        @Model.LastUpdated.ToString("dd MMM yyyy")
                    </div>

                </div>

            </div>

        </div>
    </div>
    <!-- Publication Information -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Publication Information
            </h5>

            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Student ID</div>
                    <div class="detail-value">@Model.StudentId</div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Student Name</div>
                    <div class="detail-value">@Model.StudentName</div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Student Email</div>
                    <div class="detail-value">@Model.StudentEmail</div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Supervisor</div>
                    <div class="detail-value">@Model.SupervisorName</div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Research Category</div>
                    <div class="detail-value">@Model.ResearchCategory</div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Related Proposal</div>
                    <div class="detail-value">@Model.RelatedProposalId</div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="detail-label">Committee</div>
                    <div class="detail-value">@Model.CommitteeName</div>
                </div>

            </div>

        </div>

    </div>
    <!-- ==========================================
         Publication Abstract
    =========================================== -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Publication Abstract
            </h5>

            <div class="detail-value">

                @Model.Abstract

            </div>

        </div>

    </div>
    <!-- ==========================================
         Committee Members
    =========================================== -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Committee Members
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:70px;">#</th>

                            <th>Name</th>

                            <th>Role</th>

                            <th>Status</th>

                            <th>Recommendation</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var member in Model.CommitteeMembers)
                        {
                            <tr>

                                <td>@member.Id</td>

                                <td>@member.MemberName</td>

                                <td>@member.CommitteeRole</td>

                                <td>

                                    @if (member.ReviewStatus == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td>@member.Recommendation</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
    <!-- ==========================================
         Committee Reviews
    =========================================== -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Committee Reviews
            </h5>

            @foreach (var review in Model.CommitteeReviews)
            {
                <div class="card border mb-3">

                    <div class="card-body">

                        <div class="row mb-3">

                            <div class="col-md-6">

                                <div class="detail-label">
                                    Reviewer
                                </div>

                                <div class="detail-value">
                                    @review.ReviewerName
                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="detail-label">
                                    Reviewed On
                                </div>

                                <div class="detail-value">
                                    @review.ReviewDate.ToString("dd MMM yyyy")
                                </div>

                            </div>

                            <div class="col-md-6 mt-3">

                                <div class="detail-label">
                                    Committee Role
                                </div>

                                <div class="detail-value">
                                    @review.CommitteeRole
                                </div>

                            </div>

                        </div>
                   

                        <hr />


                        <div class="mb-3">

                            <span class="fw-semibold">
                                Recommendation:
                            </span>

                            <span class="badge bg-success ms-2">
                                @review.Recommendation
                            </span>

                        </div>

                        <div>

                            <span class="fw-semibold">
                                Comments:
                            </span>

                            @review.Comments

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
    <!-- ==========================================
         Publication Workflow
    =========================================== -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Publication Workflow
            </h5>

            <div class="workflow-container">

                @foreach (var step in Model.Workflow)
                {
                    <div class="workflow-item">

                        <div class="workflow-icon">

                            @if (step.IsCompleted)
                            {
                                <span class="badge bg-success rounded-circle workflow-badge">
                                    ✓
                                </span>
                            }
                            else if (step.IsCurrentStep)
                            {
                                <span class="badge bg-primary rounded-circle workflow-badge">
                                    ●
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary rounded-circle workflow-badge">
                                    ○
                                </span>
                            }

                        </div>

                        <div class="workflow-content">

                            <div class="fw-semibold">
                                @step.StepName
                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>
    <!-- ==========================================
         Publication History
    =========================================== -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Publication History
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Version</th>
                            <th>Date</th>
                            <th>Updated By</th>
                            <th>Description</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.History)
                        {
                            <tr>

                                <td>@item.Version</td>

                                <td>@item.Date.ToString("dd MMM yyyy")</td>

                                <td>@item.UpdatedBy</td>

                                <td>@item.Description</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
    <!-- ==========================================
         Activity Log
    =========================================== -->

    <div class="card detail-card">

        <div class="card-body">

            <h5 class="detail-section-title">
                Activity Log
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th style="width:180px;">Date</th>
                            <th>Activity</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var log in Model.ActivityLogs.OrderByDescending(x => x.ActivityDate))
                        {
                            <tr>

                                <td>
                                    @log.ActivityDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @log.Description
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
    <!-- ==========================================
         Action Buttons
    =========================================== -->

    <div class="d-flex justify-content-between mt-4 mb-3">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Publications

        </a>

        @if (Model.Status == "Approved")
        {
            <a asp-controller="Public"
               asp-action="published_detail"
               class="btn btn-success">

                <i class="bi bi-eye"></i>
                View Published Publication

            </a>
        }

    </div>

</div>