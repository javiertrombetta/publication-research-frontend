@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model SupervisorDashboardViewModel
@{
    ViewData["Title"] = "Supervisor dashboard";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Supervisor dashboard</h1>
    <div class="text-secondary">
        @(Model.ActionsWaiting == 0
            ? "Nothing is waiting on you right now."
            : Model.ActionsWaiting == 1
                ? "One decision is waiting on you."
                : $"{Model.ActionsWaiting} decisions are waiting on you.")
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your work</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    <div class="row row-cards mb-4">

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 @(Model.InvitedProposals.Count > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Proposals sent to you</div>
                    <div class="h1 m-0">@Model.InvitedProposals.Count</div>
                    @if (Model.InvitedProposals.Count > 0)
                    {
                        <a asp-controller="Supervisor" asp-action="proposal_review" class="btn btn-primary btn-sm mt-3">
                            Review them
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 @(Model.EthicsAwaitingDecision.Count > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Ethics declarations</div>
                    <div class="h1 m-0">@Model.EthicsAwaitingDecision.Count</div>
                    <div class="text-secondary">awaiting your ruling</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 @(Model.EthicsAwaitingReview.Count > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Ethics documents</div>
                    <div class="h1 m-0">@Model.EthicsAwaitingReview.Count</div>
                    <div class="text-secondary">awaiting your check</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 @(Model.PapersAwaitingReview.Count > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Research papers</div>
                    <div class="h1 m-0">@Model.PapersAwaitingReview.Count</div>
                    @if (Model.PapersAwaitingReview.Count > 0)
                    {
                        <a asp-controller="Supervisor" asp-action="publication_review" class="btn btn-primary btn-sm mt-3">
                            Review them
                        </a>
                    }
                </div>
            </div>
        </div>

    </div>

    @if (Model.Supervising.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">You aren't supervising anything yet</h3>
                <p class="text-secondary m-0">
                    Publications appear here once a coordinator assigns you to one.
                </p>
            </div>
        </div>
    }
    else
    {
        <h2 class="h3 mb-2">Publications you supervise</h2>
        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Publication</th>
                            <th>Ethics</th>
                            <th>Waiting on you</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var publication in Model.Supervising)
                        {
                            <tr>
                                <td>@publication.StudentName</td>
                                <td>@publication.DisplayTitle</td>
                                <td>
                                    @if (publication.EthicsStatus is null)
                                    {
                                        <span class="text-secondary">Not declared yet</span>
                                    }
                                    else
                                    {
                                        <span class="badge @StatusBadge(publication.EthicsStatus)">
                                            @Humanise(publication.EthicsStatus)
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (publication.EthicsStatus == EthicsStatus.PendingSupervisorDecision)
                                    {
                                        <a asp-controller="Supervisor" asp-action="Review_Ethic_assessmentchecklist"
                                           asp-route-id="@publication.Id" class="btn btn-sm btn-primary">
                                            Decide on ethics
                                        </a>
                                    }
                                    @* Whose turn it is, not the status: PendingVerification also
                                       covers documents this supervisor has already passed on. *@
                                    else if (publication.EthicsAwaitingRole == RoleNames.Supervisor)
                                    {
                                        <a asp-controller="Supervisor" asp-action="Ethic_document_review"
                                           asp-route-id="@publication.Id" class="btn btn-sm btn-primary">
                                            Check documents
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
