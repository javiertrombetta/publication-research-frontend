@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model SupervisorDashboardViewModel
@{
    ViewData["Title"] = "Supervisor dashboard";

    string StageLabel(int stage) => stage switch
    {
        PipelineStage.ResearchProposals => "Research proposals",
        PipelineStage.EthicsApproval => "Ethics approval",
        PipelineStage.ResearchPaper => "Research paper",
        _ => "—"
    };

    // Where a row sends the supervisor, when it is theirs to act on. Read off the listing itself,
    // so no extra request is made to work out whose turn it is.
    (string Action, string Label)? ActionFor(PublicationContainerDto c)
    {
        if (c.EthicsAwaitingRole == RoleNames.Supervisor)
        {
            return ("Review_Ethic_assessmentchecklist",
                c.EthicsAwaitingStep == EthicsSteps.SupervisorDecision ? "Rule on ethics" : "Check documents");
        }

        if (c.PaperAwaitingRole == RoleNames.Supervisor) return ("publication_review", "Review the paper");

        return null;
    }
}

<div class="mb-4">
    <h1 class="page-title mb-1">Supervisor dashboard</h1>
    <div class="text-secondary">
        What is waiting on you, and the publications you supervise.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your publications</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    @* Three cards, one per stage a supervisor takes part in. Each states how much is waiting and
       opens the queue that holds it; the listing underneath says which publication each piece
       belongs to. *@
    <div class="row row-cards mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.ProposalsToReviewTotal > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Proposals</div>
                    <div class="h1 m-0">@Model.ProposalsToReviewTotal</div>
                    <div class="text-secondary">
                        @(Model.ProposalsToReviewTotal == 1 ? "proposal to answer" : "proposals to answer")
                    </div>
                    @if (Model.ProposalsToReviewTotal > 0)
                    {
                        <a asp-controller="Supervisor" asp-action="proposal_review"
                           class="btn btn-primary btn-sm mt-3">Read the proposals</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.EthicsTotal > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Ethics</div>
                    <div class="h1 m-0">@Model.EthicsTotal</div>
                    <div class="text-secondary">
                        @(Model.EthicsTotal == 1 ? "decision waiting" : "decisions waiting")
                    </div>

                    @* The split named underneath, because a ruling and a document check are
                       different work even though they arrive in the same queue. *@
                    @if (Model.EthicsTotal > 0)
                    {
                        <div class="text-secondary small mt-1">
                            @Model.EthicsAwaitingRulingTotal to rule on,
                            @Model.EthicsAwaitingCheckTotal to check
                        </div>
                        <a asp-controller="Supervisor" asp-action="Ethic_reviews"
                           class="btn btn-primary btn-sm mt-3">Ethics reviews</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.PapersToReviewTotal > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Research papers</div>
                    <div class="h1 m-0">@Model.PapersToReviewTotal</div>
                    <div class="text-secondary">
                        @(Model.PapersToReviewTotal == 1 ? "paper to review" : "papers to review")
                    </div>
                    @if (Model.PapersToReviewTotal > 0)
                    {
                        <a asp-controller="Supervisor" asp-action="publication_review"
                           class="btn btn-primary btn-sm mt-3">Review the papers</a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.TotalCount == 0 && !Model.HasSearch)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">Nothing assigned to you yet</h3>
                <p class="text-secondary m-0">
                    Publications appear here once a coordinator assigns you to one.
                </p>
            </div>
        </div>
    }
    else
    {
        @* One search box, so a supervisor with sixty publications can find the one they are
           thinking of rather than paging to it. Applied by the API, like the ordering. *@
        <div class="card mb-3">
            <div class="card-body py-3">
                <form method="get" asp-controller="Supervisor" asp-action="SupervisorDashboard"
                      class="row g-2 align-items-center">

                    <input type="hidden" name="sort" value="@Model.Sort" />
                    <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                    <div class="col-12 col-md">
                        <input type="search" name="search" value="@Model.Search" class="form-control"
                               placeholder="Search by student or publication" aria-label="Search" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                    <div class="col-auto">
                        <a asp-controller="Supervisor" asp-action="SupervisorDashboard"
                           asp-all-route-data="Model.ClearSearchRoute()"
                           class="btn btn-outline-secondary">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Supervising.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h3 class="mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h3>
                    <p class="text-secondary mb-4">No publication you supervise has that student or title.</p>
                    <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="btn btn-primary">
                        Show them all
                    </a>
                </div>
            </div>
        }
        else
        {
            @* The count in a card of its own between the search and the listing, the way the
               coordinator's dashboard and the other queues state theirs. The total in bold because
               that is the figure being read; the page count is context for it rather than a second
               number of equal weight. Squeezed onto the end of the search row it was neither: too
               small to read as a figure and too far right to be seen with the list it counts. *@
            <div class="card mb-3">
                <div class="card-body py-3">
                    <span class="text-secondary">
                        <strong>@Model.TotalCount</strong>
                        @(Model.TotalCount == 1 ? "publication" : "publications") you supervise,
                        @Model.Supervising.Count on this page.
                    </span>
                </div>
            </div>

            <div class="card">
                <div class="table-responsive">
                    @{
                        // A real table, so the headings are where a reader expects to click.
                        // Ordering is the API's and covers every publication, not this page.
                        var byStudent = Model.Column("student", "Student");
                        var byStarted = Model.Column("started", "Publication", descendingFirst: true);
                        var byStage = Model.Column("stage", "Stage");
                        var byStatus = Model.Column("status", "Status");
                        // Ascending brings the ones needing this supervisor to the top, which is
                        // the question the column answers.
                        var byWaiting = Model.Column("waiting", "Waiting on you");
                    }
                    <table class="table card-table table-vcenter rpms-table-stable">
                        @* Declared once so the columns do not resize themselves around whichever
                           ten rows a sort happens to bring onto the page. *@
                        <colgroup>
                            <col style="width: 18%" />
                            <col style="width: 36%" />
                            <col style="width: 16%" />
                            <col style="width: 13%" />
                            <col style="width: 17%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th><partial name="_SortableHeader" model="byStudent" /></th>
                                <th><partial name="_SortableHeader" model="byStarted" /></th>
                                <th><partial name="_SortableHeader" model="byStage" /></th>
                                <th><partial name="_SortableHeader" model="byStatus" /></th>
                                <th><partial name="_SortableHeader" model="byWaiting" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var publication in Model.Supervising)
                            {
                                var action = ActionFor(publication);
                                <tr>
                                    <td>@publication.StudentName</td>
                                    <td>@publication.DisplayTitle</td>
                                    <td>@StageLabel(publication.CurrentPipeline)</td>
                                    <td>
                                        <span class="badge @StatusBadge(publication.DisplayStatus)">
                                            @Humanise(publication.DisplayStatus)
                                        </span>
                                    </td>
                                    <td>
                                        @if (action is null)
                                        {
                                            <span class="text-secondary">—</span>
                                        }
                                        else if (action.Value.Action == "Review_Ethic_assessmentchecklist")
                                        {
                                            @* Straight to the publication clicked. *@
                                            <a asp-controller="Supervisor" asp-action="@action.Value.Action"
                                               asp-route-id="@publication.Id"
                                               class="btn btn-sm btn-primary">@action.Value.Label</a>
                                        }
                                        else
                                        {
                                            @* The paper queue has no per-publication screen, so it
                                               arrives already searching for this row. *@
                                            <a asp-controller="Supervisor" asp-action="@action.Value.Action"
                                               asp-route-search="@publication.StudentName"
                                               class="btn btn-sm btn-primary">@action.Value.Label</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.Pager is not null)
            {
                <partial name="_Pager" model="Model.Pager" />
            }
        }
    }
}
