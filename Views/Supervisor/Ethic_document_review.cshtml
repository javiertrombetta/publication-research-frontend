@model SupervisorEthicsViewModel
@{
    ViewData["Title"] = "Ethics documents";
    var container = Model.Container;
}

<div class="mb-4">
    @* Back to the queue this was opened from, not to the dashboard. Ethics reviews is where the
       next one is, and the dashboard is a detour on the way to it. *@
    <a asp-controller="Supervisor" asp-action="Ethic_reviews" class="text-secondary text-decoration-none small">
        &larr; Ethics reviews
    </a>
    <h1 class="page-title mt-2 mb-1">Ethics documents</h1>
    <div class="text-secondary">@container.DisplayTitle &middot; @container.StudentName</div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h3 mb-3">Uploaded by the student</h2>

        @if (Model.Documents.Count == 0)
        {
            <p class="text-secondary m-0">Nothing has been uploaded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>File</th>
                            <th>Uploaded</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in Model.Documents)
                        {
                            <tr>
                                <td>@Humanise(document.DocumentType)</td>
                                <td>@document.FileName</td>
                                <td>@document.UploadedAt.ToLocalTime().ToString("dd MMM yyyy 'at' HH:mm")</td>
                                <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>
                                <td class="text-end">
                                    @* Accepting a document you cannot read is not a review. Every
                                       other screen that lists these has offered the file; this one
                                       printed the name and left the supervisor to guess. *@
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-controller="Downloads" asp-action="EthicsDocument"
                                       asp-route-containerId="@container.Id"
                                       asp-route-documentId="@document.Id">Download</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (!Model.NeedsDocumentReview)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing to review here</h3>
            <p class="text-secondary mb-4">
                These documents aren't waiting on you at the moment.
            </p>
            <a asp-controller="Supervisor" asp-action="Ethic_reviews" class="btn btn-primary">Back to ethics reviews</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h2 class="h3 mb-2">Your review</h2>
            <p class="text-secondary">
                Accepting sends the documents on to the coordinator. Sending them back returns them
                to the student, so say what needs changing.
            </p>

            <form asp-controller="Supervisor" asp-action="SubmitDocumentReview" method="post">
                <input type="hidden" name="id" value="@container.Id" />

                <div class="mb-3">
                    <label class="form-label" for="document-comments">Comments</label>
                    <textarea id="document-comments" name="comments" rows="3" class="form-control"
                              placeholder="Required when sending the documents back"></textarea>
                </div>

                <div class="btn-list">
                    <button type="submit" name="accept" value="true" class="btn btn-primary">Accept the documents</button>
                    <button type="submit" name="accept" value="false" class="btn btn-outline-danger">Send back for revision</button>
                </div>
            </form>
        </div>
    </div>
}
