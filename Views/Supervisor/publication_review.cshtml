@model SupervisorPapersViewModel
@inject ResearchPublicationManagementSystem.Services.IDecisionComments Decisions
@{
    ViewData["Title"] = "Research papers to review";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Research papers to review</h1>
    <div class="text-secondary">
        Papers submitted by the students you supervise. Accepting one sends it to the evaluation
        committee; sending it back returns it to the student with your comments.
    </div>
</div>

@* Same shape as the other queues: search and order applied by the API, so they cover every paper
   rather than the ten on this page. *@
@if (!Model.LoadFailed && (Model.Papers.Count > 0 || Model.HasSearch))
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Supervisor" asp-action="publication_review"
                  class="row g-2 align-items-center">

                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by paper or student" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    <a asp-controller="Supervisor" asp-action="publication_review"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "paper matches" : "papers match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">We couldn't load the papers</h2>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Supervisor" asp-action="publication_review" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Papers.Count == 0 && Model.HasSearch)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h2>
            <p class="text-secondary mb-4">No paper waiting on you has that title or student.</p>
            <a asp-controller="Supervisor" asp-action="publication_review" class="btn btn-primary">Show them all</a>
        </div>
    </div>
}
else if (Model.Papers.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">Nothing waiting for you</h2>
            <p class="text-secondary mb-4">Papers appear here once a student submits one.</p>
            <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "paper" : "papers") waiting on you,
                @Model.Papers.Count on this page.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="paper-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="paper-cards">Collapse all</button>
        </div>
    </div>


    @* Built here rather than inline: a tag helper's model attribute is delimited by double
       quotes, so a call with string arguments cannot be written inside one. *@
    var columns = new List<(string, SortableColumnViewModel)>
    {
        ("col-12 col-md-4", Model.Column("title", "Paper")),
        ("col-6 col-md-3", Model.Column("student", "Student")),
        ("col-6 col-md-2", Model.Column("submitted", "Date", descendingFirst: true))
    };

    <partial name="_QueueColumns" model="columns" />

    @foreach (var paper in Model.Papers)
    {
        <div class="card mb-3">
            <div class="card-header rpms-collapse-header"
                 data-rpms-header-toggle="#paper-@paper.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="paper-@paper.Id">
                <div class="row g-2 align-items-center w-100">
                <div class="col-12 col-md-4 d-flex align-items-center gap-2">
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>

                <div class="me-auto">
                    <h2 class="card-title m-0">@paper.Title</h2>
                    @* Whose paper it is. The queue searches and orders by the student and named
                       nobody, so a supervisor was reviewing work without being told whose. *@
                </div>
                </div>

                @* Whose work this is, in the column that orders by it. It was small print under
                   the title, so the Student heading stood over the title instead. *@
                <div class="col-6 col-md-3 text-secondary small">
                    <span class="text-nowrap">@(paper.StudentName ?? "—")</span>
                </div>

                @* The date the listing orders by. Without it the heading above ordered by
                   something the row never showed, which reads as a fault rather than an order. *@
                <div class="col-6 col-md-2 text-secondary small">
                    @if (paper.UpdatedAt is { } sentIn)
                    {
                        <span class="text-nowrap" title="When this paper was last submitted or revised">
                            @sentIn.ToLocalTime().ToString("d MMM yyyy")
                        </span>
                    }
                    else
                    {
                        <span>&mdash;</span>
                    }
                </div>

                <div class="col-6 col-md-3 d-flex flex-wrap align-items-center justify-content-md-end gap-2">

                @* Readable with the card shut: a resubmission is a different read from a first
                   draft, and it is what decides which to open. *@
                <span class="badge @StatusBadge(paper.Status)">@Humanise(paper.Status)</span>
                </div>
                </div>
            </div>

            <div class="card-body collapse show" id="paper-@paper.Id"
                 data-rpms-collapsible="paper-cards">
                <p class="text-secondary rpms-preserve-lines">@paper.Abstract</p>

                <div class="mb-3">
                    <a class="btn btn-outline-primary btn-sm"
                       asp-controller="Downloads" asp-action="Paper" asp-route-publicationId="@paper.Id">
                        Download the paper
                    </a>
                </div>

                @if (paper.Keywords.Count > 0)
                {
                    <div class="mb-3">
                        @foreach (var keyword in paper.Keywords)
                        {
                            <span class="badge bg-secondary-lt me-1">@keyword</span>
                        }
                    </div>
                }

                @* Both answers post the same form; the button chosen carries the decision. *@
                <form asp-controller="Supervisor" asp-action="SubmitPaperReview" method="post">
                    <input type="hidden" name="publicationId" value="@paper.Id" />

                    <div class="mb-3">
                        <label class="form-label" for="review-@paper.Id">Comments</label>
                        <textarea id="review-@paper.Id" name="comments" rows="3" class="form-control"
                                  placeholder="Your assessment, required when sending it back"></textarea>
                    </div>

                    @{
                        var acceptNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.PaperSupervisorAccept);
                        var returnNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.PaperSupervisorReturn);
                    }
                    <div class="btn-list">
                        <button type="submit" name="accept" value="true" class="btn btn-primary"
                                @DecisionButton.Attributes(acceptNeedsWhy, $"review-{paper.Id}",
                                    "Accept this paper and send it to the evaluation committee?")>
                            Accept and send to the committee
                        </button>
                        <button type="submit" name="accept" value="false" class="btn btn-outline-danger"
                                @DecisionButton.Attributes(returnNeedsWhy, $"review-{paper.Id}",
                                    "Send this paper back to the student?",
                                    "Say what needs changing. It is all the student is given to work from.")>
                            Send back for revision
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
