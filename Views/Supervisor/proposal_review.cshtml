@model InvitedProposalsViewModel
@{
    ViewData["Title"] = "Proposals sent to you";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Proposals sent to you</h1>
    <div class="text-secondary">
        Say which of these you are willing to supervise. Your answer is an offer. The coordinator
        makes the assignment official.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load the proposals</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Supervisor" asp-action="proposal_review" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Proposals.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting for you</h3>
            <p class="text-secondary mb-4">Proposals appear here when a coordinator sends them to you.</p>
            <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    @foreach (var proposal in Model.Proposals)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="mb-2">@proposal.Title</h3>

                @* The date the coordinator asked for an answer by. It decides whether to read this
                   now or later, so it belongs above the abstract rather than under the button. *@
                @if (proposal.RespondByLocal is { } by)
                {
                    <div class="mb-2">
                        <span class="badge @(proposal.RespondByHasPassed ? "bg-warning-lt" : "bg-secondary-lt")">
                            @if (proposal.RespondByHasPassed)
                            {
                                @:Answer was due @by.ToString("dddd d MMMM, HH:mm")
                            }
                            else
                            {
                                @:Answer by @by.ToString("dddd d MMMM, HH:mm")
                            }
                        </span>
                    </div>
                }

                <p class="text-secondary">@proposal.Abstract</p>

                <form asp-controller="Supervisor" asp-action="AcceptProposal" method="post">
                    <input type="hidden" name="proposalId" value="@proposal.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="comments-@proposal.Id">Comments</label>
                        <textarea id="comments-@proposal.Id" name="comments" rows="2" class="form-control"
                                  placeholder="Why this fits your area, or any conditions"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">I'm willing to supervise this</button>
                </form>
            </div>
        </div>
    }
}
