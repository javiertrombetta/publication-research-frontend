@model SupervisorEthicsViewModel
@{
    ViewData["Title"] = "Ethics decision";
    var container = Model.Container;
}

<div class="mb-4">
    @* Back to the queue this was opened from, not to the dashboard. Ethics reviews is where the
       next one is, and the dashboard is a detour on the way to it. *@
    <a asp-controller="Supervisor" asp-action="Ethic_reviews" class="text-secondary text-decoration-none small">
        &larr; Ethics reviews
    </a>
    <h1 class="page-title mt-2 mb-1">Does this research need ethics approval?</h1>
    <div class="text-secondary">@container.DisplayTitle &middot; @container.StudentName</div>
</div>

@* What the student actually answered, in the words they were asked it in. This card used to show
   the ethics stage the workflow had reached and call it the declaration, which told a supervisor
   nothing about the thing they are being asked to rule on. *@
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h3 mb-2">The student's declaration</h2>

        @if (Model.Approval?.StudentDeclaration is null)
        {
            <p class="text-secondary m-0">This student hasn't made their declaration yet.</p>
        }
        else
        {
            <p class="text-secondary mb-2">
                Does your research require ethical approval according to the institutional research
                ethics policy?
            </p>

            <div class="d-flex flex-wrap align-items-baseline gap-2">
                <span class="badge @DeclarationBadge(Model.Approval.StudentDeclaration)">
                    @Humanise(Model.Approval.StudentDeclaration)
                </span>

                @if (Model.Approval.StudentDeclaredAt is DateTime declaredAt)
                {
                    <span class="text-secondary small">
                        answered @declaredAt.ToLocalTime().ToString("dd MMM yyyy 'at' HH:mm")
                    </span>
                }
            </div>

            @if (Model.Approval.StudentDeclaration == "Unsure")
            {
                <p class="text-secondary mt-3 mb-0">
                    They were not sure, which is why this is with you: an unsure answer is referred
                    rather than taken either way.
                </p>
            }

            <hr class="my-3" />

            <div class="text-secondary small mb-2">The screening they worked through first</div>
            <partial name="_EthicsScreeningAnswers" model="Model.Approval.StudentScreening" />

            <div class="mt-3 small text-secondary">
                Where the ethics stage has got to:
                <span class="badge @StatusBadge(Model.Approval.Status)">@Humanise(Model.Approval.Status)</span>
            </div>
        }
    </div>
</div>

@functions {
    @* The student's own answer, coloured by what it means rather than by the workflow: yes is the
       one that brings the paperwork, unsure is the one that lands on the supervisor. *@
    string DeclarationBadge(string response) => response switch
    {
        "Yes" => "bg-orange-lt",
        "No" => "bg-secondary-lt",
        _ => "bg-yellow-lt"
    };
}

@if (!Model.NeedsRequirementDecision)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing to decide here</h3>
            <p class="text-secondary mb-4">
                This publication's ethics stage has already moved past your ruling.
            </p>
            <a asp-controller="Supervisor" asp-action="Ethic_reviews" class="btn btn-primary">Back to ethics reviews</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h2 class="h3 mb-2">Your ruling</h2>
            <p class="text-secondary">
                You decide whether this research requires ethics approval documentation. Either way
                a coordinator confirms your decision afterwards, and your comments are recorded on
                the publication's history.
            </p>

            <form asp-controller="Supervisor" asp-action="SubmitEthicsDecision" method="post">
                <input type="hidden" name="id" value="@container.Id" />

                @* Required, and said so here as well as enforced by the API: a rule the reader
                   only meets by breaking it is a rule the screen kept to itself. *@
                <div class="mb-3">
                    <label class="form-label required" for="ethics-comments">Why</label>
                    <textarea id="ethics-comments" name="comments" rows="3" class="form-control"
                              required placeholder="What led you to this decision"></textarea>
                    <small class="form-hint">
                        The coordinator confirms this decision on the strength of your reasoning,
                        and it stays on the publication's history.
                    </small>
                </div>

                <div class="btn-list">
                    <button type="submit" name="isRequired" value="true" class="btn btn-primary">
                        Ethics documentation is required
                    </button>
                    <button type="submit" name="isRequired" value="false" class="btn btn-outline-secondary">
                        Not required
                    </button>
                </div>
            </form>
        </div>
    </div>
}
