@model SupervisorEthicsViewModel
@{
    ViewData["Title"] = "Ethics decision";
    var container = Model.Container;
}

<div class="mb-4">
    <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="text-secondary text-decoration-none small">
        &larr; Dashboard
    </a>
    <h1 class="page-title mt-2 mb-1">Does this research need ethics approval?</h1>
    <div class="text-secondary">@container.DisplayTitle &middot; @container.StudentName</div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h3 mb-2">The student's declaration</h2>
        @if (Model.Approval is null)
        {
            <p class="text-secondary m-0">This student hasn't made their declaration yet.</p>
        }
        else
        {
            <span class="badge @StatusBadge(Model.Approval.Status)">@Humanise(Model.Approval.Status)</span>
        }
    </div>
</div>

@if (!Model.NeedsRequirementDecision)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing to decide here</h3>
            <p class="text-secondary mb-4">
                This publication's ethics stage has already moved past your ruling.
            </p>
            <a asp-controller="Supervisor" asp-action="SupervisorDashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h2 class="h3 mb-2">Your ruling</h2>
            <p class="text-secondary">
                You decide whether this research requires ethics approval documentation. Either way
                a coordinator confirms your decision afterwards, and your comments are recorded on
                the publication's history.
            </p>

            <form asp-controller="Supervisor" asp-action="SubmitEthicsDecision" method="post">
                <input type="hidden" name="id" value="@container.Id" />

                <div class="mb-3">
                    <label class="form-label" for="ethics-comments">Comments</label>
                    <textarea id="ethics-comments" name="comments" rows="3" class="form-control"
                              placeholder="What led you to this decision"></textarea>
                </div>

                <div class="btn-list">
                    <button type="submit" name="isRequired" value="true" class="btn btn-primary">
                        Ethics documentation is required
                    </button>
                    <button type="submit" name="isRequired" value="false" class="btn btn-outline-secondary">
                        Not required
                    </button>
                </div>
            </form>
        </div>
    </div>
}
