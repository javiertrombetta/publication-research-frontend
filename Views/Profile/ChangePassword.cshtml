@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">

        <div class="mb-4">
            <a asp-controller="Profile" asp-action="Me" class="text-secondary">&larr; My Profile</a>
            <h1 class="page-title mt-2 mb-1">Change password</h1>
            <div class="text-secondary">
                You will stay signed in here. Anywhere else you are signed in will need the new
                password.
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                @* Errors also surface as toasts, from _Toasts reading ModelState. They are
                   repeated inline so the person can see which field is at fault after the
                   toast has gone. *@
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="CurrentPassword"></label>
                        <input asp-for="CurrentPassword" type="password" class="form-control"
                               autocomplete="current-password" autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" type="password" class="form-control"
                               autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control"
                               autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <p class="text-secondary small">
                        Getting your current password wrong too many times locks the account for a
                        while. If you have forgotten it, sign out and use
                        <a asp-controller="Auth" asp-action="passwordrecovery">I forgot password</a>
                        instead.
                    </p>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Change my password</button>
                        <a asp-controller="Profile" asp-action="Me" class="btn btn-link link-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>
