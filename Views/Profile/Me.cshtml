@using ResearchPublicationManagementSystem.Common
@using System.Text.Json
@model ResearchPublicationManagementSystem.Infrastructure.Api.Dto.UserDetailDto
@{
    ViewData["Title"] = "My account";

    // The role-specific half of an account arrives as loose JSON, because what it holds depends on
    // which profile the person has. Read by name and forgiving of an absence: a supervisor has no
    // programme and a student no areas of expertise, and neither is an error.
    string Detail(string property) =>
        Model?.Profile is { } profile
        && profile.ValueKind == JsonValueKind.Object
        && profile.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? string.Empty
            : string.Empty;

    var isStudent = Model is not null && Model.Roles.Contains(RoleNames.Student);
    var isSupervisor = Model is not null && Model.Roles.Contains(RoleNames.Supervisor);

    // Only where it means something. This governs what somebody is offered next, so it is shown
    // to the people the system actually offers things to.
    //
    // That is not "everybody except students". An account holding only the placeholder role has
    // not been given a job yet, so nothing chooses it either, and the control was a promise the
    // system does not keep. The API refuses it for the same reason.
    var choosesWork = Model is not null && Model.Roles.Any(RoleNames.Operational.Contains);
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">

        @if (choosesWork)
        {
            <div class="card mb-3">
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <div class="me-auto">
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="h3 m-0">Taking work on</h2>
                            <span class="badge @(Model!.IsAvailable ? "bg-success-lt" : "bg-secondary-lt")">
                                @(Model.IsAvailable ? "Available" : "Not available")
                            </span>
                        </div>
                        <p class="text-secondary m-0 mt-1">
                            @if (Model.IsAvailable)
                            {
                                <span>
                                    You appear where the system chooses people: proposals sent to supervisors,
                                    committee appointments, and the coordinator a new publication is allocated to.
                                </span>
                            }
                            else
                            {
                                <span>
                                    You are not being offered anything new. Everything already assigned to you is
                                    still yours and still expects your decision.
                                </span>
                            }
                        </p>
                    </div>

                    <form asp-controller="Profile" asp-action="SetAvailability" method="post" class="m-0">
                        <input type="hidden" name="isAvailable" value="@((!Model.IsAvailable).ToString().ToLowerInvariant())" />
                        <button type="submit" class="btn @(Model.IsAvailable ? "btn-outline-secondary" : "btn-primary")">
                            @(Model.IsAvailable ? "Stop taking new work" : "Start taking work again")
                        </button>
                    </form>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body">
                @if (Model is null)
                {
                    <p class="text-secondary m-0">We couldn't load your account right now. Try again in a moment.</p>
                }
                else
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        @if (Model.HasProfilePhoto)
                        {
                            <span class="avatar avatar-xl rounded-circle rpms-avatar-photo"
                                  style="background-image: url('@Url.Action("Photo", "Profile")')"></span>
                        }
                        else
                        {
                            <span class="avatar avatar-xl rounded-circle bg-primary-lt fw-bold fs-1">@Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()</span>
                        }
                        <div>
                            <h1 class="h1 mb-1">@Model.FirstName @Model.LastName</h1>
                            <div class="text-secondary">@Model.Email</div>
                        </div>
                    </div>

                    <div class="btn-list mb-4">
                        <form asp-controller="Profile" asp-action="UploadPhoto" method="post"
                              enctype="multipart/form-data" class="d-inline-flex align-items-center m-0">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <input type="file" name="photo" id="me-photo-input" class="d-none"
                                   accept="image/jpeg,image/png,image/webp" onchange="this.form.submit()" />
                            <label for="me-photo-input" class="btn btn-outline-secondary btn-sm mb-0">
                                @(Model.HasProfilePhoto ? "Change photo" : "Upload photo")
                            </label>
                        </form>

                        @if (Model.HasProfilePhoto)
                        {
                            <form asp-controller="Profile" asp-action="DeletePhoto" method="post" class="d-inline m-0">
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Remove photo</button>
                            </form>
                        }
                    </div>

                    @* Your own account of yourself. Everybody signs themselves up, so everybody can
                       mistype their own name, and until now only an administrator could put it
                       right. What is not here is not an oversight: the address is what you sign in
                       with, and the department and the roles are the institution's to decide. *@
                    <form asp-controller="Profile" asp-action="SaveProfile" method="post"
                          class="row g-3 mb-4 pb-4 border-bottom">
                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="me-first-name">First name</label>
                            <input id="me-first-name" name="firstName" class="form-control"
                                   value="@Model.FirstName" required />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="me-last-name">Last name</label>
                            <input id="me-last-name" name="lastName" class="form-control"
                                   value="@Model.LastName" required />
                        </div>

                        @if (isStudent)
                        {
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="me-programme">Programme</label>
                                <input id="me-programme" name="programme" class="form-control"
                                       value="@Detail("programme")" />
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="me-cohort">Cohort</label>
                                <input id="me-cohort" name="cohort" class="form-control"
                                       value="@Detail("cohort")" />
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label" for="me-orcid">ORCID</label>
                                <input id="me-orcid" name="orcid" class="form-control"
                                       value="@Detail("orcid")" placeholder="0000-0000-0000-0000" />
                            </div>
                        }

                        @if (isSupervisor)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="me-expertise">Areas of expertise</label>
                                <textarea id="me-expertise" name="areasOfExpertise" rows="2"
                                          class="form-control">@Detail("areasOfExpertise")</textarea>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="me-interests">Research interests</label>
                                <textarea id="me-interests" name="researchInterests" rows="2"
                                          class="form-control">@Detail("researchInterests")</textarea>
                            </div>
                        }

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Save my details</button>
                            <span class="text-secondary small ms-2">
                                Your email address, department and roles are set by the institution.
                            </span>
                        </div>
                    </form>

                    @if (Model.Roles.Count == 0 || Model.Roles.All(r => r == ResearchPublicationManagementSystem.Common.RoleNames.Staff))
                    {
                        <div class="alert alert-info mb-0">
                            Your account is active, but an Administrator still has to grant you an operational
                            role before you can take part in the publication workflow.
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">Roles: @string.Join(", ", Model.Roles)</div>
                    }
                }
            </div>
        </div>

    </div>
</div>
