@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin dashboard";
    var s = Model.Summary;

    // Every figure on this page is a way into the publications it counts. Written once, here,
    // because the alternative is the same six route values copied into a dozen anchors and one of
    // them quietly disagreeing with the count above it.
    Dictionary<string, string?> To(string heading, string key, string? value) =>
        new() { [key] = value, ["heading"] = heading };
}

<div class="mb-4">
    <h1 class="page-title mb-1">Admin dashboard</h1>
    <div class="text-secondary">
        The institution's research activity at a glance. Every figure here opens the publications
        it counts, where an administrator can see what one holds, correct its documents and set
        the step it waits at.
    </div>
</div>

@if (Model.LoadFailed || s is null)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">We couldn't load the summary</h2>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    @* The one thing on this page that is a task rather than a number. *@
    @if (Model.PapersAwaitingCommittee > 0)
    {
        <div class="card border-primary mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="h3 mb-1">
                        @Model.PapersAwaitingCommittee
                        @(Model.PapersAwaitingCommittee == 1 ? "paper needs" : "papers need") an evaluation committee
                    </h2>
                    <div class="text-secondary">
                        A coordinator cannot make the final decision until a committee has reviewed the paper.
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="assigning_committee_members" class="btn btn-primary">
                    Assign committees
                </a>
            </div>
        </div>
    }

    <div class="row row-cards mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">Publications</div>
                    <a class="rpms-tally" asp-controller="Admin" asp-action="publications"
                       asp-all-route-data='To("All publications", "status", null)'>@s.TotalContainers</a>
                    <div class="text-secondary">
                        <a asp-controller="Admin" asp-action="publications"
                           asp-all-route-data='To("Publications in progress", "status", "InProgress")'>@s.ContainersInProgress in progress</a>
                        &middot;
                        <a asp-controller="Admin" asp-action="publications"
                           asp-all-route-data='To("Completed publications", "status", "Completed")'>@s.ContainersCompleted completed</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">In the public catalogue</div>
                    <a class="rpms-tally" asp-controller="Admin" asp-action="publications"
                       asp-all-route-data='To("In the public catalogue", "paperStatus", "Published")'>@s.PublishedPublicationsCount</a>
                    <div class="text-secondary">papers published</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">Committee reviews</div>
                    @* These count seats on committees, not committees: three votes outstanding can
                       be three publications or one. The listing shows the publications those seats
                       belong to, and says so. *@
                    <a class="rpms-tally" asp-controller="Admin" asp-action="publications"
                       asp-all-route-data='To("Committees with a vote outstanding", "committeeDecision", "Pending")'>@s.PendingCommitteeReviews</a>
                    <div class="text-secondary">
                        votes outstanding &middot;
                        <a asp-controller="Admin" asp-action="publications"
                           asp-all-route-data='To("Committees with votes recorded", "committeeDecision", "Decided")'>@s.CompletedCommitteeReviews recorded</a>
                    </div>
                    <div class="text-secondary small mt-1">
                        Counted per member, so a committee of three counts three times.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">Ethics approvals</div>
                    <a class="rpms-tally" asp-controller="Admin" asp-action="publications"
                       asp-all-route-data='To("Ethics approvals", "ethicsStatus", "Any")'>@s.EthicsApprovalsByStatus.Values.Sum()</a>
                    <div class="text-secondary">across all stages</div>
                </div>
            </div>
        </div>
    </div>

    @* The breakdowns are keyed by enum name, so a new status appears here on its own, and each row
       carries the filter that reproduces exactly what it counted. *@
    <div class="row row-cards">
        @foreach (var (heading, counts, key) in new (string, IReadOnlyDictionary<string, int>, string)[]
        {
            ("Publications by stage", s.ContainersByPipelineStage, "pipeline"),
            ("Papers by status", s.PublicationsByStatus, "paperStatus"),
            ("Ethics by status", s.EthicsApprovalsByStatus, "ethicsStatus"),
            ("Review decisions", s.ReviewDecisionCounts, "reviewDecision")
        })
        {
            <div class="col-12 col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h3 mb-3">@heading</h2>
                        @if (counts.Count == 0)
                        {
                            <p class="text-secondary m-0">Nothing recorded yet.</p>
                        }
                        else
                        {
                            @if (key == "reviewDecision")
                            {
                                @* Said plainly, because this one tally counts something other than
                                   publications and the listing it opens will not always match it. *@
                                <p class="text-secondary small">
                                    These count reviews. A paper read twice appears once in the listing
                                    and twice here.
                                </p>
                            }
                            <div class="table-responsive">
                                <table class="table card-table table-vcenter">
                                    <tbody>
                                        @foreach (var (name, count) in counts.OrderByDescending(c => c.Value))
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="Admin" asp-action="publications"
                                                       asp-all-route-data='To($"{heading}: {Humanise(name)}", key, name)'>
                                                        <span class="badge @StatusBadge(name)">@Humanise(name)</span>
                                                    </a>
                                                </td>
                                                <td class="text-end fw-bold">
                                                    <a asp-controller="Admin" asp-action="publications"
                                                       asp-all-route-data='To($"{heading}: {Humanise(name)}", key, name)'>@count</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* Every publication in the institution, under the cards that count them. An administrator
       arrives knowing a student's name or half a title, not which of the screens above the
       publication would be sitting on. Paged, searched and ordered by the API rather than in the
       page already in hand, so it holds up against a whole institution. *@
    <div class="card mb-3 mt-4">
        <div class="card-body py-3">
            <form method="get" asp-controller="Admin" asp-action="Dashboard" class="row g-2 align-items-center">
                @* The order survives a search, so narrowing the list does not silently reorder it. *@
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search every publication by student or title" aria-label="Search publications" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                @if (Model.HasSearch)
                {
                    <div class="col-auto">
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>
        </div>
    </div>

    @if (Model.Publications.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h2 class="h3 mb-2">
                    @(Model.HasSearch ? $"Nothing matches \u201C{Model.Search}\u201D" : "No publications yet")
                </h2>
                <p class="text-secondary m-0">
                    @(Model.HasSearch
                        ? "No publication in the institution has that student or title."
                        : "Publications appear here as students start them.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <span class="text-secondary">
                    <strong>@Model.PublicationsTotal</strong>
                    @(Model.PublicationsTotal == 1 ? "publication" : "publications") in the institution,
                    @Model.Publications.Count on this page.
                </span>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                @{
                    var byStudent = Model.Column("student", "Student");
                    var byStarted = Model.Column("started", "Publication", descendingFirst: true);
                    var byStage = Model.Column("stage", "Stage");
                    var byStatus = Model.Column("status", "Status");
                    var byActivity = Model.Column("activity", "Last activity", descendingFirst: true);
                    var byWaiting = Model.Column("waiting", "Waiting on");
                }
                <table class="table card-table table-vcenter rpms-table-stable">
                    @* Declared once so the columns do not resize themselves around whichever ten
                       rows a sort happens to bring onto the page. *@
                    <colgroup>
                        <col style="width: 15%" />
                        <col style="width: 27%" />
                        <col style="width: 14%" />
                        <col style="width: 12%" />
                        <col style="width: 15%" />
                        <col style="width: 17%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col"><partial name="_SortableHeader" model="byStudent" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byStarted" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byStage" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byStatus" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byActivity" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byWaiting" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var publication in Model.Publications)
                        {
                            <tr>
                                <td>@publication.StudentName</td>
                                <td>
                                    <a asp-controller="Admin" asp-action="publication" asp-route-id="@publication.Id"
                                       class="text-reset text-decoration-none fw-medium">@publication.DisplayTitle</a>
                                </td>
                                <td>
                                    @(publication.CurrentPipeline switch
                                    {
                                        PipelineStage.ResearchProposals => "Research proposals",
                                        PipelineStage.EthicsApproval => "Ethics approval",
                                        PipelineStage.ResearchPaper => "Research paper",
                                        _ => "\u2014"
                                    })
                                </td>
                                <td>
                                    <span class="badge @StatusBadge(publication.DisplayStatus)">
                                        @Humanise(publication.DisplayStatus)
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    @(publication.LastActivityAt is { } when
                                        ? when.ToLocalTime().ToString("d MMM yyyy, HH:mm")
                                        : "Nothing yet")
                                </td>
                                <td>
                                    @(publication.EthicsAwaitingRole is { } ethics ? Humanise(ethics)
                                      : publication.PaperAwaitingRole is { } paper ? Humanise(paper)
                                      : publication.Status == "Completed" ? "Nobody, it is finished"
                                      : "Nobody")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <partial name="_Pager" model="Model.Pager" />
    }
}
