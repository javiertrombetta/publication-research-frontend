@model AssignCommitteeViewModel
@inject ResearchPublicationManagementSystem.Services.IDecisionComments Decisions
@{
    ViewData["Title"] = "Assign evaluation committees";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Assign evaluation committees</h1>
    <div class="text-secondary">
        Papers a supervisor has accepted that have no committee yet. Nothing moves until one is
        assigned, because the coordinator's final decision is blocked on it.
    </div>
</div>

@* Applied by the API, so it searches every paper waiting for a committee rather than the page in
   hand. The same control the other queues carry. *@
@if (!Model.LoadFailed && (Model.WaitingTotal > 0 || Model.HasSearch))
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Admin" asp-action="assigning_committee_members"
                  class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by paper or student" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    <a asp-controller="Admin" asp-action="assigning_committee_members"
                       class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load them</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Admin" asp-action="assigning_committee_members" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0 && Model.HasSearch)
{
    @* A search that found nothing is a different thing from an empty queue. *@
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h3>
            <p class="text-secondary mb-4">No paper waiting for a committee has that title or student.</p>
            <a asp-controller="Admin" asp-action="assigning_committee_members" class="btn btn-primary">
                Show them all
            </a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">Every paper under review already has a committee.</p>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else if (Model.Members.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nobody can be appointed</h3>
            <p class="text-secondary m-0">
                There are no enabled accounts other than students. Anyone who works here can sit on a
                committee, so add or enable a staff account from the user directory first.
            </p>
        </div>
    </div>
}
else
{
    @* Collapsed to start with, like every other queue here. Appointing a committee means reading
       one paper and ticking a list of names, and eight of those forms open at once is a page
       nobody can find their way down. *@
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.WaitingTotal</strong>
                @(Model.WaitingTotal == 1 ? "paper needs" : "papers need") a committee.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="awaiting-committee-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="awaiting-committee-cards">Collapse all</button>
        </div>
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#awaiting-@item.Paper.Id"
                 role="button" tabindex="0" aria-expanded="false" aria-controls="awaiting-@item.Paper.Id">
                @* Part of the header rather than a control of its own, so clicking it does not
                   leave an icon looking selected in the middle of a row. *@
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>
                <div class="me-auto">
                    <h3 class="card-title m-0">@item.Paper.Title</h3>
                    <div class="text-secondary small">@item.Paper.StudentName</div>
                </div>
                <span class="badge bg-primary-lt">
                    @item.RequiredReviewers + @item.RequiredExternal needed
                </span>
            </div>

            <div class="card-body collapse" id="awaiting-@item.Paper.Id"
                 data-rpms-collapsible="awaiting-committee-cards">
                <p class="text-secondary rpms-preserve-lines">@item.Paper.Abstract</p>

                <form asp-controller="Admin" asp-action="AssignCommittee" method="post">
                    <input type="hidden" name="publicationId" value="@item.Paper.Id" />

                    @* Stated per publication, not once for the page: each records the committee
                       rules in force when it was opened, and the API rejects a committee that
                       does not match them.

                       Said loudly, and counted as the boxes are ticked, because an administrator
                       comes to this screen straight from System settings and reasonably expects
                       the figures they just saved. Those govern publications opened from now on.
                       This one keeps what it was opened under, so that research under way for
                       months is not rejudged by a rule agreed after it started. *@
                    <h4 class="mt-3 mb-1">Members</h4>
                    <div class="alert alert-info py-2 px-3 mb-3"
                         data-rpms-committee-required-reviewers="@item.RequiredReviewers"
                         data-rpms-committee-required-external="@item.RequiredExternal">
                        <div>
                            This publication needs
                            <strong>@item.RequiredReviewers @(item.RequiredReviewers == 1 ? "reviewer" : "reviewers")</strong>
                            and
                            <strong>@item.RequiredExternal external @(item.RequiredExternal == 1 ? "member" : "members")</strong>,
                            the composition agreed when it was opened. Changing the figures in
                            System settings governs publications opened after the change, not this one.
                        </div>
                        <div class="small mt-1" data-rpms-committee-tally aria-live="polite"></div>

                        @* A publication can turn out to need a committee of its own shape: the
                           people it needs are not there, or the work asks for one more reader.
                           Deciding that is the administrator's, and it costs a reason, which is
                           what somebody reading the history in six months has to go on. Only
                           offered here, before the committee exists; one already sitting is not
                           rearranged underneath its members. *@
                        <label class="form-check mt-2 mb-0">
                            <input class="form-check-input" type="checkbox" name="overrideComposition" value="true"
                                   data-rpms-committee-override />
                            <span class="form-check-label">
                                Appoint a different composition for this publication
                            </span>
                        </label>
                    </div>
                    <div class="row g-2 mb-3">
                        @foreach (var member in Model.Members)
                        {
                            <div class="col-12 col-md-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="memberUserIds" value="@member.UserId"
                                           data-rpms-member-external="@(member.Roles.Contains(RoleNames.ExternalCommitteeMember) ? "true" : "false")" />
                                    <span class="form-check-label">
                                        @member.FullName
                                        <span class="d-block text-secondary small">
                                            @* External is a fact about the person, who comes from outside
                                               the institution, so it is shown rather than chosen here, and
                                               it is what the required composition counts. *@
                                            @(member.Roles.Contains(RoleNames.ExternalCommitteeMember) ? "External" : "Reviewer")
                                            @if (member.Roles.Any(r => r != RoleNames.ExternalCommitteeMember))
                                            {
                                                <span>· @string.Join(", ", member.Roles.Where(r => r != RoleNames.ExternalCommitteeMember).Select(Humanise))</span>
                                            }
                                        </span>
                                    </span>
                                </label>
                            </div>
                        }
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-sm-4">
                            <label class="form-label" for="approvals-@item.Paper.Id">Approvals required</label>
                            @* No ceiling in the markup: with a composition of its own the committee
                               can be larger or smaller than the recorded one, and a fixed maximum
                               would refuse a figure that is perfectly good. The submit check counts
                               it against the members actually chosen, and so does the API. *@
                            <input id="approvals-@item.Paper.Id" name="minApprovalsRequired" type="number"
                                   min="1"
                                   value="@Model.CurrentRules?.MinimumApprovals" class="form-control" required />
                        </div>
                        <div class="col-12 col-sm-8">
                            <label class="form-label" for="assign-comments-@item.Paper.Id" data-rpms-committee-comments-label>Comments</label>
                            <input id="assign-comments-@item.Paper.Id" name="comments" class="form-control"
                                   placeholder="Recorded on the publication's history" />
                        </div>
                    </div>

                    @{
                        var assignNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.PaperCommitteeAssign);
                        var overrideNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.PaperCommitteeAssignOverride);
                    }
                    @* Two decisions behind one button: the shape agreed for this publication, or a
                       different one. Which it is depends on the tick above, so the page script
                       swaps the requirement over when that changes. *@
                    <button type="submit" class="btn btn-primary mt-3"
                            data-rpms-committee-assign
                            data-rpms-needs-comments-agreed="@(assignNeedsWhy ? $"assign-comments-{item.Paper.Id}" : null)"
                            data-rpms-needs-comments-override="@(overrideNeedsWhy ? $"assign-comments-{item.Paper.Id}" : null)"
                            @DecisionButton.Attributes(assignNeedsWhy, $"assign-comments-{item.Paper.Id}",
                                "Appoint this committee? Its members are asked to evaluate the paper straight away.")>Assign this committee</button>
                </form>
            </div>
        </div>
    }

    @if (Model.WaitingPager is not null)
    {
        <partial name="_Pager" model="Model.WaitingPager" />
    }
}

@* Committees already sitting. Kept outside the branch above, because a deployment can perfectly
   well have no paper waiting for a committee and several committees that need changing, and
   putting this inside it made the second invisible whenever the first was empty. *@
@if (Model.InProgress.Count > 0)
{
    <h2 class="h2 mt-5 mb-1">Committees under way</h2>
    <p class="text-secondary mb-3">
        Already appointed and still sitting. Change who is on one when somebody goes on leave or was
        appointed by mistake; a member who stays keeps the decision they have recorded. A committee
        that has finished is not here: its decisions are what the coordinator rules on.
    </p>

    @foreach (var committee in Model.InProgress)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#committee-@committee.Id"
                 role="button" tabindex="0" aria-expanded="false" aria-controls="committee-@committee.Id">
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>
                <div class="me-auto">
                    <h3 class="card-title m-0">@(committee.Paper?.Title ?? "Untitled paper")</h3>
                    <div class="text-secondary small">@committee.StudentName</div>
                </div>
                <span class="badge bg-primary-lt">
                    @committee.Decided of @committee.Members.Count decided
                </span>
            </div>

            <div class="card-body collapse" id="committee-@committee.Id" data-rpms-collapsible="committee-cards">
                <form asp-controller="Admin" asp-action="UpdateCommittee" method="post">
                    <input type="hidden" name="committeeId" value="@committee.Id" />

                    <h4 class="mb-1">Members</h4>
                    <p class="text-secondary small">
                        This is the committee as it should stand once you save: anyone unticked is
                        removed. @committee.Approvals of @committee.MinApprovalsRequired approvals
                        have been recorded so far.
                    </p>

                    <div class="row g-2 mb-3">
                        @foreach (var person in Model.Members)
                        {
                            var sitting = committee.Members.FirstOrDefault(m => m.UserId == person.UserId);
                            <div class="col-12 col-md-6">
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" name="memberUserIds"
                                           value="@person.UserId" checked="@(sitting is not null)" />
                                    <span class="form-check-label">
                                        @person.FullName
                                        <span class="d-block text-secondary small">
                                            @(person.IsExternal ? "External" : "Reviewer")
                                            @if (sitting is not null && sitting.HasDecided)
                                            {
                                                @* Said here because it is what makes removing this
                                                   person a different act from removing anybody
                                                   else: their vote goes with them. *@
                                                <span>&middot; has already decided: @Humanise(sitting.Decision)</span>
                                            }
                                        </span>
                                    </span>
                                </label>
                            </div>
                        }
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-sm-4">
                            <label class="form-label" for="approvals-committee-@committee.Id">Approvals required</label>
                            <input id="approvals-committee-@committee.Id" name="minApprovalsRequired" type="number"
                                   min="1" value="@committee.MinApprovalsRequired" class="form-control" required />
                        </div>
                        <div class="col-12 col-sm-8">
                            <label class="form-label" for="change-comments-@committee.Id">Why this change</label>
                            <input id="change-comments-@committee.Id" name="comments" class="form-control"
                                   placeholder="Required. Stays on the publication&#x27;s history." />
                        </div>
                    </div>

                    <label class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" name="overrideComposition" value="true" />
                        <span class="form-check-label">
                            The new composition differs from the one this publication was opened under
                        </span>
                    </label>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary"
                                @DecisionButton.Attributes(true, $"change-comments-{committee.Id}",
                                    "Change this committee? Anyone added is asked to evaluate the paper, and anyone removed loses it from their list.",
                                    "Say why this committee is being changed. It stays on the publication&#x27;s history.")>
                            Save this committee
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.InProgressPager is not null)
    {
        <partial name="_Pager" model="Model.InProgressPager" />
    }
}

@if (Model.Items.Count > 0 && Model.Members.Count > 0)
{
    @section Scripts {
        <script>
            // The backend rejects an empty committee, a composition that does not match what this
            // publication was opened under, and more approvals than there are members. Said here as
            // the boxes are ticked, so the count is in front of whoever is choosing rather than
            // arriving as a refusal after they have finished.
            document.querySelectorAll('form[action*="AssignCommittee"]').forEach(function (form) {
                var banner = form.querySelector('[data-rpms-committee-required-reviewers]');
                var tally = form.querySelector('[data-rpms-committee-tally]');
                var override = form.querySelector('[data-rpms-committee-override]');
                var commentsLabel = form.querySelector('[data-rpms-committee-comments-label]');
                var comments = form.querySelector('input[name="comments"]');
                var wantedReviewers = parseInt(banner.dataset.rpmsCommitteeRequiredReviewers, 10);
                var wantedExternal = parseInt(banner.dataset.rpmsCommitteeRequiredExternal, 10);

                function chosen() {
                    var external = 0, reviewers = 0;
                    form.querySelectorAll('input[name="memberUserIds"]:checked').forEach(function (box) {
                        if (box.dataset.rpmsMemberExternal === 'true') external++; else reviewers++;
                    });
                    return { external: external, reviewers: reviewers, total: external + reviewers };
                }

                function draw() {
                    var have = chosen();
                    var matches = have.reviewers === wantedReviewers && have.external === wantedExternal;

                    tally.textContent = 'Chosen: ' + have.reviewers + ' of ' + wantedReviewers + ' reviewers, '
                        + have.external + ' of ' + wantedExternal + ' external.'
                        + (override.checked
                            ? ' This publication will be judged by the committee you appoint here.'
                            : matches ? ' That is the composition this publication needs.' : '');
                    tally.classList.toggle('fw-bold', !matches && !override.checked);

                    // The comment is the whole of the record for a committee that departs from
                    // what was agreed, so the field says as much while that is what it is for.
                    commentsLabel.textContent = override.checked ? 'Why this composition' : 'Comments';
                    comments.placeholder = override.checked
                        ? 'Required. Stays on the publication’s history.'
                        : 'Recorded on the publication’s history';
                }

                // One button, two decisions: appointing the agreed shape or a different one. This
                // institution may ask for a reason on one and not the other, so which field the
                // button insists on follows the tick.
                var assign = form.querySelector('[data-rpms-committee-assign]');
                function applyCommentRule() {
                    var field = override.checked
                        ? assign.dataset.rpmsNeedsCommentsOverride
                        : assign.dataset.rpmsNeedsCommentsAgreed;

                    if (field) assign.setAttribute('data-rpms-needs-comments', field);
                    else assign.removeAttribute('data-rpms-needs-comments');
                }

                form.addEventListener('change', function (event) {
                    if (event.target.name === 'memberUserIds' || event.target === override) draw();
                    if (event.target === override) applyCommentRule();
                });
                draw();
                applyCommentRule();

                form.addEventListener('submit', function (event) {
                    var have = chosen();
                    var approvals = parseInt(form.querySelector('input[name="minApprovalsRequired"]').value, 10);

                    var problems = [];
                    if (!have.total) {
                        problems.push('Choose at least one committee member.');
                    } else if (override.checked && !comments.value.trim()) {
                        problems.push('Say why this publication is being given a committee of a different shape. '
                            + 'It stays on the publication’s history.');
                    } else if (!override.checked && (have.reviewers !== wantedReviewers || have.external !== wantedExternal)) {
                        problems.push('This publication needs ' + wantedReviewers + ' reviewers and ' + wantedExternal
                            + ' external, the composition it was opened under. You have chosen '
                            + have.reviewers + ' and ' + have.external
                            + '. To appoint a different one, tick the box and say why.');
                    } else if (approvals > have.total) {
                        problems.push('You have asked for ' + approvals + ' approvals but chosen only '
                            + have.total + ' member' + (have.total === 1 ? '' : 's') + '.');
                    }

                    if (!problems.length) return;
                    event.preventDefault();
                    if (override.checked && !comments.value.trim()) comments.focus();
                    window.rpmsToast('error', problems);
                });
            });
        </script>
    }
}
