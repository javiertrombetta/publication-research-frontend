@model PublicationsAdminViewModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="mb-4">
    <a asp-controller="Admin" asp-action="Dashboard" class="text-secondary">&larr; Admin dashboard</a>
    <h1 class="page-title mt-2 mb-1">@Model.Heading</h1>
    <div class="text-secondary">
        The publications behind that figure. Open one to see what it holds, add or remove its
        documents, and set the step it waits at.
    </div>
    @if (Model.Description is { Length: > 0 } note)
    {
        <div class="text-secondary mt-1">@note</div>
    }
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">We couldn't load them</h2>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Admin" asp-action="publications" asp-all-route-data="Model.RouteValues()"
               class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    @* Applied by the API within this filter, so it searches every publication the figure counted
       rather than the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Admin" asp-action="publications"
                  class="row g-2 align-items-center">

                @* The filter is what makes this listing the figure it came from, so it travels
                   with the search rather than being dropped by it. *@
                @foreach (var (key, value) in Model.Filter())
                {
                    <input type="hidden" name="@key" value="@value" />
                }
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student, title or abstract" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    <a asp-controller="Admin" asp-action="publications"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Publications.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h2 class="h3 mb-2">Nothing here</h2>
                <p class="text-secondary m-0">
                    @(Model.HasSearch
                        ? $"No publication in this group matches “{Model.Search}”."
                        : "No publication is in this group at the moment.")
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="text-secondary mb-3">
            @Model.TotalCount @(Model.TotalCount == 1 ? "publication" : "publications")
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    @{
                        // Built here rather than inline: a tag helper's model attribute is delimited
                        // by double quotes, so a call with string arguments cannot be written inside.
                        var byTitle = Model.Column("title", "Publication");
                        var byStudent = Model.Column("student", "Student");
                        var byStatus = Model.Column("status", "Where it stands");
                        var byWaiting = Model.Column("waiting", "Waiting on");
                        var byStarted = Model.Column("started", "Opened", descendingFirst: true);
                    }
                    <thead>
                        <tr>
                            <th scope="col"><partial name="_SortableHeader" model="byTitle" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byStudent" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byStatus" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byWaiting" /></th>
                            <th scope="col"><partial name="_SortableHeader" model="byStarted" /></th>
                            <th scope="col" class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var publication in Model.Publications)
                        {
                            <tr>
                                <td>@publication.DisplayTitle</td>
                                <td class="text-nowrap">@publication.StudentName</td>
                                <td>
                                    <span class="badge @StatusBadge(publication.PaperStatus ?? publication.Status)">
                                        @Humanise(publication.PaperStatus ?? publication.Status)
                                    </span>
                                    <span class="d-block text-secondary small">
                                        @StageName(publication.CurrentPipeline)
                                    </span>
                                </td>
                                <td>
                                    @* Whose turn it is, on whichever of the two stages is running.
                                       Nothing at all where the publication is finished or between
                                       steps, which is honest: nobody is holding it up. *@
                                    @if (publication.EthicsAwaitingRole is { Length: > 0 } ethicsRole)
                                    {
                                        <span class="text-nowrap">@Humanise(ethicsRole)</span>
                                    }
                                    else if (publication.PaperAwaitingRole is { Length: > 0 } paperRole)
                                    {
                                        <span class="text-nowrap">@Humanise(paperRole)</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">&mdash;</span>
                                    }
                                </td>
                                <td class="text-nowrap">@publication.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="Admin" asp-action="publication"
                                       asp-route-id="@publication.Id" class="btn btn-sm btn-outline-primary">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Pager is not null)
        {
            <partial name="_Pager" model="Model.Pager" />
        }
    }
}
