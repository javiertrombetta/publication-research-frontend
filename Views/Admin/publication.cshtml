@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model PublicationDetailViewModel
@{
    ViewData["Title"] = Model.Container.DisplayTitle;

    string TabClass(string tab) => Model.ActiveTab == tab ? "nav-link active" : "nav-link";

    // Once the paper has been accepted, what this publication holds is the record of what was
    // judged. Correcting it then does not unstick anybody; it makes the record disagree with the
    // decision taken on it. Every control that changes the material is withdrawn together, and the
    // API refuses each of them as well, because a screen is not a rule.
    var settled = Model.Publication is not null
                  && (Model.Publication.Status == "Accepted" || Model.Publication.Status == "Published");
}

@* The decisions stay where the pipeline put them: nothing here approves, sends back or accepts on
   anybody's behalf. What an administrator can do is correct what the publication holds and say
   where it should stand afterwards, both with a reason on the record. *@

@{
    // Back to wherever this was opened from. Three screens link to this record, and a link that
    // always went to Assignments sent most readers to a screen they had not been on.
    var (backAction, backLabel) = Model.CameFrom switch
    {
        "dashboard" => ("Dashboard", "Dashboard"),
        "publications" => ("publications", "Publications"),
        _ => ("assignments", "Assignments")
    };
}

<div class="mb-4">
    <a asp-controller="Admin" asp-action="@backAction" class="text-secondary">&larr; @backLabel</a>
    <h1 class="page-title mt-2 mb-1">@Model.Container.DisplayTitle</h1>
    <div class="text-secondary">
        @Model.Container.StudentName
        @if (!string.IsNullOrWhiteSpace(Model.Container.StudentDepartmentName))
        {
            <text>&middot; @Model.Container.StudentDepartmentName</text>
        }
        &middot; started @Model.Container.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <div class="text-secondary small">Stage</div>
                <div>
                    @(Model.Container.CurrentPipeline switch
                    {
                        PipelineStage.ResearchProposals => "Research proposals",
                        PipelineStage.EthicsApproval => "Ethics approval",
                        _ => "Research paper"
                    })
                </div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-secondary small">Coordinator</div>
                <div>@Model.Container.CoordinatorName</div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-secondary small">Supervisor</div>
                <div>@(Model.Container.AssignedSupervisorName ?? "None yet")</div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-secondary small">Waiting on</div>
                <div>
                    @(Model.Container.EthicsAwaitingRole
                      ?? Model.Container.PaperAwaitingRole
                      ?? "Nobody")
                </div>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="@TabClass("progress")" asp-action="publication" asp-route-id="@Model.Container.Id"
           asp-route-from="@Model.CameFrom">Contents</a>
    </li>
    <li class="nav-item">
        <a class="@TabClass("history")" asp-action="publication" asp-route-id="@Model.Container.Id"
           asp-route-tab="history" asp-route-from="@Model.CameFrom">Activity history</a>
    </li>
</ul>

@if (Model.ActiveTab == "history")
{
    <div class="card">
        <div class="card-body">
            <h2 class="h3 mb-3">Activity history</h2>

            @* Over what the trail says in words: the action, the person, and the comment they
               left. The same search the coordinator and the head of department read this record
               with, because it is the same record. *@
            <form method="get" asp-action="publication" class="row g-2 align-items-center mb-3">
                <input type="hidden" name="id" value="@Model.Container.Id" />
                <input type="hidden" name="tab" value="history" />
                <input type="hidden" name="from" value="@Model.CameFrom" />
                <input type="hidden" name="historySort" value="@Model.HistorySort" />
                <input type="hidden" name="historyDesc" value="@Model.HistoryDescending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="historySearch" value="@Model.HistorySearch" class="form-control"
                           placeholder="Search the history by action, person or comment" aria-label="Search the history" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.HistorySearch))
                {
                    <div class="col-auto">
                        <a asp-action="publication" asp-route-id="@Model.Container.Id" asp-route-tab="history"
                           asp-route-from="@Model.CameFrom" class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>

            @if (Model.History.Count == 0 && !string.IsNullOrWhiteSpace(Model.HistorySearch))
            {
                <p class="text-secondary m-0">Nothing in this publication's history matches &ldquo;@Model.HistorySearch&rdquo;.</p>
            }
            else if (Model.History.Count == 0)
            {
                <p class="text-secondary m-0">Nothing has been recorded against this publication yet.</p>
            }
            else
            {
                @* Built here rather than inline: a tag helper's model attribute is delimited by
                   double quotes, so a call with string arguments cannot be written inside one. *@
                var byWhen = Model.HistoryColumn("when", "When", descendingFirst: true);
                var byWhat = Model.HistoryColumn("what", "What");
                var byWho = Model.HistoryColumn("who", "Who");
                var byComment = Model.HistoryColumn("comments", "Comments");

                <div class="table-responsive">
                    <table class="table card-table table-vcenter">
                        <thead id="@byWhen.Anchor">
                            @* Ordered by the API, over the whole trail rather than the page in
                               hand: the oldest entry is on the last page, and sorting ten rows
                               would never bring it into view. *@
                            <tr>
                                <th scope="col"><partial name="_SortableHeader" model="byWhen" /></th>
                                <th scope="col"><partial name="_SortableHeader" model="byWhat" /></th>
                                <th scope="col"><partial name="_SortableHeader" model="byWho" /></th>
                                <th scope="col"><partial name="_SortableHeader" model="byComment" /></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.History)
                            {
                                <tr>
                                    <td class="text-nowrap">@entry.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>
                                    <td>@Humanise(entry.Action)</td>
                                    <td>@entry.ActorName</td>
                                    <td>@entry.Comments</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.HistoryPager is not null)
    {
        <partial name="_Pager" model="Model.HistoryPager" />
    }
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h3 mb-3">Research proposals</h2>
            @if (Model.Proposals.Count == 0)
            {
                <p class="text-secondary m-0">This student has not written any proposals yet.</p>
            }
            else
            {
                @* Ordered by the API over the whole listing. There is no pager on these: a round
                   holds three proposals, a committee three seats, and the ethics stage asks for a
                   fixed set, so a second page would never come. They are still worth ordering. *@
                var byTitle = Model.ProposalsColumn("title", "Title");
                var byStatus = Model.ProposalsColumn("status", "Status");
                var bySubmitted = Model.ProposalsColumn("submitted", "Submitted", descendingFirst: true);

                <div class="table-responsive">
                    <table class="table card-table table-vcenter">
                        <thead id="@byTitle.Anchor">
                            <tr>
                                <th scope="col"><partial name="_SortableHeader" model="byTitle" /></th>
                                <th scope="col"><partial name="_SortableHeader" model="byStatus" /></th>
                                <th scope="col"><partial name="_SortableHeader" model="bySubmitted" /></th>
                                @if (!settled)
                                {
                                    <th scope="col">Why you are changing it</th>
                                    <th scope="col" class="w-1"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proposal in Model.Proposals)
                            {
                                <tr>
                                    <td>
                                        @proposal.Title
                                        <span class="d-block text-secondary small">@proposal.Abstract</span>
                                    </td>
                                    <td><span class="badge @StatusBadge(proposal.Status)">@Humanise(proposal.Status)</span></td>
                                    <td class="text-nowrap">
                                        @(proposal.SubmittedAt?.ToLocalTime().ToString("d MMM yyyy") ?? "Not sent")
                                    </td>

                                    @* The reason has a column of its own, and the button sits
                                       outside the form and points at it by id. Put inside the
                                       action cell the field pushed the button off the end of the
                                       row on anything narrower than a desktop. *@
                                    @if (!settled)
                                    {
                                        <td>
                                            @if (proposal.Status != "Assigned")
                                            {
                                                <form asp-action="ChangeAssignedProposal" method="post"
                                                      id="assign-proposal-@proposal.Id">
                                                    <input type="hidden" name="id" value="@Model.Container.Id" />
                                                    <input type="hidden" name="proposalId" value="@proposal.Id" />
                                                    <input type="text" name="comments" class="form-control form-control-sm"
                                                           id="assign-proposal-comments-@proposal.Id"
                                                           aria-label="Why you are assigning @proposal.Title"
                                                           placeholder="Required. Stays on the history." />
                                                </form>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (proposal.Status == "Assigned")
                                            {
                                                <span class="text-secondary small text-nowrap">Running on this one</span>
                                            }
                                            else
                                            {
                                                <button type="submit" form="assign-proposal-@proposal.Id"
                                                        class="btn btn-sm btn-outline-primary text-nowrap"
                                                        @DecisionButton.Attributes(true, $"assign-proposal-comments-{proposal.Id}",
                                                            "Run this publication on that proposal instead? Its title changes everywhere, and the student, the supervisor and the coordinator are all told.",
                                                            "Say why the publication is changing proposal.")>
                                                    Run on this
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (settled)
            {
                <p class="text-secondary small mb-0 mt-3">
                    The research paper has been accepted, so the proposal it was written from is
                    part of the record and is left as it is.
                </p>
            }
            else
            {
                @* Two different acts, deliberately apart. Above, one of these proposals becomes the
                   one the publication runs on. Here, all of them are thrown away and the student
                   starts again. *@
                <form asp-action="RequestNewProposals" method="post"
                      class="row g-2 align-items-end mt-3 pt-3 border-top">
                    <input type="hidden" name="id" value="@Model.Container.Id" />
                    <div class="col-12 col-md-8">
                        <label class="form-label" for="new-proposals-comments">
                            Ask the student for a new set of proposals
                        </label>
                        <input type="text" name="comments" id="new-proposals-comments" class="form-control"
                               placeholder="Required. The student is told, and it stays on the history." />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-danger"
                                @DecisionButton.Attributes(true, "new-proposals-comments",
                                    "Ask for a new set of proposals? Every proposal on this publication is turned down and the student writes again from scratch.",
                                    "Say why a new set is being asked for.")>
                            Ask for new proposals
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h3 mb-3">Ethics</h2>
            @if (Model.EthicsApproval is null)
            {
                <p class="text-secondary m-0">This publication has not reached its ethics stage.</p>
            }
            else
            {
                <div class="mb-3">
                    <span class="badge @StatusBadge(Model.EthicsApproval.Status)">@Humanise(Model.EthicsApproval.Status)</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Container.EthicsHeadOfDepartmentName))
                    {
                        <span class="text-secondary small ms-2">
                            Put to @Model.Container.EthicsHeadOfDepartmentName
                        </span>
                    }
                </div>

                @foreach (var (label, said) in new[]
                {
                    ("The supervisor said", Model.EthicsApproval.SupervisorDecisionComments),
                    ("The coordinator said", Model.EthicsApproval.CoordinatorDecisionComments),
                    ("The Head of Department said", Model.EthicsApproval.HeadOfDepartmentComments)
                })
                {
                    @if (!string.IsNullOrWhiteSpace(said))
                    {
                        <div class="mb-3">
                            <div class="text-secondary small">@label</div>
                            <p class="m-0">@said</p>
                        </div>
                    }
                }

                @if (Model.EthicsDocuments.Count == 0)
                {
                    <p class="text-secondary mb-3">No ethics documentation was uploaded.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter">
                            @{
                                var byDocument = Model.DocumentsColumn("document", "Document");
                                var byFile = Model.DocumentsColumn("file", "File");
                                var byVersion = Model.DocumentsColumn("version", "Version", descendingFirst: true);
                                var byStatus = Model.DocumentsColumn("status", "Status");
                            }
                            <thead id="@byDocument.Anchor">
                                <tr>
                                    <th scope="col"><partial name="_SortableHeader" model="byDocument" /></th>
                                    <th scope="col"><partial name="_SortableHeader" model="byFile" /></th>
                                    <th scope="col"><partial name="_SortableHeader" model="byVersion" /></th>
                                    <th scope="col"><partial name="_SortableHeader" model="byStatus" /></th>
                                    @if (!settled)
                                    {
                                        <th scope="col">Why you are removing it</th>
                                    }
                                    <th scope="col" class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var document in Model.EthicsDocuments)
                                {
                                    <tr>
                                        <td>@Humanise(document.DocumentType)</td>
                                        <td>@document.FileName</td>
                                        <td>@document.Version</td>
                                        <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>

                                        @* A column of its own, and the button outside the form
                                           pointing at it by id. Sharing the action cell, the field
                                           was squeezed between the two buttons and pushed hard
                                           against the left of a cell aligned to the right. *@
                                        @if (!settled)
                                        {
                                            <td>
                                                <form asp-action="RemoveEthicsDocument" method="post"
                                                      id="remove-doc-form-@document.Id">
                                                    <input type="hidden" name="id" value="@Model.Container.Id" />
                                                    <input type="hidden" name="documentId" value="@document.Id" />
                                                    <input type="text" name="comments" class="form-control form-control-sm"
                                                           id="remove-doc-@document.Id"
                                                           aria-label="Why you are removing @document.DocumentType"
                                                           placeholder="Required. Stays on the history." />
                                                </form>
                                            </td>
                                        }

                                        <td class="text-end text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-controller="Downloads" asp-action="EthicsDocument"
                                               asp-route-containerId="@Model.Container.Id"
                                               asp-route-documentId="@document.Id">Download</a>

                                            @if (!settled)
                                            {
                                                <button type="submit" form="remove-doc-form-@document.Id"
                                                        class="btn btn-sm btn-outline-danger ms-1"
                                                        @DecisionButton.Attributes(true, $"remove-doc-{document.Id}",
                                                            "Remove this document? The file goes with it. Check where the stage stands afterwards.",
                                                            "Say why this document is being removed.")>Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (settled)
                {
                    <p class="text-secondary small mb-0">
                        The research paper has been accepted, so this documentation is part of the
                        record of what was judged and cannot be changed from here.
                    </p>
                }
                else if (Model.EthicsRequirements.Count > 0)
                {
                    <form asp-action="AddEthicsDocument" method="post" enctype="multipart/form-data"
                          class="row g-2 align-items-end mt-3 pt-3 border-top">
                        <input type="hidden" name="id" value="@Model.Container.Id" />
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="add-doc-type">Add a document</label>
                            <select id="add-doc-type" name="documentType" class="form-select">
                                @foreach (var requirement in Model.EthicsRequirements)
                                {
                                    <option value="@requirement.Id">@requirement.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            @* Named for a screen reader rather than labelled on screen: this row aligns its
                               controls along one line, and only the first of them carries a visible label. *@
                            <input type="file" name="file" class="form-control" required
                                   aria-label="The document to add" />
                        </div>
                        <div class="col-12 col-md-4">
                            <input type="text" name="comments" id="add-doc-comments" class="form-control"
                                   aria-label="Why you are adding it"
                                   placeholder="Why you are adding it" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-outline-primary"
                                    @DecisionButton.Attributes(true, "add-doc-comments",
                                        "Add this document? It goes on unread, which puts the stage on whoever reads first. Set where it should stand below.",
                                        "Say why this document is being added.")>Add</button>
                        </div>
                    </form>
                }
            }
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h3 mb-3">Research paper</h2>
            @if (Model.Publication is null)
            {
                <p class="text-secondary m-0">This publication has not reached its research paper stage.</p>
            }
            else
            {
                <div class="mb-3">
                    <h3 class="h4 mb-1">@Model.Publication.Title</h3>
                    <span class="badge @StatusBadge(Model.Publication.Status)">@Humanise(Model.Publication.Status)</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Publication.Abstract))
                {
                    <p class="text-secondary">@Model.Publication.Abstract</p>
                }

                @if (Model.PaperVersions.Count == 0)
                {
                    <p class="text-secondary m-0">No version has been uploaded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table card-table table-vcenter">
                            @{
                                var byVersionNumber = Model.VersionsColumn("version", "Version", descendingFirst: true);
                                var byVersionFile = Model.VersionsColumn("file", "File");
                                var byUploaded = Model.VersionsColumn("uploaded", "Uploaded", descendingFirst: true);
                            }
                            <thead id="@byVersionNumber.Anchor">
                                <tr>
                                    <th scope="col"><partial name="_SortableHeader" model="byVersionNumber" /></th>
                                    <th scope="col"><partial name="_SortableHeader" model="byVersionFile" /></th>
                                    <th scope="col"><partial name="_SortableHeader" model="byUploaded" /></th>
                                    @if (!settled && Model.PaperVersions.Count > 1)
                                    {
                                        <th scope="col">Why you are removing it</th>
                                    }
                                    <th scope="col" class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Not re-sorted here: the API returns them in the order the reader
                                   asked the heading for, and sorting them again in the view would
                                   make every heading but Version look broken. *@
                                @foreach (var version in Model.PaperVersions)
                                {
                                    <tr>
                                        <td>@version.VersionNumber</td>
                                        <td>@version.FileName</td>
                                        <td class="text-nowrap">@version.UploadedAt.ToLocalTime().ToString("d MMM yyyy")</td>

                                        @* Not on the only one there is: every reviewer's screen
                                           offers the newest version, and with none there would be
                                           nothing to offer. *@
                                        @if (!settled && Model.PaperVersions.Count > 1)
                                        {
                                            <td>
                                                <form asp-action="RemovePaperVersion" method="post"
                                                      id="remove-version-form-@version.Id">
                                                    <input type="hidden" name="id" value="@Model.Container.Id" />
                                                    <input type="hidden" name="publicationId" value="@Model.Publication.Id" />
                                                    <input type="hidden" name="versionId" value="@version.Id" />
                                                    <input type="text" name="comments" class="form-control form-control-sm"
                                                           id="remove-version-@version.Id"
                                                           aria-label="Why you are removing version @version.VersionNumber"
                                                           placeholder="Required. Stays on the history." />
                                                </form>
                                            </td>
                                        }

                                        <td class="text-end text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-controller="Downloads" asp-action="Paper"
                                               asp-route-publicationId="@Model.Publication.Id"
                                               asp-route-versionId="@version.Id">Download</a>

                                            @if (!settled && Model.PaperVersions.Count > 1)
                                            {
                                                <button type="submit" form="remove-version-form-@version.Id"
                                                        class="btn btn-sm btn-outline-danger ms-1"
                                                        @DecisionButton.Attributes(true, $"remove-version-{version.Id}",
                                                            "Remove this version? The file goes with it and the paper does not move.",
                                                            "Say why this version is being removed.")>Remove</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (settled)
                {
                    <p class="text-secondary small mb-0 mt-3">
                        This paper has been accepted. Its versions are the record of what was
                        judged, so nothing is added to them or taken away from here.
                    </p>
                }
                else
                {
                    <form asp-action="AddPaperVersion" method="post" enctype="multipart/form-data"
                          class="row g-2 align-items-end mt-3 pt-3 border-top">
                        <input type="hidden" name="id" value="@Model.Container.Id" />
                        <input type="hidden" name="publicationId" value="@Model.Publication.Id" />
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="add-version">Add a version</label>
                            <input type="file" id="add-version" name="file" class="form-control" required />
                        </div>
                        <div class="col-12 col-md-5">
                            <input type="text" name="comments" id="add-version-comments" class="form-control"
                                   placeholder="Why you are adding it" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-outline-primary"
                                    @DecisionButton.Attributes(true, "add-version-comments",
                                        "Add this version? The paper does not move; set where it should stand below.",
                                        "Say why this version is being added.")>Add</button>
                        </div>
                    </form>
                }
            }
        </div>
    </div>

    @* The decision that actually unsticks people. Separate from everything above, because a
       document put right is no use while the stage still says whoever needed it has had their
       turn.

       Withdrawn once the paper has been accepted, like every other control on this screen. A
       publication whose paper has been judged is a record of that judgement, and moving it back to
       an earlier step would leave the record saying something the decision does not. *@
    @if (settled)
    {
        <div class="card">
            <div class="card-body">
                <h2 class="h3 mb-2">Where this publication stands</h2>
                <p class="text-secondary m-0">
                    This paper has been @(Model.Publication!.Status == "Published" ? "published" : "accepted"),
                    so where the publication stands is settled and is no longer something to change
                    from here. What it holds is the record of what was judged.
                </p>
            </div>
        </div>
    }
    else
    {
    <div class="card">
        <div class="card-body">
            <h2 class="h3 mb-2">Where this publication stands</h2>
            <p class="text-secondary">
                Which step it is waiting at, and so who picks it up next. Whoever that turns out to
                be is told. Marks that belong to steps after the one chosen are cleared, because
                otherwise it would land further on than you asked for.
            </p>

            <form asp-action="MovePublication" method="post" class="row g-3">
                <input type="hidden" name="id" value="@Model.Container.Id" />

                <div class="col-12 col-md-4">
                    <label class="form-label" for="move-stage">Stage</label>
                    <select id="move-stage" name="stage" class="form-select">
                        <option value="1" selected="@(Model.Container.CurrentPipeline == PipelineStage.ResearchProposals)">Research proposals</option>
                        <option value="2" selected="@(Model.Container.CurrentPipeline == PipelineStage.EthicsApproval)">Ethics approval</option>
                        <option value="3" selected="@(Model.Container.CurrentPipeline == PipelineStage.ResearchPaper)">Research paper</option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label" for="move-ethics">Ethics step</label>
                    <select id="move-ethics" name="ethicsStep" class="form-select">
                        <option value="">Leave as it is</option>
                        <option value="@EthicsSteps.SupervisorDecision">Supervisor: rule whether documentation is needed</option>
                        <option value="@EthicsSteps.CoordinatorConfirmation">Coordinator: confirm none is needed</option>
                        <option value="@EthicsSteps.StudentUpload">Student: upload the documents</option>
                        <option value="@EthicsSteps.SupervisorDocumentReview">Supervisor: read the documents</option>
                        <option value="@EthicsSteps.CoordinatorDocumentReview">Coordinator: approve the documents</option>
                        <option value="@EthicsSteps.HeadOfDepartmentReview">Head of Department: comment</option>
                        <option value="@EthicsSteps.CoordinatorFinalDecision">Coordinator: close the stage</option>
                    </select>
                    <small class="form-hint">Only applied on the ethics stage.</small>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label" for="move-paper">Paper status</label>
                    <select id="move-paper" name="paperStatus" class="form-select">
                        <option value="">Leave as it is</option>
                        <option value="Draft">Draft, with the student</option>
                        <option value="UnderReview">Under review</option>
                        <option value="RevisionsRequested">Sent back for revision</option>
                        <option value="Resubmitted">Resubmitted</option>
                        <option value="Accepted">Accepted</option>
                    </select>
                    <small class="form-hint">Only applied on the paper stage. Publishing stays the author's.</small>
                </div>

                <div class="col-12">
                    <label class="form-label" for="move-comments">Why this change</label>
                    <input type="text" id="move-comments" name="comments" class="form-control"
                           placeholder="Required. Stays on the publication&#x27;s history." />
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary"
                            @DecisionButton.Attributes(true, "move-comments",
                                "Move this publication? Whoever it then waits on is told, and marks belonging to later steps are cleared.",
                                "Say why this publication is being moved.")>Save where it stands</button>
                </div>
            </form>
        </div>
    </div>
    }
}
