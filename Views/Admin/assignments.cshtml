@model AssignmentsViewModel
@{
    ViewData["Title"] = "Assignments";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Assignments</h1>
    <div class="text-secondary">
        Who is carrying each publication that is still under way. Every step waits on somebody named
        here, so a coordinator who leaves or a supervisor who falls ill stops the publication until
        somebody else is named.
    </div>
</div>

@if (!Model.LoadFailed && (Model.Publications.Count > 0 || !string.IsNullOrWhiteSpace(Model.Search)))
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Admin" asp-action="assignments" class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student or publication" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    <a asp-controller="Admin" asp-action="assignments" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load them</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Admin" asp-action="assignments" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Publications.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">
                @(string.IsNullOrWhiteSpace(Model.Search) ? "Nothing under way" : $"Nothing matches “{Model.Search}”")
            </h3>
            <p class="text-secondary mb-4">
                @(string.IsNullOrWhiteSpace(Model.Search)
                    ? "Every publication has finished. Assignments can only be changed while one is still running."
                    : "No publication still running has that student or title.")
            </p>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "publication is" : "publications are") still
                running, @Model.Publications.Count on this page.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="assignment-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="assignment-cards">Collapse all</button>
        </div>
    </div>

    @foreach (var publication in Model.Publications)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#assignment-@publication.Id"
                 role="button" tabindex="0" aria-expanded="false" aria-controls="assignment-@publication.Id">
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>

                <div class="me-auto">
                    <h3 class="card-title m-0">@publication.DisplayTitle</h3>
                    <div class="text-secondary small">
                        @publication.StudentName
                        &middot; Coordinator: @publication.CoordinatorName
                        &middot; Supervisor: @(publication.AssignedSupervisorName ?? "none yet")
                    </div>
                </div>

                @* Whose turn it is, readable with the card shut: it is what decides whether a
                   stuck publication is stuck on the person being replaced. *@
                <span class="badge bg-primary-lt">@Humanise(publication.DisplayStatus)</span>
            </div>

            <div class="card-body collapse" id="assignment-@publication.Id" data-rpms-collapsible="assignment-cards">
                <form asp-controller="Admin" asp-action="Reassign" method="post">
                    <input type="hidden" name="id" value="@publication.Id" />
                    <input type="hidden" name="search" value="@Model.Search" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="coordinator-@publication.Id">Coordinator</label>
                            <select id="coordinator-@publication.Id" name="coordinatorUserId" class="form-select">
                                @foreach (var person in Model.Coordinators)
                                {
                                    <option value="@person.Id" selected="@(person.Id == publication.CoordinatorId)">
                                        @person.FirstName @person.LastName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" for="supervisor-@publication.Id">Supervisor</label>
                            @if (publication.AssignedSupervisorId is null)
                            {
                                @* Choosing the first supervisor settles which proposal goes ahead,
                                   which is the coordinator's decision and not an administrative
                                   fix. The API refuses it here for the same reason. *@
                                <input class="form-control" value="Appointed by the coordinator with a proposal" disabled />
                            }
                            else
                            {
                                <select id="supervisor-@publication.Id" name="supervisorUserId" class="form-select">
                                    @foreach (var person in Model.Supervisors)
                                    {
                                        <option value="@person.Id" selected="@(person.Id == publication.AssignedSupervisorId)">
                                            @person.FirstName @person.LastName
                                        </option>
                                    }
                                </select>
                            }
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="reassign-comments-@publication.Id">Why this change</label>
                            <input id="reassign-comments-@publication.Id" name="comments" class="form-control"
                                   placeholder="Required. Stays on the publication&#x27;s history." />
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary"
                                @DecisionButton.Attributes(true, $"reassign-comments-{publication.Id}",
                                    "Change who is responsible for this publication? Whoever now has the work is told, and the queues move with it.",
                                    "Say why these assignments are being changed. It stays on the publication&#x27;s history.")>
                            Save assignments
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
