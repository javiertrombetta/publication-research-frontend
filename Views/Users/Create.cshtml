@model CreateUserViewModel
@{
    ViewData["Title"] = "Create an account";
    var r = Model.Request;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">

        <div class="mb-4">
            <a asp-controller="Users" asp-action="Index" class="text-secondary text-decoration-none small">&larr; Users</a>
            <h1 class="page-title mt-2 mb-1">Create an account</h1>
            <div class="text-secondary">
                For people who won't sign themselves up. The account is created already verified and
                enabled, so it skips the email confirmation a self-registered account goes through.
            </div>
        </div>

        <form asp-controller="Users" asp-action="Create" method="post" class="card">
            <div class="card-body">
                <div class="row g-3">

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="firstName">First name</label>
                        <input id="firstName" name="FirstName" value="@r.FirstName" class="form-control" required />
                        <span asp-validation-for="Request.FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="lastName">Surname</label>
                        <input id="lastName" name="LastName" value="@r.LastName" class="form-control" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="email">Email address</label>
                        <input id="email" name="Email" type="email" value="@r.Email" class="form-control" required />
                        <span class="form-hint">
                            An @@ais.ac.nz or @@aisstudent.ac.nz address for institutional accounts.
                        </span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="role">Role</label>
                        <select id="role" name="Role" class="form-select" required>
                            <option value="">Choose a role</option>
                            @foreach (var role in CreateUserViewModel.Roles)
                            {
                                <option value="@role" selected="@(r.Role == role)">@Humanise(role)</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="institutionalId">Institutional ID</label>
                        <input id="institutionalId" name="InstitutionalId" value="@r.InstitutionalId" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="departmentId">Department</label>
                        <select id="departmentId" name="DepartmentId" class="form-select">
                            <option value="">No department</option>
                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.Id" selected="@(r.DepartmentId == department.Id)">@department.Name</option>
                            }
                        </select>
                        <span class="form-hint">Required for students and coordinators.</span>
                    </div>

                </div>

                @* Role-specific fields. Shown for every role rather than toggled: the backend
                   ignores the ones that don't apply, and hiding them behind JavaScript would make
                   the form depend on it. *@
                <h2 class="h3 mt-4 mb-2">If this is a student</h2>
                <div class="row g-3">
                    <div class="col-12 col-sm-4">
                        <label class="form-label" for="studentIdNumber">Student ID</label>
                        <input id="studentIdNumber" name="StudentIdNumber" value="@r.StudentIdNumber" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="form-label" for="programme">Programme</label>
                        <input id="programme" name="Programme" value="@r.Programme" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="form-label" for="cohort">Cohort</label>
                        <input id="cohort" name="Cohort" value="@r.Cohort" class="form-control" />
                    </div>
                </div>

                <h2 class="h3 mt-4 mb-2">If this is a supervisor</h2>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="areasOfExpertise">Areas of expertise</label>
                        <input id="areasOfExpertise" name="AreasOfExpertise" value="@r.AreasOfExpertise" class="form-control" />
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="researchInterests">Research interests</label>
                        <input id="researchInterests" name="ResearchInterests" value="@r.ResearchInterests" class="form-control" />
                    </div>
                </div>

                <h2 class="h3 mt-4 mb-2">If this is a committee member</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="affiliation">Affiliation</label>
                        <input id="affiliation" name="Affiliation" value="@r.Affiliation" class="form-control"
                               placeholder="The institution an external member comes from" />
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-controller="Users" asp-action="Index" class="btn btn-link text-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create the account</button>
            </div>
        </form>

    </div>
</div>
