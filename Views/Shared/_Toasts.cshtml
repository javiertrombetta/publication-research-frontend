@*
    Every message the app returns is shown here as a toast: flash messages a controller left in
    TempData, and any validation errors sitting in ModelState after a failed submit.

    A controller only has to set TempData["SuccessMessage"] / TempData["ErrorMessage"] or leave
    ModelState invalid — no view needs its own alert markup.

    The <template> copies at the bottom exist so client-side validation can raise the very same
    toast without a round trip, without a second copy of this markup living in site.js.
*@
@{
    var toasts = new List<(string Kind, IReadOnlyList<string> Messages)>();

    if (TempData["SuccessMessage"] is string success && !string.IsNullOrWhiteSpace(success))
    {
        toasts.Add(("success", new[] { success }));
    }

    if (TempData["ErrorMessage"] is string error && !string.IsNullOrWhiteSpace(error))
    {
        toasts.Add(("error", new[] { error }));
    }

    // Neither good news nor bad — something waiting to be read, such as unread notifications
    // on signing in. Kept distinct so it does not borrow the weight of a success or a failure.
    if (TempData["InfoMessage"] is string info && !string.IsNullOrWhiteSpace(info))
    {
        toasts.Add(("info", new[] { info }));
    }

    // Everything the model binder and the validators rejected, in one toast rather than a
    // stack of them. Distinct because a field error and the summary can carry the same text.
    var validationErrors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct()
        .ToList();

    if (validationErrors.Count > 0)
    {
        toasts.Add(("error", validationErrors));
    }

    // Local function so the server-rendered toasts and the client-side templates below are
    // guaranteed to be the same markup. A null message list renders the empty skeleton.
    void RenderToast(string kind, IReadOnlyList<string>? messages)
    {
        <div class="rpms-toast rpms-toast-@kind" data-toast-delay="@(kind == "error" ? 9000 : 5000)">
            <span class="rpms-toast-icon" aria-hidden="true">
                @if (kind == "success")
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M5 12l5 5l10 -10" />
                    </svg>
                }
                else if (kind == "info")
                {
                    @* A bell, because this kind is what announces notifications. *@
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3l1 2h-14l1-2v-3a7 7 0 0 1 4-6" />
                        <path d="M9 18a3 3 0 0 0 6 0" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                        <path d="M12 3l9 17H3z" />
                    </svg>
                }
            </span>

            <div class="rpms-toast-body">
                @if (messages is null)
                {
                    @* Skeleton — the client fills this in. *@
                }
                else if (messages.Count == 1)
                {
                    @messages[0]
                }
                else
                {
                    <div class="rpms-toast-lead">Please check the following:</div>
                    <ul class="rpms-toast-list">
                        @foreach (var message in messages)
                        {
                            <li>@message</li>
                        }
                    </ul>
                }
            </div>

            <button type="button" class="rpms-toast-close" aria-label="Dismiss notification">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M18 6l-12 12" />
                    <path d="M6 6l12 12" />
                </svg>
            </button>
        </div>
    }
}

@* Always rendered, even when empty: the container is where client-side toasts are appended,
   and a live region is only announced reliably if it was in the document beforehand. *@
<div class="rpms-toasts" role="region" aria-live="polite" aria-atomic="false">
    @foreach (var (kind, messages) in toasts)
    {
        RenderToast(kind, messages);
    }
</div>

@* Written out one by one rather than looped. A <template> inside a Razor code block — which is
   what the body of a @@foreach is — fails to compile: the parser does not close the element and
   the whole file falls apart. At markup level it is fine, and there are only three kinds. *@
<template class="rpms-toast-template" data-toast-kind="success">
    @{ RenderToast("success", null); }
</template>

<template class="rpms-toast-template" data-toast-kind="error">
    @{ RenderToast("error", null); }
</template>

<template class="rpms-toast-template" data-toast-kind="info">
    @{ RenderToast("info", null); }
</template>
