@model int
@{
    var hasUnread = Model > 0;

    // Beyond a couple of dozen the exact figure stops meaning anything and starts breaking the
    // badge, so it reads "9+" instead.
    var badge = Model > 9 ? "9+" : Model.ToString();

    var label = hasUnread
        ? $"Notifications, {Model} unread"
        : "Notifications";
}

<a asp-controller="Notifications" asp-action="Index"
   class="btn btn-icon btn-ghost-secondary rpms-bell @(hasUnread ? "rpms-bell-unread" : "")"
   title="@label" aria-label="@label">

    <svg xmlns="http://www.w3.org/2000/svg"
         class="icon"
         width="24"
         height="24"
         viewBox="0 0 24 24"
         stroke-width="2"
         stroke="currentColor"
         fill="none"
         stroke-linecap="round"
         stroke-linejoin="round">

        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3l1 2h-14l1-2v-3a7 7 0 0 1 4-6" />
        <path d="M9 18a3 3 0 0 0 6 0" />

    </svg>

    @if (hasUnread)
    {
        @* aria-hidden because the count is already in the link's own label; announcing it twice
           makes the bell read as two separate things. *@
        <span class="rpms-bell-count" aria-hidden="true">@badge</span>
    }
</a>
