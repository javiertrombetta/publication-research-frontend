@using ResearchPublicationManagementSystem.Common
@{
    var (homeController, homeAction) = RoleLanding.For(User);

    var isStudent = User.IsInRole(RoleNames.Student);
    var isAdmin = User.IsInRole(RoleNames.Admin);

    // Mirrors the [Authorize(Roles = ...)] on each controller, so the menu never offers a
    // link that would just bounce the user to Access denied.
    var canSeeProposals = isAdmin
        || User.IsInRole(RoleNames.HeadOfDepartment)
        || User.IsInRole(RoleNames.Coordinator)
        || User.IsInRole(RoleNames.Supervisor);

    var canSeePublications = canSeeProposals
        || User.IsInRole(RoleNames.InternalCommitteeMember)
        || User.IsInRole(RoleNames.ExternalCommitteeMember);
}

@* The AIS brand lives in the top bar (see _Navbar), not here. *@
<aside class="border-end bg-white rpms-sidebar" id="rpms-sidebar">

    @* Fixed-width inner panel: keeps the nav from reflowing (and labels from wrapping) while
       the sidebar animates open/closed — it is clipped instead. See .rpms-sidebar-inner. *@
    <div class="p-4 rpms-sidebar-inner">

        <nav class="nav flex-column">

            @* Label matches the heading of the page it opens. *@
            <a asp-controller="@homeController" asp-action="@homeAction" class="nav-link">
                @(isStudent ? "My publications" : canSeePublications ? "Dashboard" : "My account")
            </a>

            @if (canSeeProposals)
            {
                <a asp-controller="Proposals" asp-action="Index" class="nav-link">Proposals</a>
            }

            @if (canSeePublications)
            {
                <a asp-controller="Publications" asp-action="Index" class="nav-link">Publications</a>
            }

            @if (isAdmin)
            {
                <a asp-controller="Users" asp-action="Index" class="nav-link">Users</a>
                <a asp-controller="Categories" asp-action="Index" class="nav-link">Categories</a>
                <a asp-controller="SystemSettings" asp-action="Index" class="nav-link">System settings</a>
                <a asp-controller="AuditLogs" asp-action="Index" class="nav-link">Audit log</a>
            }

            <a asp-controller="Public" asp-action="public_catalogue" class="nav-link">Public catalogue</a>

        </nav>

    </div>

    @* Privacy Policy / Contact IT live in the page footer (see _Footer), not here. *@

</aside>
