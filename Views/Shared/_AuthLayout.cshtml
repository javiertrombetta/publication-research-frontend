@*
    Layout for the signed-out screens (login, signup, password recovery/reset, email
    verification, access denied). Deliberately does NOT use Tabler's .page/.page-wrapper/
    .page-body classes. Those are built for the sidebar dashboard shell and set flex:1 on
    the body element, which stretches the content area and pins content to the top instead
    of centering it.
*@
<!DOCTYPE html>
<html lang="en" data-bs-theme="@ResearchPublicationManagementSystem.Services.SiteTheme.For(Context)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Research Publication Management System</title>

    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="rpms-auth-body">

    @* Same .rpms-navbar as the signed-in shell, so the bar is exactly as tall here as it is
       everywhere else, see the fixed height in site.css. *@
    <header class="navbar navbar-expand-md d-print-none rpms-navbar">
        <div class="container-fluid px-3 d-flex align-items-center">
            <div class="d-flex align-items-center">
                @* This layout is only ever shown signed out, so the brand goes where a signed-out
                   visitor belongs, the public catalogue, not back to the page they're on. *@
                <a asp-controller="@RoleLanding.Anonymous.Controller" asp-action="@RoleLanding.Anonymous.Action"
                   class="navbar-brand m-0 p-0 d-flex align-items-center">
                    @* Two sheets of the same mark. The lettering is black, which disappears against a dark
                       bar, so the dark theme gets the same mark drawn in white. Both are in the markup and
                       the CSS shows whichever matches, the way the theme switch itself works. *@
                    <img src="~/images/ais-logo.png" class="rpms-navbar-logo rpms-logo-light"
                         alt="Auckland Institute of Studies" />
                    <img src="~/images/ais-logo-dark.png" class="rpms-navbar-logo rpms-logo-dark"
                         alt="Auckland Institute of Studies" />
                </a>
            </div>

            @* Signing in, signing up and recovering a password are all read before there is an
               account, and somebody who prefers a dark screen prefers it here too. The same
               control the signed-in menu carries, in the only place there is room for it. *@
            <div class="ms-auto">
                <partial name="_ThemeSwitch" model="@("button")" />
            </div>
        </div>
    </header>

    <main class="rpms-auth-main">
        <div class="container-xl py-4">
            @RenderBody()
        </div>
    </main>

    <partial name="_Footer" />

    <partial name="_Toasts" />

    <script src="~/lib/tabler/dist/js/tabler.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    @* Needed here too: it drives the toasts above (the sidebar part simply no-ops on these pages). *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
