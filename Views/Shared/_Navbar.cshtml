@using System.Security.Claims
@using ResearchPublicationManagementSystem.Common
@using ResearchPublicationManagementSystem.Services
@{
    var firstName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? "";
    var lastName = User.FindFirst(ClaimTypes.Surname)?.Value ?? "";
    var fullName = $"{firstName} {lastName}".Trim();
    var initials = $"{firstName.FirstOrDefault()}{lastName.FirstOrDefault()}".Trim();
    var isStudent = User.IsInRole(RoleNames.Student);
    var hasPhoto = User.FindFirst(AuthClaimTypes.HasProfilePhoto)?.Value == "true";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var (homeController, homeAction) = RoleLanding.For(User);

    // Set by pages rendered without a sidebar, where the burger would toggle nothing.
    var hasSidebar = ViewData["HideSidebar"] as bool? != true;
}

<header class="navbar navbar-expand-md d-print-none shadow-sm rpms-navbar">

    <div class="container-fluid px-3">

        <!-- Left Side -->
        <div class="d-flex align-items-center">

            @if (hasSidebar)
            {
                <!-- Sidebar toggle (wired in site.js) -->
                <button class="btn btn-icon btn-ghost-secondary me-2"
                        type="button"
                        id="sidebar-toggle"
                        aria-label="Toggle sidebar"
                        aria-controls="rpms-sidebar"
                        aria-expanded="true">

                    @* Two marks, one shown at a time, because the control is two different things
                       depending on the width. In the bar on a phone it is a menu button, and three
                       bars is what a menu button looks like. On a wide screen it has left the bar
                       and sits on the panel's edge, where it is a handle: an arrow that points the
                       way the panel is about to move says more than a menu icon would, and asks for
                       far less room. See .rpms-toggle-* in site.css. *@
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="icon rpms-toggle-bars"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 6h16" />
                        <path d="M4 12h16" />
                        <path d="M4 18h16" />

                    </svg>

                    @* One arrow, pointing the way the panel is about to go: left to shut it, and
                       turned to the right once it is shut, to bring it back. *@
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="icon rpms-toggle-chevron"
                         width="18"
                         height="18"
                         viewBox="0 0 24 24"
                         stroke-width="2.5"
                         stroke="currentColor"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M15 6l-6 6l6 6" />

                    </svg>

                </button>
            }

            <!-- Brand: sized to the navbar, so it never drives the bar's height -->
            <a asp-controller="@homeController" asp-action="@homeAction" class="navbar-brand m-0 p-0 d-flex align-items-center">
                @* Two sheets of the same mark. The lettering is black, which disappears against a dark
                   bar, so the dark theme gets the same mark drawn in white. Both are in the markup and
                   the CSS shows whichever matches, the way the theme switch itself works. *@
                <img src="~/images/ais-logo.png" class="rpms-navbar-logo rpms-logo-light"
                     alt="Auckland Institute of Studies" />
                <img src="~/images/ais-logo-dark.png" class="rpms-navbar-logo rpms-logo-dark"
                     alt="Auckland Institute of Studies" />
            </a>

        </div>

        <!-- Right Side -->
        @* Defence in depth: every route now requires authentication, but if a page is ever
           opened to anonymous visitors this keeps the user menu (and its Logout) hidden. *@
        @if (!isAuthenticated)
        {
            <div class="navbar-nav flex-row order-md-last align-items-center gap-2">
                @* Sign in first: it is what a visitor came to the bar for, and the one thing here
                   that takes them somewhere. The theme sits after it, where a preference belongs
                   rather than in front of the way in. It is offered at all because the catalogue
                   is read by people with no account, and how a page looks is not something to hold
                   behind one. *@
                <a asp-controller="Auth" asp-action="home" class="btn btn-primary">Sign in</a>
                <partial name="_ThemeSwitch" model="@("button")" />
            </div>
        }
        else
        {
        <div class="navbar-nav flex-row order-md-last">

            <!-- Notifications -->
            @* A view component, so the unread count is right on every page rather than only on
               the ones whose controller remembered to fetch it. *@
            <div class="nav-item me-3">
                @await Component.InvokeAsync("NotificationBell")
            </div>

            <!-- User menu -->
            <div class="nav-item dropdown">

                <a href="#"
                   class="nav-link d-flex align-items-center px-2"
                   data-bs-toggle="dropdown"
                   role="button"
                   aria-expanded="false">

                    @if (hasPhoto)
                    {
                        <span class="avatar avatar-sm border rpms-avatar-photo"
                              style="background-image: url('@Url.Action("Photo", "Profile")')"></span>
                    }
                    else
                    {
                        <span class="avatar avatar-sm border bg-primary-lt fw-bold">@initials</span>
                    }

                    <span class="d-none d-md-block ps-2">
                        @fullName
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="icon icon-sm ms-1"
                             width="16"
                             height="16"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             fill="none"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M6 9l6 6l6 -6" />
                        </svg>
                    </span>

                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    @if (isStudent)
                    {
                        <a class="dropdown-item" asp-controller="Student" asp-action="studentprofile">
                            My Profile
                        </a>
                    }
                    else
                    {
                        <a class="dropdown-item" asp-controller="Profile" asp-action="Me">
                            My Profile
                        </a>
                    }

                    @* Every role has a password, so this sits outside the Student branch above. *@
                    <a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword">
                        Change Password
                    </a>

                    @* Between Change Password and Logout. Signed out the same control is a
                       button in the header instead, see the branch above. *@
                    <partial name="_ThemeSwitch" model="@("item")" />

                    <div class="dropdown-divider"></div>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="dropdown-item text-danger">
                            Logout
                        </button>
                    </form>

                </div>

            </div>

        </div>
        }

    </div>

</header>
