@using System.Security.Claims
@using ResearchPublicationManagementSystem.Common
@using ResearchPublicationManagementSystem.Services
@{
    var firstName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? "";
    var lastName = User.FindFirst(ClaimTypes.Surname)?.Value ?? "";
    var fullName = $"{firstName} {lastName}".Trim();
    var initials = $"{firstName.FirstOrDefault()}{lastName.FirstOrDefault()}".Trim();
    var isStudent = User.IsInRole(RoleNames.Student);
    var hasPhoto = User.FindFirst(AuthClaimTypes.HasProfilePhoto)?.Value == "true";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var (homeController, homeAction) = RoleLanding.For(User);

    // Set by pages rendered without a sidebar, where the burger would toggle nothing.
    var hasSidebar = ViewData["HideSidebar"] as bool? != true;
}

<header class="navbar navbar-expand-md d-print-none shadow-sm rpms-navbar">

    <div class="container-fluid px-3">

        <!-- Left Side -->
        <div class="d-flex align-items-center">

            @if (hasSidebar)
            {
                <!-- Sidebar toggle (wired in site.js) -->
                <button class="btn btn-icon btn-ghost-secondary me-2"
                        type="button"
                        id="sidebar-toggle"
                        aria-label="Toggle sidebar"
                        aria-controls="rpms-sidebar"
                        aria-expanded="true">

                    @* Three bars in both states. Only the button behind them changes: filled when
                       the sidebar is closed, transparent when it is open, see #sidebar-toggle
                       in site.css. *@
                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="icon rpms-burger"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         stroke-width="2"
                         stroke="currentColor"
                         fill="none"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 6h16" />
                        <path d="M4 12h16" />
                        <path d="M4 18h16" />

                    </svg>

                </button>
            }

            <!-- Brand: sized to the navbar, so it never drives the bar's height -->
            <a asp-controller="@homeController" asp-action="@homeAction" class="navbar-brand m-0 p-0 d-flex align-items-center">
                <img src="~/images/ais-logo.png" class="rpms-navbar-logo" alt="Auckland Institute of Studies" />
            </a>

        </div>

        <!-- Right Side -->
        @* Defence in depth: every route now requires authentication, but if a page is ever
           opened to anonymous visitors this keeps the user menu (and its Logout) hidden. *@
        @if (!isAuthenticated)
        {
            <div class="navbar-nav flex-row order-md-last">
                <a asp-controller="Auth" asp-action="home" class="btn btn-primary">Sign in</a>
            </div>
        }
        else
        {
        <div class="navbar-nav flex-row order-md-last">

            <!-- Notifications -->
            @* A view component, so the unread count is right on every page rather than only on
               the ones whose controller remembered to fetch it. *@
            <div class="nav-item me-3">
                @await Component.InvokeAsync("NotificationBell")
            </div>

            <!-- User menu -->
            <div class="nav-item dropdown">

                <a href="#"
                   class="nav-link d-flex align-items-center px-2"
                   data-bs-toggle="dropdown"
                   role="button"
                   aria-expanded="false">

                    @if (hasPhoto)
                    {
                        <span class="avatar avatar-sm border rpms-avatar-photo"
                              style="background-image: url('@Url.Action("Photo", "Profile")')"></span>
                    }
                    else
                    {
                        <span class="avatar avatar-sm border bg-primary-lt fw-bold">@initials</span>
                    }

                    <span class="d-none d-md-block ps-2">
                        @fullName
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="icon icon-sm ms-1"
                             width="16"
                             height="16"
                             viewBox="0 0 24 24"
                             stroke-width="2"
                             stroke="currentColor"
                             fill="none"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M6 9l6 6l6 -6" />
                        </svg>
                    </span>

                </a>

                <div class="dropdown-menu dropdown-menu-end">

                    @if (isStudent)
                    {
                        <a class="dropdown-item" asp-controller="Student" asp-action="studentprofile">
                            My Profile
                        </a>
                    }
                    else
                    {
                        <a class="dropdown-item" asp-controller="Profile" asp-action="Me">
                            My Profile
                        </a>
                    }

                    @* Every role has a password, so this sits outside the Student branch above. *@
                    <a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword">
                        Change Password
                    </a>

                    @* The theme switch. A form rather than a link because it changes something,
                       and it comes back to the page it was pressed on so nobody is moved off what
                       they were reading.

                       Both faces are rendered and the CSS shows whichever matches the theme in
                       force. That is what lets the switch flip instantly without a reload: the
                       script changes one attribute on <html> and this label and icon follow, with
                       no second request to wait for and nothing to swap by hand. *@
                    @{
                        var currentTheme = ResearchPublicationManagementSystem.Services.SiteTheme.For(Context);
                        var otherTheme = ResearchPublicationManagementSystem.Services.SiteTheme.Opposite(currentTheme);
                        var here = $"{Context.Request.Path}{Context.Request.QueryString}";
                    }
                    <form asp-controller="Theme" asp-action="Set" method="post" class="m-0" data-rpms-theme-form>
                        <input type="hidden" name="theme" value="@otherTheme" />
                        <input type="hidden" name="returnUrl" value="@here" />
                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                            @* Shown while the light theme is in force: pressing this goes dark. *@
                            <span class="rpms-when-light d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18"
                                     viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
                                </svg>
                                Dark theme
                            </span>

                            <span class="rpms-when-dark d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="18" height="18"
                                     viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                                    <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
                                </svg>
                                Light theme
                            </span>
                        </button>
                    </form>

                    <div class="dropdown-divider"></div>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="dropdown-item text-danger">
                            Logout
                        </button>
                    </form>

                </div>

            </div>

        </div>
        }

    </div>

</header>
