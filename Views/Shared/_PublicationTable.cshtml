@model IEnumerable<ResearchPublicationManagementSystem.Models.PublicationListItemViewModel>

<div class="table-responsive">

    <table class="table table-hover align-middle mb-0">

        <thead class="table-light">

            <tr>
                <th>Publication ID</th>
                <th>Publication Title</th>
                <th>Student</th>
                <th>Supervisor</th>
                <th>Committee</th>
                <th>Research Area</th>
                <th>Status</th>
                <th>Submitted Date</th>
                <th>Last Updated</th>
                <th class="text-center">Actions</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.PublicationId</td>

                    <td>@item.Title</td>

                    <td>@item.Student</td>

                    <td>@item.Supervisor</td>

                    <td>

                        @if (item.CommitteeMembers.Any())
                        {
                            foreach (var member in item.CommitteeMembers)
                            {
                                <div>@member</div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Not Assigned</span>
                        }

                    </td>

                    <td>@item.ResearchArea</td>

                    <td>

                        @switch (item.Status)
                        {
                            case "Pending Committee Assignment":
                                <span class="badge rounded-pill bg-warning text-dark">
                                    @item.Status
                                </span>
                                break;

                            case "Under Review":
                                <span class="badge rounded-pill bg-info text-dark">
                                    @item.Status
                                </span>
                                break;

                            case "Approved":
                                <span class="badge rounded-pill bg-success">
                                    @item.Status
                                </span>
                                break;

                            case "Rejected":
                                <span class="badge rounded-pill bg-danger">
                                    @item.Status
                                </span>
                                break;

                            default:
                                <span class="badge rounded-pill bg-secondary">
                                    @item.Status
                                </span>
                                break;
                        }

                    </td>

                    <td>@item.SubmittedDate</td>

                    <td>@item.LastUpdated</td>

                    <td class="text-center">

                        <a href="#"
                           class="btn btn-sm btn-outline-secondary me-1 mb-1">

                            <i class="ti ti-eye me-1"></i>
                            View

                        </a>

                        <br />

                        @if (!item.CommitteeMembers.Any())
                        {
                            <a href="#"
                               class="btn btn-sm btn-primary">

                                <i class="ti ti-users-group me-1"></i>
                                Assign Committee

                            </a>
                        }
                        else
                        {
                            <a href="#"
                               class="btn btn-sm btn-warning text-dark">

                                <i class="ti ti-refresh me-1"></i>
                                Reassign Committee<br />
                                Member

                            </a>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>