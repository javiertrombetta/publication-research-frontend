@using ResearchPublicationManagementSystem.Services
@inject IInstitutionDetails Institution
@{
    var institution = await Institution.GetAsync();
    var itSupportEmail = institution.ItSupportEmail;
}

@* Shared by _Layout (signed in) and _AuthLayout (signed out) so both stay identical. *@
<footer class="footer rpms-footer border-top text-muted d-print-none">
    <div class="container-fluid px-4 rpms-footer-grid">

        <div class="rpms-footer-credit text-secondary">
            Made with
            @* Filled rather than outlined, and the brand red rather than the muted text around
               it: it is the one thing in this line that is not a fact about the institution. *@
            <svg xmlns="http://www.w3.org/2000/svg"
                 class="icon rpms-footer-heart"
                 width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 stroke="none"
                 fill="currentColor">
                <path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z" />
            </svg>
            by LKT
        </div>

        <div class="text-center">
            &copy; @DateTime.Now.Year @institution.Name. All rights reserved.
        </div>

        <div class="rpms-footer-links">
            @* Plain text until an address is set under System settings, since a mailto: to a
               made-up address would look like it works and quietly lose whatever was sent. *@
            @if (string.IsNullOrWhiteSpace(itSupportEmail))
            {
                <span class="text-secondary me-3" title="An IT support address has not been set up yet">
                    Contact IT
                </span>
            }
            else
            {
                <a href="mailto:@itSupportEmail" class="text-secondary text-decoration-none me-3">
                    Contact IT
                </a>
            }

            <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">
                Privacy Policy
            </a>
        </div>

    </div>
</footer>
