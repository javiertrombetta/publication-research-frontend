@using ResearchPublicationManagementSystem.Services
@inject IInstitutionDetails Institution
@{
    var institution = await Institution.GetAsync();
    var itSupportEmail = institution.ItSupportEmail;
}

@* Shared by _Layout (signed in) and _AuthLayout (signed out) so both stay identical. *@
@* No text-muted: Tabler declares that one !important, in a grey picked against a white page, and
   it came to 3.5 against the dark one. The colour comes from .rpms-footer, which has a value for
   each theme. *@
<footer class="footer rpms-footer border-top d-print-none">
    <div class="container-fluid px-4 rpms-footer-grid">

        @* To people with an account always, and to visitors only if the institution has said so
           under System settings. Its own students and staff are who a university IT desk supports,
           and an address on a page open to the world is an address that will be scraped, so the
           setting starts off. The column is left standing either way so the copyright does not
           move. *@
        <div class="rpms-footer-start">
            @if (User.Identity?.IsAuthenticated == true || institution.ItSupportShownToVisitors)
            {
                @* Plain text until an address is set under System settings, since a mailto: to a
                   made-up address would look like it works and quietly lose whatever was sent. *@
                if (string.IsNullOrWhiteSpace(itSupportEmail))
                {
                    <span class="text-secondary" title="An IT support address has not been set up yet">
                        Contact IT
                    </span>
                }
                else if (User.Identity?.IsAuthenticated == true && institution.ItSupportReachableThroughTheSite)
                {
                    @* A form on the site, where a screenshot can be attached and the desk can reply
                       to the person who wrote. Only with a mail server configured, because without
                       one the form would take a message and lose it, and only to somebody signed
                       in: a form open to the world that emails files to a fixed address is a relay
                       for whoever finds it. A visitor gets the mailto: below, as they always have. *@
                    <a asp-controller="Support" asp-action="ContactIt"
                       asp-route-returnUrl="@Context.Request.Path.Value"
                       class="text-secondary text-decoration-none">
                        Contact IT
                    </a>
                }
                else
                {
                    <a href="mailto:@itSupportEmail" class="text-secondary text-decoration-none">
                        Contact IT
                    </a>
                }
            }
        </div>

        <div class="text-center rpms-footer-copyright">
            &copy; @DateTime.Now.Year @institution.Name. All rights reserved.
        </div>

        <div class="rpms-footer-links">
            <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">
                Privacy Policy
            </a>
        </div>

    </div>
</footer>
