@using Microsoft.Extensions.Options
@using ResearchPublicationManagementSystem.Infrastructure.Options
@inject IOptions<InstitutionOptions> Institution
@{
    var itSupportEmail = Institution.Value.ItSupportEmail;
}

@* Shared by _Layout (signed in) and _AuthLayout (signed out) so both stay identical. *@
<footer class="footer rpms-footer border-top bg-light text-muted d-print-none">
    <div class="container-fluid px-4 rpms-footer-grid">

        <div class="rpms-footer-links">
            <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none me-3">
                Privacy Policy
            </a>

            @* The IT address hasn't been decided yet. Until Institution:ItSupportEmail is set this
               stays plain text — a mailto: to a made-up address would look like it works and
               quietly lose whatever anyone sent to it. *@
            @if (string.IsNullOrWhiteSpace(itSupportEmail))
            {
                <span class="text-secondary" title="An IT support address has not been set up yet">
                    Contact IT
                </span>
            }
            else
            {
                <a href="mailto:@itSupportEmail" class="text-secondary text-decoration-none">
                    Contact IT
                </a>
            }
        </div>

        <div class="text-center">
            &copy; @DateTime.Now.Year Auckland Institute of Studies. All rights reserved.
        </div>

        @* Empty third column so the copyright stays optically centred on the page,
           not just centred in whatever space the links leave over. *@
        <div aria-hidden="true"></div>

    </div>
</footer>
