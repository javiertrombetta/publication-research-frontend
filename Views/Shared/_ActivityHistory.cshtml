@model IReadOnlyList<ResearchPublicationManagementSystem.Infrastructure.Api.Dto.ActivityHistoryEntryDto>
@*
    A publication's narrative history: every action taken on it, by whom and in what capacity,
    with the comment that justified it. The backend records the same log for every role, so this
    partial is shared — each role's container view renders it as its own tab.

    Newest first, as the backend returns it: the latest decision is what someone comes here to
    read, and the rest is the chronology behind it.
*@
@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing has happened yet</h3>
            <p class="text-secondary m-0">
                Every action taken on this publication — by the student, the coordinator, the
                supervisor or the committee — will be recorded here with its comment.
            </p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <ul class="timeline">
                @foreach (var entry in Model)
                {
                    <li class="timeline-event">
                        <div class="timeline-event-icon @(entry.NewStatus is null ? "bg-secondary-lt" : "bg-primary-lt")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M8 9h8" />
                                <path d="M8 13h6" />
                                <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z" />
                            </svg>
                        </div>

                        <div class="card timeline-event-card">
                            <div class="card-body">
                                <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-1">
                                    <h4 class="m-0">@Humanise(entry.Action)</h4>
                                    <div class="text-secondary small">
                                        @entry.CreatedAt.ToLocalTime().ToString("dd MMM yyyy 'at' HH:mm")
                                    </div>
                                </div>

                                <div class="text-secondary mb-2">
                                    @entry.ActorName
                                    @if (!string.IsNullOrWhiteSpace(entry.ActorRole))
                                    {
                                        <span class="badge bg-secondary-lt ms-1">@Humanise(entry.ActorRole)</span>
                                    }
                                    @* Recorded when someone acted in another role's place, e.g. an Admin
                                       standing in for a coordinator. Worth surfacing, not burying. *@
                                    @if (!string.IsNullOrWhiteSpace(entry.OnBehalfOfName))
                                    {
                                        <text>&middot; on behalf of <strong>@entry.OnBehalfOfName</strong></text>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(entry.Comments))
                                {
                                    <p class="m-0">@entry.Comments</p>
                                }

                                @if (entry.NewStatus is not null)
                                {
                                    <div class="mt-2">
                                        @* Both sides of the transition are coloured by what they are —
                                           the arrow already says which one came first. *@
                                        @if (entry.PreviousStatus is not null)
                                        {
                                            <span class="badge @StatusBadge(entry.PreviousStatus)">@Humanise(entry.PreviousStatus)</span>
                                            <span class="text-secondary mx-1">&rarr;</span>
                                        }
                                        <span class="badge @StatusBadge(entry.NewStatus)">@Humanise(entry.NewStatus)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
}
