@using ResearchPublicationManagementSystem.Common
@inject ResearchPublicationManagementSystem.Services.ICommitteeEligibility CommitteeEligibility
@{
    var (homeController, homeAction) = RoleLanding.For(User);

    var isStudent = User.IsInRole(RoleNames.Student);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isCoordinator = User.IsInRole(RoleNames.Coordinator);
    var isSupervisor = User.IsInRole(RoleNames.Supervisor);
    var isHeadOfDepartment = User.IsInRole(RoleNames.HeadOfDepartment);

    // Reviewers and external members do the same job and share the same screens.
    var isCommitteeMember = User.IsInRole(RoleNames.Reviewer)
        || User.IsInRole(RoleNames.ExternalCommitteeMember);

    // Asked rather than worked out from roles. Which roles committees are drawn from is an
    // administrator's choice and they can leave individuals out, so a fixed list of roles here
    // would offer the screen to people who will never have anything on it, and hide it from
    // somebody the administrator had just added. The answer is cached for a minute, so this is not
    // a request per page. Somebody already sitting on a committee always keeps the way in.
    var canEvaluate = await CommitteeEligibility.IsCandidateAsync(User);

    // Whether this person has a dashboard of their own to land on, as opposed to only a profile.
    var hasDashboard = isAdmin
        || isCoordinator
        || isSupervisor
        || isCommitteeMember
        || User.IsInRole(RoleNames.HeadOfDepartment);

    // Which screen is open, taken from the route rather than the URL text so that a link and the
    // page it opens are compared on the same terms, casing and query strings included.
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

@functions {
    /// <summary>
    /// "nav-link", plus "active" when this link is the page being looked at. Marked server-side
    /// so the open item is styled in the first paint rather than after a script has run.
    /// </summary>
    string NavClass(string? currentController, string? currentAction, string controller, string action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "nav-link active"
            : "nav-link";
}

@* The AIS brand lives in the top bar (see _Navbar), not here. *@
@* No bg-white: that utility pins the colour, which left the sidebar bright white in
   the dark theme. The background comes from .rpms-sidebar, which reads the theme. *@
<aside class="border-end rpms-sidebar" id="rpms-sidebar">

    @* Fixed-width inner panel: keeps the nav from reflowing (and labels from wrapping) while
       the sidebar animates open/closed. It is clipped instead. See .rpms-sidebar-inner. *@
    <div class="p-4 rpms-sidebar-inner">

        <nav class="nav flex-column rpms-nav">

            @* The pill that travels between items on a click, so the menu answers before the next
               page arrives. It is invisible and idle the rest of the time: the open item's own
               background is painted by CSS from the first frame, which is what a reader without
               JavaScript gets and what stops the sidebar changing appearance on every load. *@
            <span class="rpms-nav-marker" aria-hidden="true"></span>

            @* Label matches the heading of the page it opens. *@
            <a asp-controller="@homeController" asp-action="@homeAction"
               class="@NavClass(currentController, currentAction, homeController, homeAction)">
                @(isStudent ? "My publications" : hasDashboard ? "Dashboard" : "My account")
            </a>

            @* The coordinator's two proposal tasks are separate screens because they are separate
               decisions: sending proposals out, and assigning the supervisor who accepted one. *@
            @if (isCoordinator)
            {
                <a asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor" class="@NavClass(currentController, currentAction, "Coordinator", "assigning_proposal_forsupervisor")">
                    Send proposals
                </a>
                <a asp-controller="Coordinator" asp-action="select_a_proposal_forstudent" class="@NavClass(currentController, currentAction, "Coordinator", "select_a_proposal_forstudent")">
                    Supervisor selections
                </a>
                <a asp-controller="Coordinator" asp-action="Ethic_review_aftersupervisor" class="@NavClass(currentController, currentAction, "Coordinator", "Ethic_review_aftersupervisor")">
                    Ethics decisions
                </a>
                <a asp-controller="Coordinator" asp-action="Evaluation_after_committee" class="@NavClass(currentController, currentAction, "Coordinator", "Evaluation_after_committee")">
                    Papers to decide
                </a>
            }

            @* The supervisor's three queues, one per stage they take part in: the proposal, the
               ethics decision and the paper. Ethics used to be reachable only from the dashboard,
               which meant the one stage they cannot skip had no screen of its own. *@
            @if (isSupervisor)
            {
                <a asp-controller="Supervisor" asp-action="proposal_review" class="@NavClass(currentController, currentAction, "Supervisor", "proposal_review")">
                    Proposals sent to me
                </a>
                <a asp-controller="Supervisor" asp-action="Ethic_reviews" class="@NavClass(currentController, currentAction, "Supervisor", "Ethic_reviews")">
                    Ethics reviews
                </a>
                <a asp-controller="Supervisor" asp-action="publication_review" class="@NavClass(currentController, currentAction, "Supervisor", "publication_review")">
                    Papers to review
                </a>
            }

            @* The Head of Department has one decision, the ethics comment, and oversight of all
               three stages. They are not an administrator: this is one department, and being its
               authority is what makes watching every stage of it theirs to do even where the next
               move belongs to somebody else. One entry per stage, in the order work moves. *@
            @if (isHeadOfDepartment)
            {
                <a asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent" class="@NavClass(currentController, currentAction, "HeadOfDepartment", "all_proposals_fromstudent")">
                    Department proposals
                </a>
                <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback" class="@NavClass(currentController, currentAction, "HeadOfDepartment", "Headofdepartment_feedback")">
                    Ethics reviews
                </a>
                <a asp-controller="HeadOfDepartment" asp-action="Department_papers" class="@NavClass(currentController, currentAction, "HeadOfDepartment", "Department_papers")">
                    Department papers
                </a>
            }

            @if (canEvaluate)
            {
                <a asp-controller="ExternalSupervisor" asp-action="committee_review" class="@NavClass(currentController, currentAction, "ExternalSupervisor", "committee_review")">
                    Papers to evaluate
                </a>
            }

            @if (isAdmin)
            {
                <a asp-controller="Admin" asp-action="assigning_committee_members" class="@NavClass(currentController, currentAction, "Admin", "assigning_committee_members")">
                    Assign committees
                </a>
                <a asp-controller="Admin" asp-action="supervisor_groups" class="@NavClass(currentController, currentAction, "Admin", "supervisor_groups")">
                    Supervisor groups
                </a>
                <a asp-controller="Users" asp-action="Index" class="@NavClass(currentController, currentAction, "Users", "Index")">Users</a>
                <a asp-controller="Invitations" asp-action="Index" class="@NavClass(currentController, currentAction, "Invitations", "Index")">Invitations</a>
                <a asp-controller="SystemSettings" asp-action="Index" class="@NavClass(currentController, currentAction, "SystemSettings", "Index")">System settings</a>
                <a asp-controller="AuditLogs" asp-action="Index" class="@NavClass(currentController, currentAction, "AuditLogs", "Index")">Audit log</a>
            }

            @* Shown whatever the public-catalogue setting says. That setting governs what the
               world sees, not what the institution can see of its own published work, and if it
               were hidden here too, a student's decision to publish would have no visible effect
               anywhere, which would make that step of the process meaningless. *@
            <a asp-controller="Public" asp-action="public_catalogue" class="@NavClass(currentController, currentAction, "Public", "public_catalogue")">Public catalogue</a>

        </nav>

    </div>

    @* Privacy Policy / Contact IT live in the page footer (see _Footer), not here. *@

</aside>
