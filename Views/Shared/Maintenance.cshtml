@{
    ViewData["Title"] = "Temporarily unavailable";

    // The signed-out shell: there is nothing to navigate to while the service behind every screen
    // is unreachable, and a sidebar of links that all lead here would be a cruel joke.
    Layout = "_AuthLayout";
}

<div class="card card-md">
    <div class="card-body text-center py-5">

        <h1 class="h2 mb-3">The site is temporarily unavailable</h1>

        <p class="text-secondary mb-1">
            We can't reach the service that this page depends on. This usually means an update is
            being deployed, and it normally takes a minute or two.
        </p>

        <p class="text-secondary mb-4">
            Nothing you were working on has been lost.
        </p>

        <button type="button" class="btn btn-primary" id="rpms-try-again">
            Try again
        </button>

    </div>
</div>

<script nonce="@Context.ScriptNonceValue()">
    document.getElementById('rpms-try-again')
        ?.addEventListener('click', function () { window.location.reload(); });
</script>
