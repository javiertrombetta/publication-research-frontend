@model SortableColumnViewModel

@* A heading that is also the control for ordering by it. The arrow only appears on the column
   actually in use, so the header row does not read as a row of buttons.

   Ordering is a fresh request, and a fresh request arrives at the top of the document, so the
   reader who clicked a heading half way down a page was thrown above the heading, the cards and
   the search and had to come back. The link points at its own listing's head, named after the
   key this column writes, because a screen with two listings has two of them. *@
<a class="rpms-sort @(Model.IsActive ? "rpms-sort-active" : "")"
   asp-controller="@Model.Controller" asp-action="@Model.Action"
   asp-all-route-data="Model.RouteValuesForToggle()"
   asp-fragment="@Model.Anchor"
   aria-sort="@(Model.IsActive ? (Model.CurrentDescending ? "descending" : "ascending") : "none")"
   title="@(Model.IsActive
            ? (Model.CurrentDescending ? $"Sorted by {Model.Label}, highest first. Click to reverse." : $"Sorted by {Model.Label}, lowest first. Click to reverse.")
            : $"Sort by {Model.Label}")">
    @Model.Label

    @* Always rendered, hidden until this is the column being sorted by. Drawn only when active it
       would make the heading an icon wider the moment somebody clicked it, and a table sizes its
       columns from their content, so every other column would shift to make room. *@
    <svg xmlns="http://www.w3.org/2000/svg"
         class="icon rpms-sort-icon @(Model.IsActive ? "" : "rpms-sort-icon-idle")"
         width="16" height="16" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"
         fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        @if (Model.IsActive && Model.CurrentDescending)
        {
            <path d="M6 9l6 6l6 -6" />
        }
        else
        {
            <path d="M6 15l6 -6l6 6" />
        }
    </svg>
</a>
