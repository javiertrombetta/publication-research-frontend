@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model CommitteeDashboardViewModel
@{
    ViewData["Title"] = "Committee dashboard";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Committee dashboard</h1>
    <div class="text-secondary">
        @* Counted across everything assigned to this person, not across the page on screen. *@
        @(Model.AwaitingTotal == 0
            ? "Nothing is waiting on your decision."
            : Model.AwaitingTotal == 1
                ? "One paper is waiting on your decision."
                : $"{Model.AwaitingTotal} papers are waiting on your decision.")
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your assignments</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="ExternalSupervisor" asp-action="External_Supervisor_Dashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0 && !Model.HasSearch)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">You have no assignments</h3>
            <p class="text-secondary m-0">
                Papers appear here once an Administrator puts you on an evaluation committee.
            </p>
        </div>
    </div>
}
else
{
    <div class="row row-cards mb-4">
        <div class="col-12 col-md-6">
            <div class="card h-100 @(Model.AwaitingTotal > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Awaiting your decision</div>
                    <div class="h1 m-0">@Model.AwaitingTotal</div>
                    @if (Model.AwaitingTotal > 0)
                    {
                        <a asp-controller="ExternalSupervisor" asp-action="committee_review"
                           class="btn btn-primary btn-sm mt-3">Review them</a>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">Already decided</div>
                    @* Everything assigned to this person, never the search: the cards above the
                       listing count what they have been given, and the listing counts itself. *@
                    <div class="h1 m-0">@Model.DecidedTotal</div>
                    <div class="text-secondary">papers you have voted on</div>
                </div>
            </div>
        </div>
    </div>

    @* The same search the listing beside this one carries, applied by the API so it covers
       everything assigned to this person rather than the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="ExternalSupervisor" asp-action="External_Supervisor_Dashboard"
                  class="row g-2 align-items-center">

                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by paper or student" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    <a asp-controller="ExternalSupervisor" asp-action="External_Supervisor_Dashboard"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "paper matches" : "papers match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>

    @* Built here rather than inline: a tag helper's model attribute is delimited by double quotes,
       so a call with string arguments cannot be written inside one. Ordering is applied by the API,
       so a heading orders everything assigned to this person rather than the rows on this page. *@
    var byTitle = Model.Column("title", "Paper");
    var byStudent = Model.Column("student", "Student");
    var byCommittee = Model.Column("committee", "Committee");
    var byDecision = Model.Column("decision", "Your decision");

    if (Model.Items.Count == 0)
    {
        @* A search that found nothing is a different thing from an empty queue. *@
        <div class="card">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">Nothing matches that search</h3>
                <p class="text-secondary mb-4">Try part of a paper's title, or the student's name.</p>
                <a asp-controller="ExternalSupervisor" asp-action="External_Supervisor_Dashboard"
                   asp-all-route-data="Model.ClearSearchRoute()" class="btn btn-outline-secondary">Clear the search</a>
            </div>
        </div>
    }
    else
    {
    <div class="card">
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th><partial name="_SortableHeader" model="byTitle" /></th>
                        <th><partial name="_SortableHeader" model="byStudent" /></th>
                        <th><partial name="_SortableHeader" model="byCommittee" /></th>
                        <th><partial name="_SortableHeader" model="byDecision" /></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td class="text-nowrap">@(item.Paper?.StudentName ?? "—")</td>
                            <td>
                                @* Coloured here, not through the shared mapping: for a committee
                                   "Assigned" means not started, the opposite of what it means for
                                   a proposal. *@
                                <span class="badge @(item.Committee.Status == CommitteeStatus.Completed ? "bg-success-lt" : "bg-blue-lt")">
                                    @Humanise(item.Committee.Status)
                                </span>
                            </td>
                            <td>
                                @if (item.Me is null)
                                {
                                    <span class="text-secondary">&mdash;</span>
                                }
                                else
                                {
                                    <span class="badge @StatusBadge(item.Me.Decision)">@Humanise(item.Me.Decision)</span>
                                }
                            </td>
                            <td>
                                @if (!item.HasDecided)
                                {
                                    <a asp-controller="ExternalSupervisor" asp-action="committee_review"
                                       asp-route-id="@item.Committee.Id" class="btn btn-sm btn-primary">Review</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
    }
}
