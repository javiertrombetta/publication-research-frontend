@model CommitteeDashboardViewModel
@{
    ViewData["Title"] = "Committee review";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Committee review</h1>
    <div class="text-secondary">
        Papers you have been asked to evaluate. Your decision and comments are recorded against
        the paper and read by the coordinator before they accept it.
    </div>
</div>

@* Search and order are applied by the API, so they cover everything assigned to this person
   rather than the page in hand. The same controls the other reviewer queues carry. *@
@if (!Model.LoadFailed && (Model.AwaitingMe.Count > 0 || Model.HasSearch))
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="ExternalSupervisor" asp-action="committee_review"
                  class="row g-2 align-items-center">

                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by paper or student" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    <a asp-controller="ExternalSupervisor" asp-action="committee_review"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

                @{
                    var byDate = Model.Column("submitted", "Date", descendingFirst: true);
                    var byStudent = Model.Column("student", "Student");
                    var byTitle = Model.Column("title", "Paper");
                }
                <div class="col-12 col-md-auto ms-md-auto d-flex align-items-center gap-3">
                    <span class="text-secondary small">Sort by</span>
                    <partial name="_SortableHeader" model="byDate" />
                    <partial name="_SortableHeader" model="byStudent" />
                    <partial name="_SortableHeader" model="byTitle" />
                </div>
            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "paper matches" : "papers match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your assignments</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="ExternalSupervisor" asp-action="committee_review" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.AwaitingMe.Count == 0 && Model.HasSearch)
{
    @* A search that found nothing is a different thing from an empty queue. *@
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h3>
            <p class="text-secondary mb-4">No paper waiting on you has that title or student.</p>
            <a asp-controller="ExternalSupervisor" asp-action="committee_review" class="btn btn-primary">
                Show them all
            </a>
        </div>
    </div>
}
else if (Model.AwaitingMe.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">You have decided on every paper assigned to you.</p>
            <a asp-controller="ExternalSupervisor" asp-action="External_Supervisor_Dashboard" class="btn btn-primary">
                Back to dashboard
            </a>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.AwaitingMe.Count</strong>
                @(Model.AwaitingMe.Count == 1 ? "paper" : "papers") waiting on you,
                of @Model.TotalCount assigned.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="evaluation-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="evaluation-cards">Collapse all</button>
        </div>
    </div>

    @foreach (var item in Model.AwaitingMe)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#evaluation-@item.Committee.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="evaluation-@item.Committee.Id">
                @* Part of the header rather than a control of its own, so clicking it does not
                   leave an icon looking selected in the middle of a row. *@
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>

                <div class="me-auto">
                    <h3 class="card-title m-0">@item.Title</h3>
                    @* Whose paper it is, beside the year. The queue searches and orders by the
                       student and named nobody. *@
                    @if (!string.IsNullOrWhiteSpace(item.Paper?.StudentName) || item.Paper?.PublicationYear is not null)
                    {
                        <div class="text-secondary small">
                            @if (!string.IsNullOrWhiteSpace(item.Paper?.StudentName))
                            {
                                <span>@item.Paper.StudentName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Paper?.StudentName) && item.Paper?.PublicationYear is not null)
                            {
                                <span class="mx-1">&middot;</span>
                            }
                            @if (item.Paper?.PublicationYear is not null)
                            {
                                <span>@item.Paper.PublicationYear</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card-body collapse show" id="evaluation-@item.Committee.Id"
                 data-rpms-collapsible="evaluation-cards">
                @if (item.Paper is null)
                {
                    <p class="text-secondary">
                        This paper could not be loaded. You can still record a decision, but please
                        read it first.
                    </p>
                }
                else
                {
                    <p class="rpms-preserve-lines">@item.Paper.Abstract</p>

                    <div class="mb-3">
                        <a class="btn btn-outline-primary btn-sm"
                           asp-controller="Downloads" asp-action="Paper" asp-route-publicationId="@item.Paper.Id">
                            Download the paper
                        </a>
                    </div>

                    @if (item.Paper.Keywords.Count > 0)
                    {
                        <div class="mb-3">
                            @foreach (var keyword in item.Paper.Keywords)
                            {
                                <span class="badge bg-secondary-lt me-1">@keyword</span>
                            }
                        </div>
                    }
                }

                @* Deliberately no list of other members' votes: a committee member decides on the
                   paper, not on what their colleagues have already said. *@
                <div class="text-secondary small mb-3">
                    This committee needs @item.Committee.MinApprovalsRequired
                    @(item.Committee.MinApprovalsRequired == 1 ? "approval" : "approvals") to pass.
                </div>

                <form asp-controller="ExternalSupervisor" asp-action="SubmitDecision" method="post">
                    <input type="hidden" name="committeeId" value="@item.Committee.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="review-@item.Committee.Id">Your comments</label>
                        <textarea id="review-@item.Committee.Id" name="comments" rows="3" class="form-control"
                                  placeholder="Your assessment of the paper" required></textarea>
                    </div>
                    <div class="btn-list">
                        <button type="submit" name="approve" value="true" class="btn btn-primary">Approve</button>
                        <button type="submit" name="approve" value="false" class="btn btn-outline-danger">Do not approve</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
