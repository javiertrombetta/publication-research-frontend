@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<div class="container container-tight">

    <div class="card card-md">
        <div class="card-body">
            <h1 class="h2 text-center mb-3">Forgot Password</h1>
            <p class="text-secondary text-center mb-4">
                Enter your email address to receive a password reset link.
            </p>

            @if (ViewData["Submitted"] is true)
            {
                <div class="alert alert-success mb-0">
                    If that address is registered, a reset link has been sent. Check your inbox.
                </div>
            }
            else
            {

                <form asp-controller="Auth" asp-action="passwordrecovery" method="post" autocomplete="off" novalidate>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary w-100">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mail-forward me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M12 18h-7a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v7.5" />
                                <path d="M3 6l9 6l9 -6" />
                                <path d="M15 18h6" />
                                <path d="M18 15l3 3l-3 3" />
                            </svg>
                            Send me a reset password link
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="text-center text-secondary mt-3">
        <a asp-controller="Auth" asp-action="home">Back to sign in</a>
    </div>

</div>
