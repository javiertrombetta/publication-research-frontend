@model LoginViewModel
@inject ResearchPublicationManagementSystem.Services.IInstitutionDetails Institution
@{
    var selfRegistrationOpen = (await Institution.GetAsync()).SelfRegistrationOpen;
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<div class="container container-tight">

    <div class="card card-md">
        <div class="card-body">
            <h2 class="h2 text-center mb-4">Sign in to your account</h2>


            <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" autocomplete="off" novalidate>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Password" class="form-label d-flex justify-content-between align-items-center">
                        <span>Password</span>
                        <span class="form-label-description font-weight-normal fs-5">
                            <a asp-controller="Auth" asp-action="passwordrecovery">I forgot password</a>
                        </span>
                    </label>
                    <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <span class="form-check-label">Remember me on this device</span>
                    </label>
                </div>

                <div class="form-footer">
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </div>
            </form>
        </div>
    </div>

    @* Offered only when self-registration is open. Elsewhere the link would lead straight to
       "accounts here are by invitation", which is a dead end dressed up as an invitation — and
       someone who has been invited arrives with a link, so they need telling nothing here. *@
    @if (selfRegistrationOpen)
    {
        <div class="text-center text-secondary mt-3">
            <span>Don't have an account yet? <a asp-controller="Auth" asp-action="signup" tabindex="-1">Sign up</a></span>
        </div>
    }

</div>
