@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify email";
    var success = ViewData["Success"] is true;
    var message = ViewData["Message"] as string;
}

<div class="container container-tight">

    <div class="card card-md">
        <div class="card-body text-center">
            <h2 class="h2 mb-3">@(success ? "Email verified" : "Verification failed")</h2>
            <div class="alert @(success ? "alert-success" : "alert-danger")">@message</div>
            <a asp-controller="Auth" asp-action="home" class="btn btn-primary">Go to sign in</a>
        </div>
    </div>

</div>
