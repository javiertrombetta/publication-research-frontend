@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your email";
}

<div class="container container-tight">

    <div class="card card-md">
        <div class="card-body text-center">
            <h2 class="h2 mb-3">Check your email</h2>
            <p class="text-secondary mb-4">
                We've sent a verification link to the address you registered with.
                Follow it to activate your account, then sign in.
            </p>
            <a asp-controller="Auth" asp-action="home" class="btn btn-primary">Back to sign in</a>
        </div>
    </div>

</div>
