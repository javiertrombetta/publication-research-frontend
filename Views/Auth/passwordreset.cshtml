@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
}

<div class="container container-tight">

    <div class="card card-md">
        <div class="card-body py-4 px-4">
            <h1 class="h2 text-center mb-4">Reset Password</h1>


            @if (string.IsNullOrEmpty(Model.Token))
            {
                <div class="alert alert-warning mb-0">
                    This reset link is missing or invalid. Request a new one from the
                    <a asp-controller="Auth" asp-action="passwordrecovery">forgot password</a> page.
                </div>
            }
            else
            {
                <form asp-controller="Auth" asp-action="passwordreset" method="post" autocomplete="off" novalidate>
                    <input asp-for="Email" type="hidden" />
                    <input asp-for="Token" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label mb-2">Enter a new password</label>
                        <input asp-for="NewPassword" class="form-control" placeholder="At least 10 characters" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label mb-2">Confirm the password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter the new password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-footer mt-2">
                        <button type="submit" class="btn btn-primary w-100 py-2 fs-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-lock-check me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M11.5 21h-4.5a2 2 0 0 1 -2 -2v-6a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v.5" />
                                <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" />
                                <path d="M8 11v-4a4 4 0 1 1 8 0v4" />
                                <path d="M15 19l2 2l4 -4" />
                            </svg>
                            Update my password
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

</div>
