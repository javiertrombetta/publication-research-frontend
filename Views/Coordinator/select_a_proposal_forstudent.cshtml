@model SupervisorSelectionsViewModel
@{
    ViewData["Title"] = "Supervisor selections";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Supervisor selections</h1>
    <div class="text-secondary">
        Proposals a supervisor has offered to take on. Assigning one settles the student's
        proposal stage and opens their ethics declaration.
    </div>
</div>

@* Search and order are applied by the API, so they cover the whole queue rather than the page in
   hand, and both live in the query string so a filtered view can be linked to and reloaded.

   One box for three names. Somebody looking for a row remembers the student, or the proposal, or
   the supervisor who offered, and separate boxes would make them decide which of those they were
   remembering before they could start typing. *@
@if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.HasSearch))
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Coordinator" asp-action="select_a_proposal_forstudent"
                  class="row g-2 align-items-center">

                @* The order survives a search, so narrowing the list does not silently reorder it. *@
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student, proposal or supervisor" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="Coordinator" asp-action="select_a_proposal_forstudent"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

                @{
                    // Built here rather than inline: a tag helper's model attribute is delimited by
                    // double quotes, so a call with string arguments cannot be written inside one.
                    var byDate = Model.Column("submitted", "Date", descendingFirst: true);
                    var byStudent = Model.Column("student", "Student");
                    var byTitle = Model.Column("title", "Proposal");
                }
                <div class="col-12 col-md-auto ms-md-auto d-flex align-items-center gap-3">
                    <span class="text-secondary small">Sort by</span>
                    <partial name="_SortableHeader" model="byDate" />
                    <partial name="_SortableHeader" model="byStudent" />
                    <partial name="_SortableHeader" model="byTitle" />
                </div>
            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "proposal matches" : "proposals match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load the selections</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="select_a_proposal_forstudent" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0 && Model.HasSearch)
{
    @* A search that found nothing is a different thing from an empty queue, and offering "back to
       dashboard" here would be answering a question nobody asked. *@
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h3>
            <p class="text-secondary mb-4">
                No proposal waiting on you has that student, title or supervisor.
            </p>
            <a asp-controller="Coordinator" asp-action="select_a_proposal_forstudent" class="btn btn-primary">
                Show them all
            </a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing to assign yet</h3>
            <p class="text-secondary mb-4">
                No supervisor has offered to take a proposal on so far. They appear here as replies come in.
            </p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    @* One control for the lot. A queue of thirty proposals, each with its abstract and its list of
       replies, is a long scroll; shutting them all and opening the one being worked on turns it
       back into a list. The counts are here rather than on the buttons because what a coordinator
       needs to know first is how much is waiting, not that a control exists. *@
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            @* The total in bold: it is the figure a coordinator is actually reading, and the
               page count is context for it rather than a second number of equal weight. Matches
               how the same line reads on Send proposals. *@
            <span class="text-secondary me-auto">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "proposal" : "proposals") waiting on you,
                @Model.Items.Count on this page.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="selection-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="selection-cards">Collapse all</button>
        </div>
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#selection-@item.Proposal.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="selection-@item.Proposal.Id">
                @* Part of the header rather than a control of its own. As a button it
                   took focus and stayed looking pressed after a click, which read as a
                   selected icon sitting in the middle of a row. The header carries the
                   role and the keyboard handling now, so this is only the arrow. *@
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>

                <div class="me-auto">
                    <h3 class="card-title m-0">@item.Proposal.Title</h3>
                    <div class="text-secondary small">@item.StudentName</div>
                </div>

                @* Readable with the card shut, because it is what decides whether to open it. *@
                @if (item.RespondBy is { } by)
                {
                    <span class="badge @(item.RespondByHasPassed ? "bg-warning-lt" : "bg-secondary-lt")"
                          title="@(item.RespondByHasPassed
                                   ? "The date supervisors had to answer by has passed"
                                   : "Supervisors have until this date to answer")">
                        @(item.RespondByHasPassed ? "Was due" : "Due") @by.ToString("d MMM, HH:mm")
                    </span>
                }
                <span class="badge bg-primary-lt">
                    @item.Willing.Count() willing
                </span>
            </div>

            <div class="card-body collapse show" id="selection-@item.Proposal.Id"
                 data-rpms-collapsible="selection-cards">
                <p class="text-secondary">@item.Proposal.Abstract</p>

                <h4 class="mt-3 mb-2">Willing to supervise</h4>
                <form asp-controller="Coordinator" asp-action="AssignSupervisor" method="post">
                    <input type="hidden" name="proposalId" value="@item.Proposal.Id" />

                    @foreach (var invitation in item.Willing)
                    {
                        <label class="form-selectgroup-item d-block mb-2">
                            <input type="radio" name="supervisorId" value="@invitation.SupervisorId"
                                   class="form-check-input me-2" required />
                            <strong>@invitation.SupervisorName</strong>
                            @if (!string.IsNullOrWhiteSpace(invitation.Comments))
                            {
                                <span class="d-block text-secondary small ms-4">&ldquo;@invitation.Comments&rdquo;</span>
                            }
                        </label>
                    }

                    <div class="mt-3">
                        <label class="form-label" for="assign-comments-@item.Proposal.Id">Comments</label>
                        <textarea id="assign-comments-@item.Proposal.Id" name="comments" rows="2"
                                  class="form-control"
                                  placeholder="Why this supervisor, or why none of them"></textarea>
                    </div>

                    <div class="btn-list mt-3">
                        <button type="submit" class="btn btn-primary">Assign this supervisor</button>

                        @* Belongs to the form below rather than this one, so the radio this form
                           requires does not stand in the way of turning every offer down. One
                           comments box serves both: the coordinator is writing down a decision,
                           and which decision it was is what the button says. *@
                        <button type="submit" form="discard-@item.Proposal.Id"
                                class="btn btn-outline-danger"
                                data-rpms-needs-comments="assign-comments-@item.Proposal.Id"
                                data-rpms-needs-comments-message="Say why you are turning these offers down. It is the only record of the decision."
                                data-rpms-confirm="Turn down every offer on this proposal? It goes back to Send proposals, and the supervisors who replied lose it from their list.">
                            Discard these offers
                        </button>
                    </div>
                </form>

                @* Its own form, a sibling rather than a child: HTML has no nested forms, and this
                   one carries no radio, so it can be submitted when none is chosen. *@
                <form id="discard-@item.Proposal.Id" class="d-none"
                      asp-controller="Coordinator" asp-action="DiscardSelections" method="post"
                      data-rpms-comments-from="#assign-comments-@item.Proposal.Id">
                    <input type="hidden" name="proposalId" value="@item.Proposal.Id" />
                    <input type="hidden" name="comments" />
                </form>

                @* Shown so the coordinator can see who has not replied before assigning. *@
                @if (item.AwaitingReply.Any())
                {
                    <div class="text-secondary small mt-3">
                        Still to reply: @string.Join(", ", item.AwaitingReply.Select(i => i.SupervisorName))
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
