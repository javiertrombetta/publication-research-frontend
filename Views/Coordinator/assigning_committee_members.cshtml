                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Frame 2: Add Committee Member -->
        <div class="border rounded-3 p-3 mb-4 bg-light shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                <div class="bg-success text-white p-2 rounded-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-user-plus" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                        <path d="M16 19h6" />
