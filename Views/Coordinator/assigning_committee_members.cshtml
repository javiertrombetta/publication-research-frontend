                            <div class="text-dark fw-bold fs-4 lh-base">
                                An Analysis of Smart Home Cryptographic Vulnerabilities in Edge Computing Environments
                            </div>
                        </div>

                        <hr class="my-3 opacity-10" />

                        <div class="row g-3">
                            <!-- Left Column -->
                            <div class="col-md-6 pe-md-3">
                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Student Name</label>
                                    <div class="text-dark fw-bold fs-6">Alex Chen</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Supervisor</label>
                                    <div class="text-dark fs-6">Dr. [Supervisor Name]</div>
                                </div>

                                <div>
                                    <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Date Submitted</label>
