                            </div>

                            <!-- Right Column -->
                            <div class="col-md-6 ps-md-3 border-start-md">
                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Student ID</label>
                                    <div class="text-dark font-monospace fs-6">STU-2026-8941</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Publication ID</label>
                                    <div class="text-dark font-monospace fs-6">123456789</div>
                                </div>

                                <div>
                                    <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Research Category</label>
                                    <div class="text-dark fs-6">IT</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Abstract Card -->
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-primary text-white p-4">
                        <h3 class="card-title fs-2 fw-bold text-white mb-0">Abstract</h3>
                    </div>

                    <div class="card-body p-4">
                        <p class="text-secondary lh-lg m-0" style="text-align: justify; font-size: 0.95rem;">
                            This research proposal outlines a comprehensive security evaluation of public and private
                            key infrastructure deployed across modern IoT smart home frameworks. By analyzing potential
                            edge execution nodes, the study aims to identify cryptographic latency trade-offs alongside
                            physical and data-driven security configurations. The experimental design relies entirely on
                            simulated machine states and open-source protocol packages.
                        </p>
                    </div>
                </div>

                <!-- 3. Committee Assignment Management Card -->
                <!-- 3. Committee Assignment Management Card -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-primary text-white p-4">
        <h3 class="card-title fs-2 fw-bold text-white mb-0">Committee Management</h3>
    </div>

    <div class="card-body p-4">

        <!-- Frame 1: Assigned Committee Members -->
        <div class="border rounded-3 p-3 mb-4 bg-white shadow-sm">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
