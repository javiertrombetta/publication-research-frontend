                    </svg>
                </div>
                <h4 class="fw-bold text-dark m-0 fs-4">Add Committee Member</h4>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark mb-1">Department</label>
                    <select class="form-select text-dark bg-white" name="new_member_dept">
                        <option value="it" selected>IT</option>
                        <option value="business">Business</option>
                        <option value="english">English</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark mb-1">Select Faculty Member</label>
                    <select class="form-select text-dark bg-white" name="new_member_id">
                        <option value="" disabled selected hidden>Choose a faculty member to add...</option>
                        <option value="3">Dr. Elena Rostova (Data Privacy &amp; Machine States)</option>
                        <option value="4">Dr. James Vance (Network Protocols &amp; Security Infrastructures)</option>
                        <option value="5">Prof. Alan Turing (Applied Cryptography)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-success w-100 fw-bold">+ Add Member</button>
                </div>
            </div>
        </div>

        <!-- Section C: Assignment Notes -->
        <div class="mb-4">
            <h4 class="fw-bold text-dark mb-2">Assignment Notes</h4>
            <label class="form-label text-secondary small fw-bold text-uppercase mb-1">Note from Coordinator,Admin (Optional)</label>
            <textarea class="form-control text-dark" name="assignment_notes" rows="3" placeholder="Add optional comments regarding workload balancing, expertise matching, or committee approval criteria..."></textarea>
        </div>

