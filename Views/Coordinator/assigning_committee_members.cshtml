                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Dr. Sarah Jenkins</div>
                                <div class="text-secondary small">s.jenkins@university.edu</div>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary fw-bold">Head of Department</span></td>
                            <td class="text-secondary">IT</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger">Remove</button>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Prof. Michael Fowler</div>
                                <div class="text-secondary small">m.fowler@university.edu</div>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary fw-bold">Supervisor</span></td>
                            <td class="text-secondary">IT</td>
                            <td class="text-end">
