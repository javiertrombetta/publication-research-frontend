@model CoordinatorPapersViewModel
@{
    ViewData["Title"] = "Research papers to decide on";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Research papers to decide on</h1>
    <div class="text-secondary">
        Every research paper in your department that is still moving. Accepting one hands the
        publication decision to its author.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load the papers</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="Evaluation_after_committee" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.IsEmpty)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">Papers appear here once a student submits one.</p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    @* No heading over this list. The bar under the search already says how many are waiting, and
       a title saying the same thing above it made this screen start differently from every other
       queue in the application.

       The second list keeps its heading, because that one marks where a different list begins. *@

    @* Its own search and its own order, with its own query keys, because the two lists on this
       screen are read independently: narrowing one must not narrow or reorder the other. Both are
       applied by the API, so they cover the whole list rather than the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Coordinator" asp-action="Evaluation_after_committee"
                  class="row g-2 align-items-center">
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />
                <input type="hidden" name="progressSort" value="@Model.ProgressSort" />
                <input type="hidden" name="progressDesc" value="@Model.ProgressDescending.ToString().ToLowerInvariant()" />
                <input type="hidden" name="progressSearch" value="@Model.ProgressSearch" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student, paper or abstract" aria-label="Search papers ready for decision" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Clears this list's term only. The two lists are read independently, so
                       widening one must leave the other narrowed as it was, and both keep the
                       order they were in. *@
                    <a asp-controller="Coordinator" asp-action="Evaluation_after_committee"
                       asp-all-route-data="Model.ClearDecisionSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

                @{ var decisionSort = Model.DecisionSortBar; }
                <partial name="_SortInline" model="decisionSort" />
            </form>
        </div>
    </div>


    @if (Model.ReadyForDecision.Count == 0)
    {
        <div class="card mb-4">
            <div class="card-body text-secondary">
                Nothing is waiting on you right now. The papers below are still with somebody else.
            </div>
        </div>
    }

    @if (Model.ReadyForDecision.Count > 0)
    {
        @* One control for the lot, as on Supervisor selections. Each paper carries its abstract and
           every review recorded against it, so a queue of them is a long scroll. *@
        <div class="card mb-3">
            <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
                <span class="text-secondary me-auto">
                    <strong>@Model.DecisionTotal</strong> @(Model.DecisionTotal == 1 ? "paper" : "papers") waiting on you,
                    @Model.ReadyForDecision.Count on this page.
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-expand-all="paper-cards">Expand all</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-collapse-all="paper-cards">Collapse all</button>
            </div>
        </div>
    }

    @foreach (var item in Model.ReadyForDecision)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#paper-@item.Paper.Id">
                <button class="btn btn-icon btn-sm btn-ghost-secondary" type="button"
                        data-bs-toggle="collapse" data-bs-target="#paper-@item.Paper.Id"
                        aria-expanded="true" aria-controls="paper-@item.Paper.Id"
                        aria-label="Show or hide this paper">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </button>

                <div class="me-auto">
                    <h3 class="card-title m-0">@item.Paper.Title</h3>
                    <div class="text-secondary small">@item.Container.StudentName</div>
                </div>

                @* Readable with the card shut, because it is what decides whether to open it: a
                   paper with no reviews on record is not one the coordinator can rule on. *@
                <span class="badge bg-primary-lt">
                    @item.Reviews.Count @(item.Reviews.Count == 1 ? "review" : "reviews")
                </span>
            </div>

            <div class="card-body collapse show" id="paper-@item.Paper.Id"
                 data-rpms-collapsible="paper-cards">
                <p class="text-secondary rpms-preserve-lines">@item.Paper.Abstract</p>

                <h4 class="mt-3 mb-2">Reviews so far</h4>
                @if (item.Reviews.Count == 0)
                {
                    @* The backend refuses the final decision until the committee has finished, so
                       an empty list here means the paper isn't actually ready yet. *@
                    <p class="text-secondary">
                        No reviews have been recorded yet. The evaluation committee has to complete
                        its review before this decision can be made.
                    </p>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table card-table table-vcenter" data-rpms-sortable-table>
                            <thead>
                                <tr><th data-rpms-sort-column="0">Reviewer</th><th data-rpms-sort-column="1">Role</th><th data-rpms-sort-column="2">Decision</th><th data-rpms-sort-column="3">Comments</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var review in item.Reviews)
                                {
                                    <tr>
                                        <td>@review.ReviewerName</td>
                                        <td>@Humanise(review.ReviewerType)</td>
                                        <td><span class="badge @StatusBadge(review.Decision)">@Humanise(review.Decision)</span></td>
                                        <td>@review.Comments</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-controller="Coordinator" asp-action="DecideOnPaper" method="post">
                    <input type="hidden" name="publicationId" value="@item.Paper.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="paper-comments-@item.Paper.Id">Comments</label>
                        <textarea id="paper-comments-@item.Paper.Id" name="comments" rows="2" class="form-control"
                                  placeholder="Your decision and why"></textarea>
                    </div>
                    <div class="btn-list">
                        <button type="submit" name="accept" value="true" class="btn btn-primary">Accept the paper</button>
                        <button type="submit" name="accept" value="false" class="btn btn-outline-danger">Send back for revision</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.DecisionPager is not null)
    {
        <partial name="_Pager" model="Model.DecisionPager" />
    }

    @if (Model.InProgress.Count > 0 || Model.HasProgressSearch)
    {
        <h2 class="h3 mt-4 mb-1">
            Still in progress
            <span class="badge bg-secondary-lt ms-1">@Model.ProgressTotal</span>
        </h2>
        <p class="text-secondary mb-3">
            Not yours to decide yet. Shown so you can see where each one has got to, and chase
            anything that has stopped moving.
        </p>

        <div class="card mb-3">
            <div class="card-body py-3">
                <form method="get" asp-controller="Coordinator" asp-action="Evaluation_after_committee"
                      class="row g-2 align-items-center">
                    <input type="hidden" name="sort" value="@Model.Sort" />
                    <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="search" value="@Model.Search" />
                    <input type="hidden" name="progressSort" value="@Model.ProgressSort" />
                    <input type="hidden" name="progressDesc" value="@Model.ProgressDescending.ToString().ToLowerInvariant()" />

                    <div class="col-12 col-md">
                        <input type="search" name="progressSearch" value="@Model.ProgressSearch" class="form-control"
                               placeholder="Search by student or paper" aria-label="Search papers in progress" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-secondary">Search</button>
                    </div>
                    <div class="col-auto">
                        <a asp-controller="Coordinator" asp-action="Evaluation_after_committee"
                           asp-all-route-data="Model.ClearProgressSearchRoute()"
                           class="btn btn-outline-secondary">Clear</a>
                    </div>

                    @{ var progressSort = Model.ProgressSortBar; }
                    <partial name="_SortInline" model="progressSort" />
                </form>
            </div>
        </div>


        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter" data-rpms-sortable-table>
                    <thead>
                        <tr><th data-rpms-sort-column="0">Paper</th><th data-rpms-sort-column="1">Author</th><th data-rpms-sort-column="2">Waiting on</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InProgress)
                        {
                            <tr>
                                <td>@(item.Container.Title ?? "Untitled paper")</td>
                                <td class="text-secondary">@item.Container.StudentName</td>
                                <td class="text-secondary">@item.WaitingOn</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.ProgressPager is not null)
        {
            <partial name="_Pager" model="Model.ProgressPager" />
        }
    }
}
