@model CoordinatorPapersViewModel
@{
    ViewData["Title"] = "Research papers to decide on";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Research papers to decide on</h1>
    <div class="text-secondary">
        Every research paper in your department that is still moving. Accepting one hands the
        publication decision to its author.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load the papers</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="Evaluation_after_committee" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.IsEmpty)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">Papers appear here once a student submits one.</p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    <h2 class="h3 mb-3">
        Ready for your decision
        <span class="badge bg-primary-lt ms-1">@Model.ReadyForDecision.Count</span>
    </h2>

    @if (Model.ReadyForDecision.Count == 0)
    {
        <div class="card mb-4">
            <div class="card-body text-secondary">
                Nothing is waiting on you right now. The papers below are still with somebody else.
            </div>
        </div>
    }

    @foreach (var item in Model.ReadyForDecision)
    {
        <div class="card mb-3">
            <div class="card-header">
                <div>
                    <h3 class="card-title m-0">@item.Paper.Title</h3>
                    <div class="text-secondary small">@item.Container.StudentName</div>
                </div>
            </div>

            <div class="card-body">
                <p class="text-secondary rpms-preserve-lines">@item.Paper.Abstract</p>

                <h4 class="mt-3 mb-2">Reviews so far</h4>
                @if (item.Reviews.Count == 0)
                {
                    @* The backend refuses the final decision until the committee has finished, so
                       an empty list here means the paper isn't actually ready yet. *@
                    <p class="text-secondary">
                        No reviews have been recorded yet. The evaluation committee has to complete
                        its review before this decision can be made.
                    </p>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table card-table table-vcenter">
                            <thead>
                                <tr><th>Reviewer</th><th>Role</th><th>Decision</th><th>Comments</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var review in item.Reviews)
                                {
                                    <tr>
                                        <td>@review.ReviewerName</td>
                                        <td>@Humanise(review.ReviewerType)</td>
                                        <td><span class="badge @StatusBadge(review.Decision)">@Humanise(review.Decision)</span></td>
                                        <td>@review.Comments</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-controller="Coordinator" asp-action="DecideOnPaper" method="post">
                    <input type="hidden" name="publicationId" value="@item.Paper.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="paper-comments-@item.Paper.Id">Comments</label>
                        <textarea id="paper-comments-@item.Paper.Id" name="comments" rows="2" class="form-control"
                                  placeholder="Your decision and why"></textarea>
                    </div>
                    <div class="btn-list">
                        <button type="submit" name="accept" value="true" class="btn btn-primary">Accept the paper</button>
                        <button type="submit" name="accept" value="false" class="btn btn-outline-danger">Send back for revision</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.InProgress.Count > 0)
    {
        <h2 class="h3 mt-4 mb-1">Still in progress</h2>
        <p class="text-secondary mb-3">
            Not yours to decide yet. Shown so you can see where each one has got to, and chase
            anything that has stopped moving.
        </p>

        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr><th>Paper</th><th>Author</th><th>Waiting on</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.InProgress)
                        {
                            <tr>
                                <td>@(item.Container.Title ?? "Untitled paper")</td>
                                <td class="text-secondary">@item.Container.StudentName</td>
                                <td class="text-secondary">@item.WaitingOn</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
