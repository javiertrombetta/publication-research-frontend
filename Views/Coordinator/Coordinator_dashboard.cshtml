@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model CoordinatorDashboardViewModel
@{
    ViewData["Title"] = "Coordinator dashboard";

    string StageLabel(int stage) => stage switch
    {
        PipelineStage.ResearchProposals => "Research proposals",
        PipelineStage.EthicsApproval => "Ethics approval",
        PipelineStage.ResearchPaper => "Research paper",
        _ => "—"
    };
}

<div class="mb-4">
    <h1 class="page-title mb-1">Coordinator dashboard</h1>
    <div class="text-secondary">
        The publications you coordinate that are still moving, and what each one is waiting on.
        Completed ones are left out: they are a record rather than something to do.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your publications</h3>
            <p class="text-secondary mb-4">
                This is a temporary problem reaching the server. Try again in a moment.
            </p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    @* What the coordinator has to act on, before the full list, since nothing else in the pipeline
       moves until these are dealt with. *@
    <div class="row row-cards mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.ProposalsAwaitingDispatchTotal > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Waiting on you</div>
                    <div class="h1 m-0">@Model.ProposalsAwaitingDispatchTotal</div>
                    <div class="text-secondary">
                        @(Model.ProposalsAwaitingDispatchTotal == 1 ? "proposal to send out" : "proposals to send out")
                    </div>
                    @if (Model.ProposalsAwaitingDispatchTotal > 0)
                    {
                        <a asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor"
                           class="btn btn-primary btn-sm mt-3">Send to supervisors</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.SupervisorRepliesTotal > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Supervisor replies</div>
                    <div class="h1 m-0">@Model.SupervisorRepliesTotal</div>
                    <div class="text-secondary">
                        @(Model.SupervisorRepliesTotal == 1
                            ? "proposal a supervisor is interested in"
                            : "proposals a supervisor is interested in")
                    </div>
                    <a asp-controller="Coordinator" asp-action="select_a_proposal_forstudent"
                       class="btn @(Model.SupervisorRepliesTotal > 0 ? "btn-primary" : "btn-outline-primary") btn-sm mt-3">
                        Review selections
                    </a>
                </div>
            </div>
        </div>

        @{ var ethicsWaiting = Model.EthicsDecisionsTotal + Model.FinalEthicsDecisionsTotal; }
        <div class="col-12 col-md-4">
            <div class="card h-100 @(ethicsWaiting > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Ethics decisions</div>
                    <div class="h1 m-0">@ethicsWaiting</div>

                    @* Split, because they are two screens. A single figure would say there was
                       work without saying which of the coordinator's two ethics decisions it was
                       waiting on, and they are reached from different places. *@
                    <div class="text-secondary">
                        <span class="d-block">
                            <strong>@Model.EthicsDecisionsTotal</strong>
                            after a supervisor
                        </span>
                        <span class="d-block">
                            <strong>@Model.FinalEthicsDecisionsTotal</strong>
                            final @(Model.FinalEthicsDecisionsTotal == 1 ? "decision" : "decisions")
                        </span>
                    </div>

                    <div class="btn-list mt-3">
                        @if (Model.EthicsDecisionsTotal > 0)
                        {
                            <a asp-controller="Coordinator" asp-action="Ethic_review_aftersupervisor"
                               class="btn btn-primary btn-sm">After a supervisor</a>
                        }
                        @if (Model.FinalEthicsDecisionsTotal > 0)
                        {
                            <a asp-controller="Coordinator" asp-action="Ethic_review_afters_headofdepartment"
                               class="btn btn-outline-primary btn-sm">Final decision</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.PublicationsTotal == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">Nothing in progress</h3>
                <p class="text-secondary m-0">
                    Publications appear here as students in your department start them, and drop off
                    once they are complete.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                @{
                    // A real table, so the headings are where a reader expects to click. Ordering
                    // is the API's and covers every publication, not the ten on this page.
                    var byStudent = Model.Column("student", "Student");
                    var byStarted = Model.Column("started", "Publication", descendingFirst: true);
                    var byStage = Model.Column("stage", "Stage");
                    var byStatus = Model.Column("status", "Status");
                    // Ascending brings the publications that need the coordinator to the top,
                    // which is the question this column answers.
                    var byWaiting = Model.Column("waiting", "Waiting on you");
                }
                <table class="table card-table table-vcenter rpms-table-stable">
                    @* Declared once so the columns do not resize themselves around whichever ten
                       rows a sort happens to bring onto the page. *@
                    <colgroup>
                        <col style="width: 18%" />
                        <col style="width: 36%" />
                        <col style="width: 16%" />
                        <col style="width: 13%" />
                        <col style="width: 17%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th><partial name="_SortableHeader" model="byStudent" /></th>
                            <th><partial name="_SortableHeader" model="byStarted" /></th>
                            <th><partial name="_SortableHeader" model="byStage" /></th>
                            <th><partial name="_SortableHeader" model="byStatus" /></th>
                            <th><partial name="_SortableHeader" model="byWaiting" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var publication in Model.Publications)
                        {
                            var action = CoordinatorDashboardViewModel.ActionFor(publication);
                            <tr>
                                <td>@publication.StudentName</td>
                                <td>@publication.DisplayTitle</td>
                                <td>@StageLabel(publication.CurrentPipeline)</td>
                                <td>
                                    <span class="badge @StatusBadge(publication.DisplayStatus)">
                                        @Humanise(publication.DisplayStatus)
                                    </span>
                                </td>
                                <td>
                                    @if (action is null)
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                    else
                                    {
                                        @* Arrives at the target screen already searching for this
                                           row, so the coordinator is looking at the publication
                                           they clicked rather than hunting for it in a queue. *@
                                        <a asp-controller="Coordinator" asp-action="@action.Action"
                                           asp-route-search="@action.Search"
                                           class="btn btn-sm btn-primary">@action.Label</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Pager is not null)
        {
            <partial name="_Pager" model="Model.Pager" />
        }
    }
}
