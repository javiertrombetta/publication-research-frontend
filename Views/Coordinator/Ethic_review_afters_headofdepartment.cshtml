@* For the EthicsStatus constants, imported here rather than in _ViewImports so the DTO
   namespace does not shadow anything in the other views. *@
@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model CoordinatorEthicsViewModel
@inject ResearchPublicationManagementSystem.Services.IDecisionComments Decisions
@inject ResearchPublicationManagementSystem.Services.IPipelineSteps PipelineSteps
@{
    ViewData["Title"] = "Final ethics decision";

    // The Head of Department step can be switched off on either route, in which case publications
    // reach this screen straight from the coordinator's own decision and nobody has commented on
    // them. Both routes land here, so the heading only names that step where one of them runs it.
    var afterHeadOfDepartment = await PipelineSteps.HeadOfDepartmentReviewsEthicsAsync()
        || await PipelineSteps.HeadOfDepartmentReviewsWhenNotRequiredAsync();
}

<div class="mb-4">
    <h1 class="page-title mb-1">Final ethics decision</h1>
    <div class="text-secondary">
        @(afterHeadOfDepartment
            ? "The Head of Department has commented. Closing the stage opens the student's research paper."
            : "The last word on ethics. Closing the stage opens the student's research paper.")
    </div>
</div>

@* The coordinator has two ethics queues and the menu has one entry, so each screen says when the
   other has something on it. Without this, work sitting in the other queue is only visible from
   the dashboard, and a coordinator working through ethics has no reason to go back there. *@
@if (Model.OtherQueueCount > 0)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 mb-3" role="status">
        <span class="me-auto">
            <strong>@Model.OtherQueueCount</strong>
            @(Model.OtherQueueCount == 1 ? "publication is" : "publications are") waiting on you at the
            other ethics step.
        </span>
        <a asp-controller="Coordinator" asp-action="@Model.OtherQueueAction" class="btn btn-sm btn-primary">
            Go to @Model.OtherQueueName
        </a>
    </div>
}

@if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.HasSearch))
{
    @* Applied by the API, so it covers the whole queue and not the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Coordinator" asp-action="Ethic_review_afters_headofdepartment"
                  class="row g-2 align-items-center">
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student or proposal" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="Coordinator" asp-action="Ethic_review_afters_headofdepartment"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>
}


@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">We couldn't load them</h2>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="Ethic_review_afters_headofdepartment" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">Nothing waiting on you</h2>
            <p class="text-secondary mb-4">
                @(afterHeadOfDepartment
                    ? "Publications appear here once the Head of Department has reviewed their ethics documentation."
                    : "Publications appear here once you have approved their ethics documentation.")
            </p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    @* The same control as on the first ethics screen, so the two read alike. *@
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "publication" : "publications") waiting on you,
                @Model.Items.Count on this page.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="ethics-final-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="ethics-final-cards">Collapse all</button>
        </div>
    </div>

    @* Built here rather than inline: a tag helper's model attribute is delimited by double quotes,
       so a call with string arguments cannot be written inside one. *@
    var columns = new List<(string, SortableColumnViewModel)>
    {
        ("col-12 col-md-6", Model.Column("student", "Student")),
        ("col-12 col-md-6", Model.Column("started", "Date", descendingFirst: true))
    };

    <partial name="_QueueColumns" model="columns" />

    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header rpms-collapse-header"
                 data-rpms-header-toggle="#ethics-final-@item.Container.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="ethics-final-@item.Container.Id">
                @* Part of the header rather than a control of its own. As a button it
                   took focus and stayed looking pressed after a click, which read as a
                   selected icon sitting in the middle of a row. The header carries the
                   role and the keyboard handling now, so this is only the arrow. *@
                <div class="row g-2 align-items-center w-100">
                <div class="col-12 col-md-6 d-flex align-items-center gap-2">
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>

                <div class="me-auto">
                    <h2 class="card-title m-0">@item.Container.DisplayTitle</h2>
                    <div class="text-secondary small">@item.Container.StudentName</div>
                </div>
                </div>

                @* The date the listing orders by. Without it the heading above ordered by
                   something the row never showed, which reads as a fault rather than an order. *@
                <div class="col-6 col-md-3 text-secondary small">
                    <span class="text-nowrap" title="The date this publication was opened">@item.Container.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                </div>

                <div class="col-6 col-md-3 d-flex flex-wrap align-items-center justify-content-md-end gap-2">

                @* A count of nothing reads as a set that failed to load. On the route where no
                   documentation was asked for, say that instead. *@
                <span class="badge bg-primary-lt">
                    @(item.Documents.Count == 0
                        ? "No documentation needed"
                        : $"{item.Documents.Count} {(item.Documents.Count == 1 ? "document" : "documents")}")
                </span>
                </div>
                </div>
            </div>

            <div class="card-body collapse show" id="ethics-final-@item.Container.Id"
                 data-rpms-collapsible="ethics-final-cards">

                @if (!string.IsNullOrWhiteSpace(item.Approval.HeadOfDepartmentComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">
                            The Head of Department said
                            @if (item.Approval.HeadOfDepartmentReviewedAt is not null)
                            {
                                <span>
                                    &middot;
                                    @item.Approval.HeadOfDepartmentReviewedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                </span>
                            }
                        </div>
                        <p class="m-0">@item.Approval.HeadOfDepartmentComments</p>
                    </div>
                }

                @* Two routes reach this screen. One carries documents that were read and
                   approved; the other carries a ruling that none was needed, where there is
                   nothing to send back and turning it down means asking for documentation after
                   all. The buttons have to say which. *@
                @{ var noDocumentation = item.Approval.Status == EthicsStatus.NotRequired; }

                @if (noDocumentation)
                {
                    <div class="alert alert-info" role="status">
                        The supervisor ruled that this research needs no ethics documentation and you
                        agreed. Nothing was uploaded, so there is nothing to read here.
                    </div>
                }

                <form asp-controller="Coordinator" asp-action="FinaliseEthics" method="post">
                    <input type="hidden" name="id" value="@item.Container.Id" />

                @* Only what the supervisor accepted and the coordinator has already approved. The
                   versions sent back on the way here are answered, and listing them would ask this
                   reader to work out which rows are the live ones.

                   Each can be asked for again: sending the stage back is not always the whole set,
                   and naming one leaves the rest accepted, so the student is asked for exactly what
                   is wrong. Nothing ticked asks for all of them. *@
                @if (item.Documents.Count > 0)
                {
                    <div class="table-responsive mb-3">
                        <table class="table card-table table-vcenter" data-rpms-sortable-table>
                            <thead>
                                <tr>
                                    <th scope="col" data-rpms-sort-column="0">Document</th>
                                    <th scope="col" data-rpms-sort-column="1">File</th>
                                    <th scope="col" data-rpms-sort-column="2">Status</th>
                                    <th scope="col"></th>
                                    <th scope="col" class="text-end">Ask again</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var document in item.Documents)
                                {
                                    <tr>
                                        <td>@Humanise(document.DocumentType)</td>
                                        <td>@document.FileName</td>
                                        <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>
                                        <td class="text-end">
                                            @* The same as on the first ethics screen, and for the
                                               same reason: this is the decision that verifies the
                                               ethics stage, and approving documents you cannot read
                                               is not a review. *@
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-controller="Downloads" asp-action="EthicsDocument"
                                               asp-route-containerId="@item.Container.Id"
                                               asp-route-documentId="@document.Id">Download</a>
                                        </td>
                                        <td class="text-end">
                                            <input class="form-check-input" type="checkbox"
                                                   name="documentIds" value="@document.Id"
                                                   aria-label="Ask for @Humanise(document.DocumentType) again" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                    <div class="mb-3">
                        <label class="form-label" for="final-comments-@item.Container.Id">Comments</label>
                        <textarea id="final-comments-@item.Container.Id" name="comments" rows="2" class="form-control"
                                  placeholder="Required when sending it back"></textarea>
                    </div>
                    <div class="btn-list">
                        @{
                            var finalApproveNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.EthicsCoordinatorFinalApprove);
                            var finalReturnNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.EthicsCoordinatorFinalReturn);
                        }
                        <button type="submit" name="approve" value="true" class="btn btn-primary"
                                @DecisionButton.Attributes(finalApproveNeedsWhy, $"final-comments-{item.Container.Id}",
                                    "Close the ethics stage as approved? It opens the student's research paper.")>
                            @(noDocumentation ? "Close the ethics stage" : "Approve the ethics")
                        </button>

                        @if (noDocumentation)
                        {
                            <button type="submit" name="approve" value="false" class="btn btn-outline-danger"
                                    @DecisionButton.Attributes(finalReturnNeedsWhy, $"final-comments-{item.Container.Id}",
                                        "Ask for ethics documentation after all? The student is sent back to upload it and the stage starts again.",
                                        "Say why documentation is needed after all. It is all the student is given to work from.")>
                                Require documentation after all
                            </button>
                        }
                        else
                        {
                            <button type="submit" name="approve" value="false" class="btn btn-outline-danger"
                                    @DecisionButton.Attributes(finalReturnNeedsWhy, $"final-comments-{item.Container.Id}",
                                        "Send the ethics documents back to the student?",
                                        "Say what needs changing. It is all the student is given to work from.")>
                                Send back for revision
                            </button>
                        }
                    </div>
                </form>

            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
