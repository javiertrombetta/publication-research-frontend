@model CoordinatorEthicsViewModel
@{
    ViewData["Title"] = "Final ethics decision";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Final ethics decision</h1>
    <div class="text-secondary">
        The Head of Department has commented. Approving verifies the ethics stage and opens the
        student's research paper.
    </div>
</div>

@if (!Model.LoadFailed && Model.Items.Count > 0)
{
    @* The queue is drawn as cards, so the columns are named here rather than in a
       header row. Ordering is the API's and covers the whole queue, not this page. *@
    var sortBar = Model.SortBar;
    <partial name="_SortBar" model="sortBar" />
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load them</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="Ethic_review_afters_headofdepartment" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">
                Publications appear here once the Head of Department has reviewed their ethics
                documentation.
            </p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header">
                <div>
                    <h3 class="card-title m-0">@item.Container.DisplayTitle</h3>
                    <div class="text-secondary small">@item.Container.StudentName</div>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(item.Approval.HeadOfDepartmentComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">
                            The Head of Department said
                            @if (item.Approval.HeadOfDepartmentReviewedAt is not null)
                            {
                                <span>
                                    &middot;
                                    @item.Approval.HeadOfDepartmentReviewedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                                </span>
                            }
                        </div>
                        <p class="m-0">@item.Approval.HeadOfDepartmentComments</p>
                    </div>
                }

                @if (item.Documents.Count > 0)
                {
                    <div class="table-responsive mb-3">
                        <table class="table card-table table-vcenter">
                            <thead>
                                <tr><th>Document</th><th>File</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var document in item.Documents)
                                {
                                    <tr>
                                        <td>@Humanise(document.DocumentType)</td>
                                        <td>@document.FileName</td>
                                        <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <form asp-controller="Coordinator" asp-action="FinaliseEthics" method="post">
                    <input type="hidden" name="id" value="@item.Container.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="final-comments-@item.Container.Id">Comments</label>
                        <textarea id="final-comments-@item.Container.Id" name="comments" rows="2" class="form-control"
                                  placeholder="Required when sending it back"></textarea>
                    </div>
                    <div class="btn-list">
                        <button type="submit" name="approve" value="true" class="btn btn-primary">Approve the ethics</button>
                        <button type="submit" name="approve" value="false" class="btn btn-outline-danger">Send back for revision</button>
                    </div>
                </form>

            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
