@model AssignProposalsViewModel
@{
    ViewData["Title"] = "Send proposals to supervisors";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Send proposals to supervisors</h1>
    <div class="text-secondary">
        Submitted proposals that no supervisor has been invited to yet. Supervisors see the
        proposals you send and say which they are willing to supervise.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load the proposals</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Proposals.Count == 0 && Model.HasSearch)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h3>
            <p class="text-secondary mb-4">
                No proposal waiting to go out has that student, title or abstract.
            </p>
            <a asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor" class="btn btn-primary">
                Show them all
            </a>
        </div>
    </div>
}
else if (Model.Proposals.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting to go out</h3>
            <p class="text-secondary mb-4">
                Every submitted proposal has already been sent to a supervisor.
            </p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else if (Model.Supervisors.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">No supervisors available</h3>
            <p class="text-secondary m-0">
                There are no enabled supervisor accounts to send these proposals to. An
                Administrator needs to grant the Supervisor role before you can assign one.
            </p>
        </div>
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor"
                  class="row g-2 align-items-center">

                @* The ordering and the supervisor filter survive a proposal search. *@
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />
                <input type="hidden" name="supervisorSearch" value="@Model.SupervisorSearch" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student, proposal or abstract" aria-label="Search proposals" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

                @{ var dispatchSort = Model.SortBar; }
                <partial name="_SortInline" model="dispatchSort" />
            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "proposal matches" : "proposals match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>

    @* Outside the dispatch form, and referenced by the search box through form=. HTML has no
       nested forms, and this one only narrows the chooser. *@
    <form id="supervisor-filter" method="get"
          asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor"></form>

    @* The group forms live out here for the same reason: they post, and they sit inside the card
       that the dispatch form owns. The name field and the chosen ids are filled in from the ticks
       when Save is pressed, so what gets saved is what the coordinator is looking at. *@
    <form id="group-create" asp-controller="Coordinator" asp-action="CreateSupervisorGroup" method="post">
        <input type="hidden" name="name" />
    </form>

    @foreach (var group in Model.Groups)
    {
        <form id="group-delete-@group.Id" asp-controller="Coordinator" asp-action="DeleteSupervisorGroup" method="post">
            <input type="hidden" name="groupId" value="@group.Id" />
        </form>
    }

    @* One per student whose proposals came back, out here for the same reason: the box and the
       button that belong to it sit inside the card the dispatch form owns. *@
    @foreach (var publication in Model.ByPublication.Where(g => g.Any(p => p.CameBack)))
    {
        <form id="ask-new-@publication.Key" asp-controller="Coordinator" asp-action="AskForNewProposals" method="post">
            <input type="hidden" name="containerId" value="@publication.Key" />
        </form>
    }

    <form id="send-proposals-form" asp-controller="Coordinator" asp-action="SendToSupervisors" method="post">

        @* One line for the whole page, because the common case is sending everything waiting.
           Counting rather than saying "all": a coordinator needs to know how much is about to go
           out, and a page is not the whole queue. *@
        <div class="card mb-3">
            <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
                <span class="text-secondary me-auto">
                    <strong data-rpms-count="proposalIds">0</strong> of @Model.Proposals.Count
                    @(Model.Proposals.Count == 1 ? "proposal" : "proposals") on this page selected.

                    @* The second figure on this line, because it changes what a coordinator does
                       next. A queue of twenty where twelve have already been out once and found
                       nobody is not the same job as a queue of twenty nobody has seen. Counted
                       over the whole queue, not this page.

                       Worded around the student rather than the proposal. A student only comes
                       back when no supervisor was interested in any of their proposals, so saying
                       "one proposal came back" would read as one of several being passed over,
                       which is a different thing and not what happened. *@
                    @if (Model.HasReturned)
                    {
                        <span class="d-block text-warning">
                            No supervisor was interested in any proposal from
                            <strong>@Model.ReturnedStudents</strong>
                            @(Model.ReturnedStudents == 1 ? "student" : "students").
                        </span>
                    }
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-check-all="proposalIds">Select all</button>
                @if (Model.HasReturned)
                {
                    <button type="button" class="btn btn-sm btn-outline-warning"
                            data-rpms-check-returned="proposalIds">Select the returned</button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-check-none="proposalIds">Select none</button>

                @* One control for every group, so a coordinator scanning a long queue can shut the
                   lot and open only what they are working on. *@
                <span class="border-start ps-2 ms-1"></span>
                <button type="button" class="btn btn-sm btn-ghost-secondary"
                        data-rpms-expand-all="student-groups">Expand all</button>
                <button type="button" class="btn btn-sm btn-ghost-secondary"
                        data-rpms-collapse-all="student-groups">Collapse all</button>
            </div>
        </div>

        @* Grouped by student, because a supervisor chooses between one student's proposals.

           Each group opens and closes, and starts open with everything ticked, which is the common
           case. A coordinator sending only some of one student's proposals can collapse the rest
           out of the way and work on the one group, rather than scrolling a flat list of every
           proposal in the department looking for the two that belong together. *@
        @foreach (var group in Model.ByPublication)
        {
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#student-@group.Key"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="student-@group.Key">
                @* Part of the header rather than a control of its own. As a button it
                   took focus and stayed looking pressed after a click, which read as a
                   selected icon sitting in the middle of a row. The header carries the
                   role and the keyboard handling now, so this is only the arrow. *@
                <span class="rpms-collapse-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                             viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M6 9l6 6l6 -6" />
                        </svg>
                </span>

                    <h3 class="card-title m-0 me-auto">@Model.StudentFor(group.Key)</h3>

                    @{ var cameBack = group.Any(p => p.CameBack); }
                    @if (cameBack)
                    {
                        @* One badge for the student, not a tally of proposals. A student is only
                           here a second time when no supervisor was interested in any of their
                           proposals, so the count would be the number they wrote rather than
                           anything about the round, and marking each proposal as well would read
                           as a verdict on that proposal on its own.

                           Interested rather than accepted: a supervisor saying they are willing is
                           an offer, and accepting it is the coordinator's. *@
                        <span class="badge bg-warning-lt"
                              title="No supervisor was interested in any of this student's proposals">
                            Nobody interested
                        </span>
                    }

                    <span class="text-secondary small">
                        @group.Count() @(group.Count() == 1 ? "proposal" : "proposals")
                    </span>
                    <button type="button" class="btn btn-sm btn-ghost-secondary"
                            data-rpms-check-all="proposalIds" data-rpms-scope="#student-@group.Key">All</button>
                    <button type="button" class="btn btn-sm btn-ghost-secondary"
                            data-rpms-check-none="proposalIds" data-rpms-scope="#student-@group.Key">None</button>
                </div>
                <div class="card-body collapse show" id="student-@group.Key" data-rpms-collapsible="student-groups">
                    @foreach (var proposal in group)
                    {
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="proposalIds"
                                   value="@proposal.Id" checked
                                   data-rpms-returned="@proposal.CameBack.ToString().ToLowerInvariant()" />
                            <span class="form-check-label">
                                <strong>@proposal.Title</strong>
                                <span class="d-block text-secondary small mt-1">@proposal.Abstract</span>
                            </span>
                        </label>
                    }

                    @if (cameBack)
                    {
                        @* Two ways out of a round that found nobody, and the screen offers both.
                           Sending again is the button at the bottom of the page, with different
                           supervisors ticked. This is the other one: the proposals themselves were
                           the problem, so ask for new ones. *@
                        <div class="mt-3 pt-3 border-top">
                            <label class="form-label"
                                   for="new-proposals-comments-@group.Key">
                                No supervisor was interested in any of this student's proposals
                            </label>
                            <div class="row g-2 align-items-start">
                                <div class="col-12 col-md">
                                    <input type="text" id="new-proposals-comments-@group.Key"
                                           class="form-control"
                                           placeholder="What the student should change, in a sentence"
                                           form="ask-new-@group.Key" name="comments" />
                                </div>
                                <div class="col-auto">
                                    <button type="submit" form="ask-new-@group.Key"
                                            class="btn btn-outline-warning"
                                            data-rpms-confirm="Ask for a new set of proposals? The ones on record are closed and the student writes fresh ones.">
                                        Ask for new proposals
                                    </button>
                                </div>
                            </div>
                            <div class="text-secondary small mt-1">
                                Or tick different supervisors below and send them again. Asking for
                                new ones closes the proposals on record.
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <h3 class="card-title m-0 me-auto">Send to</h3>
                <span class="text-secondary small">
                    <strong data-rpms-count="supervisorIds">0</strong> of @Model.SupervisorsTotal available selected
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-check-all="supervisorIds" data-rpms-scope="#send-to">Select all on this page</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-check-none="supervisorIds" data-rpms-scope="#send-to">Select none on this page</button>
            </div>
            <div class="card-body" id="send-to">
                @* Only supervisors who are available: enabled by an administrator, and not marked
                   unavailable by themselves. Sending a proposal to somebody who has said they
                   cannot take work on is asking a question nobody is there to answer. *@

                @* Saved sets, above the chooser rather than in it.
                   The same people get asked cycle after cycle, and rebuilding the same list of
                   five by hand every time is where a name gets missed. A group ticks its members
                   and nothing else: it is the form being filled in, not a rule about who may be
                   asked, so a group whose members have since gone unavailable simply ticks fewer
                   of them and says so. *@
                <div class="mb-3 pb-3 border-bottom">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-secondary small me-1">Groups</span>

                        @if (Model.Groups.Count == 0)
                        {
                            <span class="text-secondary small">
                                None saved yet. Tick some supervisors and save them as one.
                            </span>
                        }
                        else
                        {
                            @foreach (var group in Model.Groups)
                            {
                                <span class="btn-group btn-group-sm" role="group" aria-label="@group.Name">
                                    <button type="button" class="btn btn-outline-primary"
                                            data-rpms-group="@group.MemberIdList"
                                            title="Tick the @group.MemberCount in this group">
                                        @group.Name
                                        <span class="badge bg-primary-lt ms-1">
                                            @(group.AvailableCount == group.MemberCount
                                                ? group.MemberCount.ToString()
                                                : $"{group.AvailableCount} of {group.MemberCount}")
                                        </span>
                                    </button>
                                    <button type="submit" form="group-delete-@group.Id"
                                            class="btn btn-outline-secondary"
                                            title="Delete the group @group.Name"
                                            aria-label="Delete the group @group.Name">&times;</button>
                                </span>
                            }
                        }
                    </div>

                    <div class="row g-2 mt-2">
                        <div class="col-12 col-md-4">
                            <input type="text" id="group-name" class="form-control form-control-sm"
                                   maxlength="80" placeholder="Name for a new group"
                                   aria-label="Name for a new group" />
                        </div>
                        <div class="col-auto">
                            <button type="button" id="group-save" class="btn btn-sm btn-outline-primary">
                                Save the ticked supervisors as a group
                            </button>
                        </div>
                    </div>
                </div>

                @* The narrowing is the API's, since it knows who is available. Its own form, and
                   not nested inside the dispatch form, because a form cannot contain another and
                   pressing Enter in this box must narrow the list rather than send the proposals. *@
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md">
                        <input type="search" form="supervisor-filter" name="supervisorSearch"
                               value="@Model.SupervisorSearch" class="form-control"
                               placeholder="Find a supervisor by name or email" aria-label="Find a supervisor" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" form="supervisor-filter" class="btn btn-outline-secondary">Find</button>
                    </div>
                    @if (Model.HasSupervisorSearch)
                    {
                        <div class="col-auto">
                            <a asp-controller="Coordinator" asp-action="assigning_proposal_forsupervisor"
                               class="btn btn-link text-secondary text-decoration-none">Show all</a>
                        </div>
                    }
                </div>

                @* Paged in the browser, ten at a time. Every available supervisor is in the page,
                   so a tick made on one page is still a tick on another and "select all" means all
                   of them, not the ten on screen. With JavaScript off nothing is hidden: the list
                   is longer, which is the right answer rather than a broken one. *@
                <div class="row g-2" data-rpms-paged="supervisors" data-rpms-page-size="10">
                    @foreach (var supervisor in Model.Supervisors)
                    {
                        <div class="col-12 col-md-6" data-rpms-page-item>
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="supervisorIds" value="@supervisor.Id" />
                                <span class="form-check-label">
                                    @supervisor.FullName
                                    <span class="d-block text-secondary small">@supervisor.Email</span>
                                </span>
                            </label>
                        </div>
                    }
                </div>

                @if (Model.Supervisors.Count == 0)
                {
                    <p class="text-secondary m-0">
                        @(Model.HasSupervisorSearch
                            ? "No available supervisor matches that."
                            : "Nobody is available to take proposals on at the moment.")
                    </p>
                }

                <div class="mt-3">
                    <label for="dispatch-comments" class="form-label">Message to the supervisors</label>
                    <textarea id="dispatch-comments" name="comments" rows="3" class="form-control"
                              placeholder="Anything they should know before deciding"></textarea>
                </div>

                @* A date the round runs out on, and what happens when it does.
                   Optional: a coordinator with a cycle to keep to sets one, and one chasing
                   replies by hand does not have to. Once it passes, students nobody offered to
                   supervise come back here on their own, which is the same thing the coordinator
                   would have done after noticing, minus the noticing. *@
                <div class="mt-3">
                    <label for="respond-by" class="form-label">
                        Answer by <span class="text-secondary fw-normal">(optional)</span>
                    </label>
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-auto">
                            <input type="datetime-local" id="respond-by" name="respondBy"
                                   class="form-control" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="col text-secondary small">
                            After this, any student with no proposal a supervisor offered to take on
                            comes back to this screen, ready to go out again or to be asked for new
                            proposals.
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Send proposals</button>
            </div>
        </div>

    </form>

    @section Scripts {
        <script>
            // The backend rejects an empty selection; say so here rather than after a round trip.
            //
            // By id, not document.querySelector('form'). That returns the FIRST form in the
            // document, which is the logout form in the top bar, so this check was being attached
            // to it: signing out from this page refused with "Choose at least one supervisor",
            // and the real form had no check at all.
            document.getElementById('send-proposals-form').addEventListener('submit', function (event) {
                var proposals = document.querySelectorAll('input[name="proposalIds"]:checked').length;
                var supervisors = document.querySelectorAll('input[name="supervisorIds"]:checked').length;
                if (proposals && supervisors) return;

                event.preventDefault();

                var problems = [];
                if (!proposals) problems.push('Choose at least one proposal to send.');
                if (!supervisors) problems.push('Choose at least one supervisor to send it to.');
                window.rpmsToast('error', problems);
            });

            // Picking a group ticks its members, on top of whatever is already ticked.
            //
            // Adding rather than replacing: a coordinator who wants two groups picks both, and one
            // who wants a group plus one other name ticks the extra afterwards. Members who are no
            // longer in the chooser, because they are unavailable or the search has narrowed it,
            // cannot be ticked, so the count says what actually happened rather than what the
            // group holds.
            document.addEventListener('click', function (event) {
                var button = event.target.closest('[data-rpms-group]');
                if (!button) return;

                var ids = button.getAttribute('data-rpms-group').split(',').filter(Boolean);
                var ticked = 0;

                ids.forEach(function (id) {
                    var box = document.querySelector('input[name="supervisorIds"][value="' + id + '"]');
                    if (!box) return;
                    if (!box.checked) {
                        box.checked = true;
                        box.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    ticked++;
                });

                if (ticked < ids.length) {
                    window.rpmsToast('error', [
                        'Ticked ' + ticked + ' of ' + ids.length + '. The rest are not in the list right now, '
                        + 'either because they are unavailable or because the search has narrowed it.'
                    ]);
                }
            });

            // Saving the current ticks under a name. The hidden fields are built here rather than
            // sitting in the markup, because what is saved is whatever is ticked at the moment the
            // button is pressed.
            document.getElementById('group-save').addEventListener('click', function () {
                var form = document.getElementById('group-create');
                var name = document.getElementById('group-name').value.trim();
                var chosen = document.querySelectorAll('input[name="supervisorIds"]:checked');

                var problems = [];
                if (!name) problems.push('Give the group a name.');
                if (!chosen.length) problems.push('Tick the supervisors the group should hold.');
                if (problems.length) { window.rpmsToast('error', problems); return; }

                form.querySelector('input[name="name"]').value = name;

                // Cleared first, so pressing Save twice does not send the first selection again.
                form.querySelectorAll('input[name="groupSupervisorIds"]').forEach(function (old) {
                    old.remove();
                });

                chosen.forEach(function (box) {
                    var field = document.createElement('input');
                    field.type = 'hidden';
                    field.name = 'groupSupervisorIds';
                    field.value = box.value;
                    form.appendChild(field);
                });

                form.submit();
            });
        </script>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
