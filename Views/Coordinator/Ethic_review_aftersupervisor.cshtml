@model CoordinatorEthicsViewModel
@{
    ViewData["Title"] = "Ethics awaiting you";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Ethics awaiting you</h1>
    <div class="text-secondary">
        Publications where a supervisor has had their say and the decision is now yours.
    </div>
</div>

@* The coordinator has two ethics queues and the menu has one entry, so each screen says when the
   other has something on it. Without this, work sitting in the other queue is only visible from
   the dashboard, and a coordinator working through ethics has no reason to go back there. *@
@if (Model.OtherQueueCount > 0)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 mb-3" role="status">
        <span class="me-auto">
            <strong>@Model.OtherQueueCount</strong>
            @(Model.OtherQueueCount == 1 ? "publication is" : "publications are") waiting on you at the
            other ethics step.
        </span>
        <a asp-controller="Coordinator" asp-action="@Model.OtherQueueAction" class="btn btn-sm btn-primary">
            Go to @Model.OtherQueueName
        </a>
    </div>
}

@if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.HasSearch))
{
    @* Applied by the API, so it covers the whole queue and not the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="Coordinator" asp-action="Ethic_review_aftersupervisor"
                  class="row g-2 align-items-center">
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student or proposal" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="Coordinator" asp-action="Ethic_review_aftersupervisor"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

                @{ var inlineSort = Model.SortBar; }
                <partial name="_SortInline" model="inlineSort" />
            </form>
        </div>
    </div>
}


@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load them</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="Coordinator" asp-action="Ethic_review_aftersupervisor" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">Ethics decisions appear here once a supervisor has made theirs.</p>
            <a asp-controller="Coordinator" asp-action="Coordinator_dashboard" class="btn btn-primary">Back to dashboard</a>
        </div>
    </div>
}
else
{
    @* One control for the lot, as on Supervisor selections. Each publication carries its
       documents and a decision form, so a queue of them is a long scroll; shutting them all and
       opening the one being worked on turns it back into a list. *@
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "publication" : "publications") waiting on you,
                @Model.Items.Count on this page.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="ethics-cards">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="ethics-cards">Collapse all</button>
        </div>
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center gap-2 rpms-collapse-header"
                 data-rpms-header-toggle="#ethics-@item.Container.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="ethics-@item.Container.Id">
                @* Part of the header rather than a control of its own. As a button it
                   took focus and stayed looking pressed after a click, which read as a
                   selected icon sitting in the middle of a row. The header carries the
                   role and the keyboard handling now, so this is only the arrow. *@
                <span class="rpms-collapse-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                         viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M6 9l6 6l6 -6" />
                    </svg>
                </span>

                <div class="me-auto">
                    <h3 class="card-title m-0">@item.Container.DisplayTitle</h3>
                    <div class="text-secondary small">@item.Container.StudentName</div>
                </div>

                @* Readable with the card shut, because it is what decides whether to open it: a
                   confirmation with nothing to read is a different job from a set of documents. *@
                <span class="badge bg-primary-lt">
                    @(item.IsNotRequiredConfirmation
                        ? "No documentation"
                        : $"{item.Documents.Count} {(item.Documents.Count == 1 ? "document" : "documents")}")
                </span>
            </div>

            <div class="card-body collapse show" id="ethics-@item.Container.Id"
                 data-rpms-collapsible="ethics-cards">

                @* The student's own answer as well as the supervisor's. The coordinator is
                   confirming or overturning a ruling made on it, and was being shown only the
                   ruling. *@
                @if (item.Approval.StudentDeclaration is not null)
                {
                    <div class="mb-3">
                        <div class="text-secondary small">The student declared</div>
                        <p class="mb-2">
                            Asked whether their research requires ethical approval, they answered
                            <strong>@Humanise(item.Approval.StudentDeclaration)</strong>.
                        </p>

                        <partial name="_EthicsScreeningAnswers" model="item.Approval.StudentScreening" />
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(item.Approval.SupervisorDecisionComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">The supervisor said</div>
                        <p class="m-0">@item.Approval.SupervisorDecisionComments</p>
                    </div>
                }

                @if (item.IsNotRequiredConfirmation)
                {
                    @* The supervisor found no documentation necessary; the coordinator confirms
                       that, or overrides it and asks the student to upload after all. *@
                    <p class="text-secondary">
                        The supervisor found that this research does not require ethics approval
                        documentation. Confirming closes the ethics stage and opens the student's
                        research paper.
                    </p>

                    <form asp-controller="Coordinator" asp-action="ConfirmEthicsNotRequired" method="post">
                        <input type="hidden" name="id" value="@item.Container.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="nr-comments-@item.Container.Id">Comments</label>
                            <textarea id="nr-comments-@item.Container.Id" name="comments" rows="2" class="form-control"
                                      placeholder="Your reasoning"></textarea>
                        </div>
                        <div class="btn-list">
                            <button type="submit" name="requireDocumentation" value="false" class="btn btn-primary">
                                Confirm: not required
                            </button>
                            <button type="submit" name="requireDocumentation" value="true" class="btn btn-outline-danger">
                                Require documentation after all
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-secondary">
                        The supervisor has accepted these documents. Approving sends them to the
                        Head of Department; sending them back returns them to the student.
                    </p>

                    @if (item.Documents.Count > 0)
                    {
                        <div class="table-responsive mb-3">
                            <table class="table card-table table-vcenter" data-rpms-sortable-table>
                                <thead>
                                    <tr><th data-rpms-sort-column="0">Document</th><th data-rpms-sort-column="1">File</th><th data-rpms-sort-column="2">Status</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var document in item.Documents)
                                    {
                                        <tr>
                                            <td>@Humanise(document.DocumentType)</td>
                                            <td>@document.FileName</td>
                                            <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>
                                            <td class="text-end">
                                                @* Approving a document you cannot read is not a review. *@
                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-controller="Downloads" asp-action="EthicsDocument"
                                                   asp-route-containerId="@item.Container.Id"
                                                   asp-route-documentId="@document.Id">Download</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <form asp-controller="Coordinator" asp-action="ReviewEthicsDocuments" method="post">
                        <input type="hidden" name="id" value="@item.Container.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="doc-comments-@item.Container.Id">Comments</label>
                            <textarea id="doc-comments-@item.Container.Id" name="comments" rows="2" class="form-control"
                                      placeholder="Required when sending the documents back"></textarea>
                        </div>
                        <div class="btn-list">
                            <button type="submit" name="approve" value="true" class="btn btn-primary">
                                Approve and send to the Head of Department
                            </button>
                            <button type="submit" name="approve" value="false" class="btn btn-outline-danger">
                                Send back for revision
                            </button>
                        </div>
                    </form>
                }

            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
