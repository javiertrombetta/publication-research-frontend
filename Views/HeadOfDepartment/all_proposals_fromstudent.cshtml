@model DepartmentProposalsViewModel
@{
    ViewData["Title"] = "Proposals in your department";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Proposals in your department</h1>
    <div class="text-secondary">
        Every research proposal from students in your department. For oversight, so the proposal
        workflow is run by coordinators and supervisors.
    </div>
</div>

@if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.HasSearch))
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent"
                  class="row g-2 align-items-center">

                @* Ordering survives a search, so narrowing does not silently reorder. *@
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student, proposal or supervisor" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "proposal matches" : "proposals match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">We couldn't load them</h2>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0 && Model.HasSearch)
{
    @* A search that found nothing is a different thing from a department with no proposals. *@
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h2>
            <p class="text-secondary mb-4">No proposal in your department has that student, title or supervisor.</p>
            <a asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent" class="btn btn-primary">
                Show them all
            </a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">No proposals yet</h2>
            <p class="text-secondary m-0">
                Proposals appear here as students in your department submit them.
            </p>
        </div>
    </div>
}
else
{
    // Built here rather than inline: a tag helper's model attribute is delimited by double
    // quotes, so a call with string arguments cannot be written inside one.
    var byStudent = Model.Column("student", "Student");
    var byTitle = Model.Column("title", "Proposal");
    var bySubmitted = Model.Column("submitted", "Submitted", descendingFirst: true);
    var byStatus = Model.Column("status", "Status");

    @* The count first, because what a head of department wants to know is how much there is, not
       that a control exists. Every proposal carries an abstract, so a page of them is a long
       scroll; shutting them all turns it back into a list. *@
    <div class="card mb-3">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
            <span class="text-secondary me-auto">
                <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "proposal" : "proposals") in your
                department, @Model.Items.Count on this page.
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-expand-all="department-proposals">Expand all</button>
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-rpms-collapse-all="department-proposals">Collapse all</button>
        </div>
    </div>

    @* The column titles, once, above the cards they describe. A card has no header row to click,
       so the same sortable headings a table would carry sit here instead, laid out on the grid the
       card headers below use so each heading stands over its own column. *@
    <div class="card mb-2 rpms-queue-columns">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center text-secondary small text-uppercase">
                <div class="col-12 col-md-3"><partial name="_SortableHeader" model="byStudent" /></div>
                <div class="col-12 col-md-5"><partial name="_SortableHeader" model="byTitle" /></div>
                <div class="col-6 col-md-2"><partial name="_SortableHeader" model="bySubmitted" /></div>
                <div class="col-6 col-md-2"><partial name="_SortableHeader" model="byStatus" /></div>
            </div>
        </div>
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header rpms-collapse-header"
                 data-rpms-header-toggle="#proposal-@item.Proposal.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="proposal-@item.Proposal.Id">

                <div class="row g-2 align-items-center w-100">
                    <div class="col-12 col-md-3 d-flex align-items-center gap-2">
                        @* Part of the header rather than a control of its own, so clicking it does
                           not leave an icon looking selected in the middle of a row. *@
                        <span class="rpms-collapse-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                                 viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M6 9l6 6l6 -6" />
                            </svg>
                        </span>
                        <span class="text-secondary">@item.StudentName</span>
                    </div>

                    <div class="col-12 col-md-5">
                        <h2 class="card-title m-0">@item.Proposal.Title</h2>
                    </div>

                    <div class="col-6 col-md-2 text-secondary">
                        @(item.Proposal.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                    </div>

                    <div class="col-6 col-md-2">
                        <span class="badge @StatusBadge(item.Proposal.Status)">@Humanise(item.Proposal.Status)</span>
                    </div>
                </div>
            </div>

            <div class="card-body collapse show" id="proposal-@item.Proposal.Id"
                 data-rpms-collapsible="department-proposals">
                @* The abstract is what the proposal actually says. A title alone tells a head of
                   department the subject and nothing about whether the work is worth supervising. *@
                <p class="text-secondary m-0 rpms-preserve-lines">@item.Proposal.Abstract</p>
            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
