@model DepartmentProposalsViewModel
@{
    ViewData["Title"] = "Proposals in your department";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Proposals in your department</h1>
    <div class="text-secondary">
        Every research proposal from students in your department. For oversight — the proposal
        workflow is run by coordinators and supervisors.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load them</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">No proposals yet</h3>
            <p class="text-secondary m-0">
                Proposals appear here as students in your department submit them.
            </p>
        </div>
    </div>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header">
                <div>
                    <h3 class="card-title m-0">@item.Container.StudentName</h3>
                    <div class="text-secondary small">@item.Container.DisplayTitle</div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr><th>Title</th><th>Submitted</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var proposal in item.Proposals)
                        {
                            <tr>
                                <td>
                                    @proposal.Title
                                    @* The abstract is what the proposal actually says. A title alone
                                       tells a head of department the subject and nothing about whether
                                       the work is worth supervising. *@
                                    <span class="d-block text-secondary small rpms-preserve-lines">@proposal.Abstract</span>
                                </td>
                                <td class="text-nowrap align-top">@(proposal.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                <td class="align-top"><span class="badge @StatusBadge(proposal.Status)">@Humanise(proposal.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
