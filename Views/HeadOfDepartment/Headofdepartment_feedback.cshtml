@model HeadOfDepartmentEthicsViewModel
@{
    ViewData["Title"] = "Ethics reviews";
}

<div class="mb-4">
    <h1 class="page-title mb-1">Ethics reviews</h1>
    <div class="text-secondary">
        Documentation the coordinator has approved and passed to you. Your comments are recorded
        on the publication and shown to the coordinator, who makes the final decision.
    </div>
</div>

@if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.HasSearch))
{
    @* Applied by the API, so it covers the whole queue and not the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                  class="row g-2 align-items-center">
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student or proposal" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>

                @{ var inlineSort = Model.SortBar; }
                <partial name="_SortInline" model="inlineSort" />
            </form>
        </div>
    </div>
}


@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load them</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">Nothing waiting on you</h3>
            <p class="text-secondary mb-4">
                Ethics documentation appears here once a coordinator has approved it.
            </p>
            <a asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard" class="btn btn-primary">
                Back to dashboard
            </a>
        </div>
    </div>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header">
                <div>
                    <h3 class="card-title m-0">@item.Container.DisplayTitle</h3>
                    <div class="text-secondary small">@item.Container.StudentName</div>
                </div>
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(item.Approval.SupervisorDecisionComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">The supervisor said</div>
                        <p class="m-0">@item.Approval.SupervisorDecisionComments</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(item.Approval.CoordinatorDecisionComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">The coordinator said</div>
                        <p class="m-0">@item.Approval.CoordinatorDecisionComments</p>
                    </div>
                }

                @if (item.Documents.Count > 0)
                {
                    <div class="table-responsive mb-3">
                        <table class="table card-table table-vcenter" data-rpms-sortable-table>
                            <thead>
                                <tr><th data-rpms-sort-column="0">Document</th><th data-rpms-sort-column="1">File</th><th data-rpms-sort-column="2">Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var document in item.Documents)
                                {
                                    <tr>
                                        <td>@Humanise(document.DocumentType)</td>
                                        <td>@document.FileName</td>
                                        <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* Comments only: the Head of Department records an opinion, they do not accept or
                   reject. That decision is the coordinator's. *@
                <form asp-controller="HeadOfDepartment" asp-action="SubmitReview" method="post">
                    <input type="hidden" name="id" value="@item.Container.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="hod-comments-@item.Container.Id">Your comments</label>
                        <textarea id="hod-comments-@item.Container.Id" name="comments" rows="3" class="form-control"
                                  placeholder="What the coordinator should weigh before deciding" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit review</button>
                </form>

            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
