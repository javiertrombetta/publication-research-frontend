@* For the EthicsStatus constants, imported here rather than in _ViewImports so the DTO
   namespace does not shadow anything in the other views. *@
@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model HeadOfDepartmentEthicsViewModel
@inject ResearchPublicationManagementSystem.Services.IDecisionComments Decisions
@{
    ViewData["Title"] = "Ethics reviews";

    // Arrived from a link on the dashboard, so this is one publication rather than the queue. The
    // search, ordering and paging controls all describe a list, and there is no list to describe.
    var isSingle = Model.OnlyId is not null;
}

<div class="mb-4">
    <h1 class="page-title mb-1">Ethics reviews</h1>
    <div class="text-secondary">
        Ethics decisions the coordinator has made and passed to you, whether that is documentation
        they approved or a ruling that none is needed. Your comments are recorded
        on the publication and shown to the coordinator, who makes the final decision.
    </div>
</div>

@if (isSingle)
{
    <div class="mb-3">
        <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
           class="btn btn-outline-secondary btn-sm">See everything waiting on you</a>
    </div>
}
else if (!Model.LoadFailed && (Model.Items.Count > 0 || Model.HasSearch))
{
    @* Applied by the API, so it covers the whole queue and not the page in hand. *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                  class="row g-2 align-items-center">
                <input type="hidden" name="sort" value="@Model.Sort" />
                <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                <div class="col-12 col-md">
                    <input type="search" name="search" value="@Model.Search" class="form-control"
                           placeholder="Search by student or publication" aria-label="Search" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
                <div class="col-auto">
                    @* Beside Search, always, so the way back to the whole list is where somebody
                       looks for it rather than appearing only once they have searched. It carries
                       the ordering with it: clearing a search should widen the list, not reorder
                       what is left. *@
                    <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                       asp-all-route-data="Model.ClearSearchRoute()"
                       class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>

            @if (Model.HasSearch)
            {
                <div class="text-secondary small mt-2">
                    @Model.TotalCount @(Model.TotalCount == 1 ? "publication matches" : "publications match") &ldquo;@Model.Search&rdquo;.
                </div>
            }
        </div>
    </div>
}

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">We couldn't load them</h2>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else if (Model.Items.Count == 0 && Model.HasSearch)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h2>
            <p class="text-secondary mb-4">No publication waiting on you has that student or title.</p>
            <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback" class="btn btn-primary">
                Show them all
            </a>
        </div>
    </div>
}
else if (Model.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h3 mb-2">Nothing waiting on you</h2>
            <p class="text-secondary mb-4">
                Ethics decisions appear here once a coordinator has made one and passed it on.
            </p>
            <a asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard" class="btn btn-primary">
                Back to dashboard
            </a>
        </div>
    </div>
}
else
{
    @if (!isSingle)
    {
        @* The count first, because what a head of department wants to know is how much is waiting
           on them. Each of these carries two sets of comments, a table of documents and a form, so
           a page of them is a long scroll; shutting them all turns it back into a list. *@
        <div class="card mb-3">
            <div class="card-body py-3 d-flex flex-wrap align-items-center gap-2">
                <span class="text-secondary me-auto">
                    <strong>@Model.TotalCount</strong>
                    @(Model.TotalCount == 1 ? "publication" : "publications") waiting on your comments,
                    @Model.Items.Count on this page.
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-expand-all="ethics-reviews">Expand all</button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-rpms-collapse-all="ethics-reviews">Collapse all</button>
            </div>
        </div>

        // Built here rather than inline: a tag helper's model attribute is delimited by double
        // quotes, so a call with string arguments cannot be written inside one.
        var byStudent = Model.Column("student", "Student");
        var byTitle = Model.Column("title", "Publication");
        var byStarted = Model.Column("started", "Started", descendingFirst: true);

        @* The column titles, once, above the cards they describe, on the same grid those card
           headers use so each heading stands over its own column. *@
        <div class="card mb-2 rpms-queue-columns">
            <div class="card-body py-2">
                <div class="row g-2 align-items-center text-secondary small text-uppercase">
                    <div class="col-12 col-md-3"><partial name="_SortableHeader" model="byStudent" /></div>
                    <div class="col-12 col-md-6"><partial name="_SortableHeader" model="byTitle" /></div>
                    <div class="col-12 col-md-3"><partial name="_SortableHeader" model="byStarted" /></div>
                </div>
            </div>
        </div>
    }

    @foreach (var item in Model.Items)
    {
        <div class="card mb-3">
            <div class="card-header rpms-collapse-header"
                 data-rpms-header-toggle="#ethics-@item.Container.Id"
                 role="button" tabindex="0"
                 aria-expanded="true" aria-controls="ethics-@item.Container.Id">

                <div class="row g-2 align-items-center w-100">
                    <div class="col-12 col-md-3 d-flex align-items-center gap-2">
                        @* Part of the header rather than a control of its own, so clicking it does
                           not leave an icon looking selected in the middle of a row. *@
                        <span class="rpms-collapse-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="20" height="20"
                                 viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M6 9l6 6l6 -6" />
                            </svg>
                        </span>
                        <span class="text-secondary">@item.Container.StudentName</span>
                    </div>

                    <div class="col-12 col-md-6">
                        <h2 class="card-title m-0">@item.Container.DisplayTitle</h2>
                    </div>

                    <div class="col-12 col-md-3 text-secondary">
                        @item.Container.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </div>
                </div>
            </div>

            <div class="card-body collapse show" id="ethics-@item.Container.Id"
                 data-rpms-collapsible="ethics-reviews">

                @if (!string.IsNullOrWhiteSpace(item.Approval.SupervisorDecisionComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">The supervisor said</div>
                        <p class="m-0">@item.Approval.SupervisorDecisionComments</p>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(item.Approval.CoordinatorDecisionComments))
                {
                    <div class="mb-3">
                        <div class="text-secondary small">The coordinator said</div>
                        <p class="m-0">@item.Approval.CoordinatorDecisionComments</p>
                    </div>
                }

                @if (item.Approval.Status == EthicsStatus.NotRequired)
                {
                    <div class="alert alert-info" role="status">
                        The supervisor ruled that this research needs no ethics documentation and the
                        coordinator agreed. Nothing was uploaded, so there is nothing to read: what
                        you are being asked about is the ruling itself.
                    </div>
                }

                @if (item.Documents.Count > 0)
                {
                    <div class="table-responsive mb-3">
                        <table class="table card-table table-vcenter">
                            <thead>
                                <tr><th scope="col">Document</th><th scope="col">File</th><th scope="col">Status</th><th scope="col" class="w-1"></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var document in item.Documents)
                                {
                                    <tr>
                                        <td>@Humanise(document.DocumentType)</td>
                                        <td>@document.FileName</td>
                                        <td><span class="badge @StatusBadge(document.Status)">@Humanise(document.Status)</span></td>
                                        <td class="text-end">
                                            @* Being asked to comment on documentation means reading
                                               it. The file name alone said what was uploaded and
                                               gave no way to open it. *@
                                            <a asp-controller="Downloads" asp-action="EthicsDocument"
                                               asp-route-containerId="@item.Container.Id"
                                               asp-route-documentId="@document.Id"
                                               class="btn btn-sm btn-outline-primary">Download</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* Comments only: the Head of Department records an opinion, they do not accept or
                   reject. That decision is the coordinator's. *@
                <form asp-controller="HeadOfDepartment" asp-action="SubmitReview" method="post">
                    <input type="hidden" name="id" value="@item.Container.Id" />
                    <div class="mb-3">
                        <label class="form-label" for="hod-comments-@item.Container.Id">Your comments</label>
                        @{ var hodNeedsWhy = await Decisions.IsRequiredAsync(DecisionPoints.EthicsHeadOfDepartmentReview); }
                        <textarea id="hod-comments-@item.Container.Id" name="comments" rows="3" class="form-control"
                                  placeholder="What the coordinator should weigh before deciding"></textarea>
                        <small class="form-hint">@DecisionButton.Hint(hodNeedsWhy)</small>
                    </div>
                    <button type="submit" class="btn btn-primary"
                            @DecisionButton.Attributes(hodNeedsWhy, $"hod-comments-{item.Container.Id}",
                                "Send your review to the coordinator?",
                                "Say what you make of it. The coordinator decides on the strength of this.")>Submit review</button>
                </form>

            </div>
        </div>
    }

    @if (Model.Pager is not null)
    {
        <partial name="_Pager" model="Model.Pager" />
    }
}
