@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model HeadOfDepartmentDashboardViewModel
@{
    ViewData["Title"] = "Head of Department dashboard";

    string StageLabel(int stage) => stage switch
    {
        PipelineStage.ResearchProposals => "Research proposals",
        PipelineStage.EthicsApproval => "Ethics approval",
        PipelineStage.ResearchPaper => "Research paper",
        _ => "—"
    };
}

<div class="mb-4">
    <h1 class="page-title mb-1">Head of Department dashboard</h1>
    <div class="text-secondary">
        @(Model.AwaitingReview.Count == 0
            ? "Nothing is waiting on your review."
            : Model.AwaitingReview.Count == 1
                ? "One ethics review is waiting on you."
                : $"{Model.AwaitingReview.Count} ethics reviews are waiting on you.")
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your department</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    <div class="row row-cards mb-4">

        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.AwaitingReview.Count > 0 ? "border-primary" : "")">
                <div class="card-body">
                    <div class="text-secondary mb-1">Ethics reviews</div>
                    <div class="h1 m-0">@Model.AwaitingReview.Count</div>
                    <div class="text-secondary">waiting on you</div>
                    @if (Model.AwaitingReview.Count > 0)
                    {
                        <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                           class="btn btn-primary btn-sm mt-3">Review them</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">In progress</div>
                    <div class="h1 m-0">@Model.InProgress</div>
                    <div class="text-secondary">publications under way</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-secondary mb-1">Completed</div>
                    <div class="h1 m-0">@Model.Completed</div>
                    <div class="text-secondary">publications finished</div>
                </div>
            </div>
        </div>

    </div>

    @if (Model.Publications.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">Nothing in your department yet</h3>
                <p class="text-secondary m-0">
                    Publications appear here as students in your department start them.
                </p>
            </div>
        </div>
    }
    else
    {
        <h2 class="h3 mb-2">Your department's publications</h2>
        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Publication</th>
                            <th>Stage</th>
                            <th>Status</th>
                            <th>Waiting on you</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var publication in Model.Publications)
                        {
                            <tr>
                                <td>@publication.StudentName</td>
                                <td>@publication.DisplayTitle</td>
                                <td>@StageLabel(publication.CurrentPipeline)</td>
                                <td>
                                    <span class="badge @StatusBadge(publication.DisplayStatus)">
                                        @Humanise(publication.DisplayStatus)
                                    </span>
                                </td>
                                <td>
                                    @if (publication.EthicsAwaitingRole == RoleNames.HeadOfDepartment)
                                    {
                                        <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                                           asp-route-id="@publication.Id" class="btn btn-sm btn-primary">
                                            Review ethics
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">&mdash;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
