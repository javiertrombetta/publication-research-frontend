@using ResearchPublicationManagementSystem.Infrastructure.Api.Dto
@model HeadOfDepartmentDashboardViewModel
@{
    ViewData["Title"] = "Head of Department dashboard";

    string StageLabel(int stage) => stage switch
    {
        PipelineStage.ResearchProposals => "Research proposals",
        PipelineStage.EthicsApproval => "Ethics approval",
        PipelineStage.ResearchPaper => "Research paper",
        _ => "—"
    };

    // Whose move it is, whoever that happens to be. The other dashboards answer "is it mine";
    // this one is oversight, so it names the person the department is waiting on instead.
    string WaitingOn(PublicationContainerDto c)
    {
        if (c.Status == "Completed") return "Nobody, it is finished";
        if (c.EthicsAwaitingRole is { } ethics) return Humanise(ethics);
        if (c.PaperAwaitingRole is { } paper) return Humanise(paper);
        return "Nobody";
    }
}

<div class="mb-4">
    <h1 class="page-title mb-1">Head of Department dashboard</h1>
    <div class="text-secondary">
        Everything moving through your department, at whichever stage it has reached, and who the
        next move belongs to.
    </div>
</div>

@if (Model.LoadFailed)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h3 class="mb-2">We couldn't load your department</h3>
            <p class="text-secondary mb-4">This is a temporary problem reaching the server. Try again in a moment.</p>
            <a asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard" class="btn btn-primary">Retry</a>
        </div>
    </div>
}
else
{
    @* One card per stage, so the shape of the department reads at a glance: how much is still
       choosing a topic, how much is in ethics, how much is being written and judged. The ethics
       card carries the one decision that is theirs, because that is the part they act on. *@
    @* One button design across the three, because they are the same kind of thing: the way into
       that stage. The ethics one was filled and the other two outlined, which read as a ranking
       the cards do not mean. Filled throughout, and the ethics card says what is waiting in words
       above its button rather than by being the only one that stands out. *@
    <div class="row row-cards mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-secondary mb-1">Research proposals</div>
                    <div class="h1 m-0">@Model.ProposalStageTotal</div>
                    <div class="text-secondary">
                        @(Model.ProposalStageTotal == 1 ? "publication at this stage" : "publications at this stage")
                    </div>
                    @* Pushed to the foot of the card so the three buttons line up with each other
                       however much the ethics card has to say above its own. *@
                    <a asp-controller="HeadOfDepartment" asp-action="all_proposals_fromstudent"
                       class="btn btn-primary btn-sm mt-3 align-self-start mt-auto">Department proposals</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100 @(Model.AwaitingMyReviewTotal > 0 ? "border-primary" : "")">
                <div class="card-body d-flex flex-column">
                    <div class="text-secondary mb-1">Ethics approval</div>
                    <div class="h1 m-0">@Model.EthicsStageTotal</div>
                    <div class="text-secondary">
                        @(Model.EthicsStageTotal == 1 ? "publication at this stage" : "publications at this stage")
                    </div>

                    @if (Model.AwaitingMyReviewTotal > 0)
                    {
                        <div class="text-secondary small mt-1">
                            <strong>@Model.AwaitingMyReviewTotal</strong> waiting on your comments
                        </div>
                    }

                    <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                       class="btn btn-primary btn-sm mt-3 align-self-start mt-auto">
                        Ethics reviews
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="text-secondary mb-1">Research papers</div>
                    <div class="h1 m-0">@Model.PaperStageTotal</div>
                    <div class="text-secondary">
                        @(Model.PaperStageTotal == 1 ? "publication at this stage" : "publications at this stage")
                    </div>
                    <a asp-controller="HeadOfDepartment" asp-action="Department_papers"
                       class="btn btn-primary btn-sm mt-3 align-self-start mt-auto">Department papers</a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TotalCount == 0 && !Model.HasSearch && !Model.HasWaitingOn)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h3 class="mb-2">Nothing in your department yet</h3>
                <p class="text-secondary m-0">
                    Publications appear here as students in your department start them.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body py-3">
                <form method="get" asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard"
                      class="row g-2 align-items-center">

                    @* The order survives a search, so narrowing the list does not silently reorder it. *@
                    <input type="hidden" name="sort" value="@Model.Sort" />
                    <input type="hidden" name="desc" value="@Model.Descending.ToString().ToLowerInvariant()" />

                    <div class="col-12 col-md">
                        <input type="search" name="search" value="@Model.Search" class="form-control"
                               placeholder="Search by student or publication" aria-label="Search" />
                    </div>

                    @* Narrowing by whose move it is, applied by the API so it covers the whole
                       department rather than the ten rows in hand. It is the question a head of
                       department actually arrives with: not "what is happening", which the cards
                       above answer, but "who is holding something up". Submits on change, because
                       a select that needed a second click on Search looked like it had not
                       worked. *@
                    <div class="col-12 col-md-auto">
                        <label class="visually-hidden" for="waiting-on">Waiting on</label>
                        <select id="waiting-on" name="waitingOn" class="form-select"
                                onchange="this.form.submit()">
                            <option value="">Waiting on anyone</option>
                            @foreach (var role in RoleNames.WaitingOnAnswers)
                            {
                                <option value="@role" selected="@(Model.WaitingOn == role)">
                                    @(role == RoleNames.Nobody ? "Nobody" : Humanise(role))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </div>
                    <div class="col-auto">
                        @* Back to the whole department: both the term and the role, since either
                           on its own can be what is hiding the row somebody is looking for. *@
                        <a asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard"
                           asp-all-route-data="Model.ClearFiltersRoute()"
                           class="btn btn-outline-secondary">Clear</a>
                    </div>
                    <div class="col-12 col-md-auto ms-md-auto text-secondary small">
                        <strong>@Model.TotalCount</strong>
                        @(Model.TotalCount == 1 ? "publication" : "publications"),
                        @Model.Publications.Count on this page.
                    </div>
                </form>
            </div>
        </div>

        if (Model.Publications.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    @* Which of the two narrowed it to nothing, since the way out differs. *@
                    @if (Model.HasSearch && Model.HasWaitingOn)
                    {
                        <h3 class="mb-2">Nothing matches both of those</h3>
                        <p class="text-secondary mb-4">
                            No publication with &ldquo;@Model.Search&rdquo; in it is waiting on
                            @Humanise(Model.WaitingOn).
                        </p>
                    }
                    else if (Model.HasSearch)
                    {
                        <h3 class="mb-2">Nothing matches &ldquo;@Model.Search&rdquo;</h3>
                        <p class="text-secondary mb-4">No publication in your department has that student or title.</p>
                    }
                    else
                    {
                        <h3 class="mb-2">Nothing is waiting on @Humanise(Model.WaitingOn)</h3>
                        <p class="text-secondary mb-4">
                            Every publication in your department is with somebody else right now.
                        </p>
                    }
                    <a asp-controller="HeadOfDepartment" asp-action="Head_of_Department_dashboard" class="btn btn-primary">
                        Show them all
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="table-responsive">
                    @{
                        var byStudent = Model.Column("student", "Student");
                        var byStarted = Model.Column("started", "Publication", descendingFirst: true);
                        var byStage = Model.Column("stage", "Stage");
                        var byStatus = Model.Column("status", "Status");
                    }
                    <table class="table card-table table-vcenter rpms-table-stable">
                        @* Declared once so the columns do not resize themselves around whichever
                           ten rows a sort happens to bring onto the page. *@
                        <colgroup>
                            <col style="width: 18%" />
                            <col style="width: 34%" />
                            <col style="width: 16%" />
                            <col style="width: 14%" />
                            <col style="width: 18%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th><partial name="_SortableHeader" model="byStudent" /></th>
                                <th><partial name="_SortableHeader" model="byStarted" /></th>
                                <th><partial name="_SortableHeader" model="byStage" /></th>
                                <th><partial name="_SortableHeader" model="byStatus" /></th>
                                @* Filtered rather than sorted, from the control above. It is read
                                   out of two fields the projection computes, so there is no single
                                   column to order by; and ordering by it would only group the
                                   roles together, which is the same thing as picking one, more
                                   slowly. *@
                                <th>Waiting on</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var publication in Model.Publications)
                            {
                                <tr>
                                    <td>@publication.StudentName</td>
                                    <td>@publication.DisplayTitle</td>
                                    <td>@StageLabel(publication.CurrentPipeline)</td>
                                    <td>
                                        <span class="badge @StatusBadge(publication.DisplayStatus)">
                                            @Humanise(publication.DisplayStatus)
                                        </span>
                                    </td>
                                    <td>
                                        @if (publication.EthicsAwaitingRole == RoleNames.HeadOfDepartment)
                                        {
                                            @* Theirs to act on, so it is a way in rather than a label. *@
                                            <a asp-controller="HeadOfDepartment" asp-action="Headofdepartment_feedback"
                                               asp-route-id="@publication.Id"
                                               class="btn btn-sm btn-primary">Add your comments</a>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">@WaitingOn(publication)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.Pager is not null)
            {
                <partial name="_Pager" model="Model.Pager" />
            }
        }
    }
}
